{
  "store.product": {
    "children": [      
      // Futuramente englobar ele com outros componente - ex. Imagem de Destaque do Produto - para nao ter que fazer uma configuracao
      // para desktop e outra para mobile - igual a estrutura da descricao do produto "flex-layout.row#product-infos-wrapper"
      
      // In DEV
      "container#youtube-shorts", // Container existe mas esta vazio pois o app ainda esta em desenvolvimento
      // In DEV
      //
      
      "responsive-layout.desktop#product-main",
      "responsive-layout.mobile#product-main",
      "flex-layout.row#product-infos-wrapper",
      "container#product__related-grid",
      // "container#ra-trustvox" - Removido da Loja
      "flex-layout.row#also-seen"
      //
      // In DEV
      ,"container#product-reviews"
      // In DEV
      //
      // "container#spacing-default" // Espaco extra aparentemente desnecessario - ficara aqui apenas caso necessite voltar
    ]
  },

  "responsive-layout.desktop#product-main": {
    "title": "Produto",
    "children": [
      "flex-layout.row#product-image-highlight",
      "flex-layout.row#product-highlight-coupon",
      "flex-layout.row#product-main"
    ]
  },
  "responsive-layout.mobile#product-main": {
    "title": "Produto Mobile",
    "children": [
      "flex-layout.row#product-main-mobile"
    ]
  },
  "flex-layout.row#product-main": {
    "children": [
      "flex-layout.col#product-main-left",
      "flex-layout.col#product-main-right"
    ],
    "props": {
      "blockClass": "product-main"
    }
  },
  "flex-layout.row#product-main-mobile": {
    "children": [
      // Em testes - Novo sistema de imagens de destaque, sendo aplicado ao mobile tambem
      // "flex-layout.row#product-image-highlight",
      //

      "flex-layout.col#product-main-mobile"
    ],
    "props": {
      "blockClass": "product-main-mobile"
    }
  },

  "flex-layout.col#product-main-mobile_wrapper": {
    "children": [
      "flex-layout.row#product-image-highlight",

      // In DEV
      "container#wrapper__highlight-coupon-mobile", // Ainda nao esta pronto para ser utilizado
      //
      
      "product-images-custom#product-images",
      "condition-layout.product#product-title",
      "container#product-brand-dynamic",
      "container#product-brand-fixed"
    ],
    "props": {
      "blockClass": ["product-main-mobile", "product-main-mobile_wrapper", "mobile-first-fold"]
    }
  },

  "flex-layout.col#product-main-mobile": {
    "children": [
      // Componente descontinuado no Refresh - Mas vou manter aqui por uma questão de ajuste
      // de CSS pendente que farei apenas apos lançar o MVP do Refresh
      //"container#wrapper__highlight-coupon-mobile",
      //

      "flex-layout.col#product-main-mobile_wrapper",
      "flex-layout.row#breadcrumb-product",
      "container#product-top-infos", // Validar se esse componente ainda serve para algo
      "container#product-highlights--product-page",
      "condition-layout.product#elf-checker"
      
      // O bloco "flex-layout.col#product-description-wrapper-mobile" sera descontinuado no Refresh
      // Todo o mobile sera tratato pelo "container#product-main-description" que sera configurado
      // e ajustado seus breakpoints via CSS
      //"flex-layout.col#product-description-wrapper-mobile"
    ],
    "props": {
      "blockClass": "product-main-mobile"
    }
  },

  "flex-layout.row#product-mobile-images": {
    "children": [
      "sunhouse.store-components:product-images#product-page-mobile"
    ],
    "props": {
      "blockClass": "product-mobile-images"
    }
  },

  "sunhouse.store-components:product-images#product-page-mobile": {
    "children": [
      "stack-layout#product-image-swiper",
      "flex-layout.row#product-zoom-text-mobile"
    ],
    "props": {
      "aspectRatio": "1:1",
      "maxHeight": 498,
      "maxWidth": 498,
      "thumbnailAspectRatio": "1:1",
      "thumbnailMaxHeight": 77,
      "contentOrder": "videos-first",
      "displayThumbnailsArrows": true,
      "thumbnailsOrientation": "horizontal",
      // "showNavigationArrows": false,
      "showNavigationArrows": true,
      "showPaginationDots": false,
      "blockClass": "product-page"
    }
  },
  "stack-layout#product-image-swiper": {
    "children": [
      "flex-layout.col#product-image-swiper",
      "product-price-savings"
    ],
    "props": {
      "blockClass": "product-image-swiper"
    }
  },
  "flex-layout.col#product-image-swiper": {
    "children": ["product-images-swiper"],
    "props": {
      "blockClass": "product-image-swiper"
    }
  },
  "product-price-savings": {
    "props": {
      "percentageStyle": "compact",
      "message": "{savingsPercentage}",
      "blockClass": "discount-seal"
    }
  },

  "flex-layout.row#product-zoom-text-mobile": {
    "children": [
      "icon#product-zoom-text-icon",
      "rich-text#product-zoom-text-mobile"
    ],
    "props": {
      "blockClass": "product-zoom-text",
      "horizontalAlign": "center",
      "preventHorizontalStretch": true,
      "preserveLayoutOnMobile": true,
      "preventVerticalStretch": true,
      "marginBottom": 5,
      "marginTop": 3
    }
  },

  "rich-text#product-zoom-text-mobile": {
    "props": {
      "text": "Posicione o mouse sob a imagem para dar zoom",
      "blockClass": "product-zoom-text"
    }
  },
  "icon#product-zoom-text-icon": {
    "props": {
      "id": "mpa-zoom",
      "activeClassName": "vtex-store-components-3-x-zoomIcon"
    }
  },
  "flex-layout.col#product-main-right": {
    "title": "Informações Principais",
    "children": [
      "container#product-top-infos",
      "condition-layout.product#product-title",
      "container#product-brand-dynamic",
      "container#product-brand-fixed",
      "container#product-highlights--product-page",
      "condition-layout.product#elf-checker"
    ],
    "props": {
      "width": "50%",
      "blockClass": "product-main-right",
      "preventVerticalStretch": true
    }
  },

  // Toggle - Marca Dinâmica
  "container#product-brand-dynamic": {
    "title": "Marca Dinâmica",
    "children": [
      "vtex.store-components:product-brand#product-brand"
    ],
    "props": {
      "blockClass": ["product-brand-text", "product-brand-dynamic"]
    }
  },

  // Toggle - Marca Fixa
  "container#product-brand-fixed": {
    "title": "Marca Fixa",
    "children": [
      "rich-text#product-brand-fixed"
    ],
    "props": {
      "blockClass": ["product-brand-text", "product-brand-fixed"]
    }
  },
  "rich-text#product-brand-fixed": {
    "title": "Texto - Marca Fixa",
    "props": {
      "text": "Sun House",
      "blockClass": "product-brand-text-fixed"
    }
  },
  
  // New product title structure
	"condition-layout.product#product-title": {
    "title": "Condicional - Nome do Produto",
		"props": {
			"conditions": [
				{
					"subject": "specificationProperties",
					"arguments": {
						"name": "Tem variação de SKU",
						"value": "Sim"
					}
				}
			],
			"Then": "vtex.store-components:product-name#sku-name",
			"Else": "vtex.store-components:product-name"
		}
	},
	"vtex.store-components:product-name#sku-name": {
		"title": "Nome SKU - Variação",
		"props": {
			"showBrandName": false,
			"showProductReference": false,
			"showSku": true,
			"tag": "h1",
			"blockClass": "sku-name_container"
		}
	},

  "flex-layout.row#breadcrumb-product": {
    "children": [
      "breadcrumb#product-page"
    ],
    "props": {
      "blockClass": "breadcrumb-product"
    }
  },
  "container#product-top-infos": {
    "children": [
      // "flex-layout.row#product-code-brand",      
      // "trustvox-starts", - Removido da Loja
      // "product-rating-summary", - Removido da Loja junto com o Trustvox
      
      // Em desenvolvimento
      "container#product-reviews-summary",
      //
      
      "add-to-list-btn#product-page"
    ],
    "props": {      
      "blockClass": "product-top-infos"
    }
  },

  // Em desenvolvimento - App parceiro Konfidency
  "container#product-reviews-summary": {
    "title": "Estrelas de Avaliações",
    "children": [
      "konfidencypartnerbr.konfidency-reviews:product-rating-summary" // tive que colocar assim pois nao consigo de jeito nenhum remover o componente nativo vtex.reviews-and-ratings do peerDependencies
    ],
    "props": {
      "blockClass": "product-reviews-summary"
    }
  },
  //
  
  "add-to-list-btn#product-page": {
    "title": "Botão adicionar a lista de desejos",
    "props": {
      "blockClass": "product-page"
    }
  },
  "flex-layout.row#product-code-brand": {
    "children": [
      "product-identifier.product#product-reference", // Deveria vir o codigo do Produto, porem nada aparece visualmente (pode ter alguma regra de Css ocultando, validar posteriormente)
      // "product-identifier.product#sku-reference", - Deveria vir o codigo do SKU, porem esta desabilitado
      "vtex.store-components:product-brand#product-brand"
    ],
    "props": {
      "preventHorizontalStretch": true,
      "blockClass": "product-code-brand",
      "preserveLayoutOnMobile": true
    }
  },
  "vtex.store-components:product-brand#product-brand": {
    "props": {
      "withLink": "none",
      "blockClass": "product-brand",
      "displayMode": "text"
    }
  },

  // Esta sendo utilizado? VALIDAR
  "product-identifier.product#product-reference": {
    "props": {
      "label": "custom",
      "customLabel": "Código",
      "idField": "productReference"
    }
  },
  //

  "condition-layout.product#elf-checker": {
    "title": "Condicional - Status Produto",
    "props": {
      "conditions": [
        {
          "subject": "productClusters",
          "arguments": {
            "id": "427"
          }
        }
      ],
      "Then": "flex-layout.col#product-exclusive",
      "Else": "condition-layout.product#corporate-checker"
      // "Else": "condition-layout.product#product-availability"
    }
  },

  "condition-layout.product#corporate-checker": {
    "title": "Condicional - Status Produto",
    "props": {
      "conditions": [
        {
          "subject": "productClusters",
          "arguments": {
            "id": "443"
          }
        }
      ],
      "Then": "flex-layout.col#product-corporate",
      "Else": "condition-layout.product#product-availability"
    }
  },

  "condition-layout.product#product-availability": {
    "title": "Condicional - Disponibilidade do Produto",
    "props": {
      "conditions": [
        {
          "subject": "isProductAvailable"
        }
      ],
      "Then": "flex-layout.col#product-available",
      "Else": "flex-layout.col#product-unavailable"
    }
  },
  
  "flex-layout.col#product-exclusive": {
    "children": [
      "container#product-exclusive"
    ],
    "props": {
      "preventVerticalStretch": true,
      "blockClass": "product-exclusive"
    }
  },

  "flex-layout.col#product-corporate": {
    "children": [
      "container#product-corporate"
    ],
    "props": {
      "preventVerticalStretch": true,
      "blockClass": "product-corporate"
    }
  },

  "flex-layout.col#product-available": {
    "children": [
      "flex-layout.row#product-page-price",
      "container#sku-variation-selector",
      
      //
      "flex-layout.row#product-buy-container",
      "flex-layout.col#buy-button",
      // "flex-layout.row#whatsapp-button_normal-product",
      //

      "flex-layout.row#collection-highlights--product-page",
      "flex-layout.row#shipping-simulator-wrapper"
    ],
    "props": {
      "blockClass": "product-available",
      "preventVerticalStretch": true
    }
  },
  "flex-layout.row#product-page-price": {
    "children": [
      // Padrao de preço 1 - Versao original Edson - Destaque para o preço no Pix
      "container#product-low-price", // No arquivo product-prices.jsonc
      // Padrao de preço 2 - Versao destaque para o preço em 10x
      "container#product-high-price" // No arquivo product-prices.jsonc
    ],
    "props": {
      "blockClass": "product-page-price",
      "preventVerticalStretch": true,
      "colSizing": "auto",
      "marginBottom": 6,
      "preventHorizontalStretch": true
    }
  },
  "condition-layout.product#product-has-list-price": {
    "title": "Condicional - Produto tem Preço de Lista",
    "props": {
      "conditions": [
        {
          "subject": "hasListPrice"
        }
      ],
      "Then": "flex-layout.col#product-list-price",
      "Else": "flex-layout.col#product-price"
    }
  },
  "flex-layout.col#product-price": {
    "children": [
      "product-selling-price#product-page-price"
    ],
    "props": {
      "blockClass": "product-price"
    }
  },
  "flex-layout.col#product-list-price": {
    "children": [
      "product-list-price#product-page-list-price",
      "product-selling-price#product-page-best-price"
    ],
    "props": {
      "blockClass": "product-list-price"
    }
  },
  "product-list-price#product-page-list-price": {
    "props": {
      "message": "{listPriceValue}",
      "blockClass": "product-page-list-price"
    }
  },
  "product-selling-price#product-page-best-price": {
    "props": {
      "message": "<bold>{sellingPriceValue}</bold>",
      "markers": ["bold"],
      "blockClass": "product-page-best-price"
    }
  },
  "product-selling-price#product-page-price": {
    "props": {
      "message": "<bold>{sellingPriceValue}</bold>",
      "markers": ["bold"],
      "blockClass": "product-page-price"
    }
  },
  "flex-layout.row#product-buy-container": {
    "children": [
      "flex-layout.col#buy-quantity",
      
      // Esse botao vai pro lugar do whatsapp, e o do whatsapp pra ca
      "flex-layout.row#whatsapp-button_normal-product"
      // "flex-layout.col#buy-button"
    ],
    "props": {
      "blockClass": "buy-container",
      // "colJustify": "between",
      "preventVerticalStretch": true,
      "colGap": 0,
      "preserveLayoutOnMobile": true
    }
  },
  "flex-layout.col#buy-quantity": {
    "children": [
      "product-quantity#product-page"
    ],
    "props": {
      "blockClass": "buy-quantity",
      // "width": "41%"
      "width": "30%"
    }
  },
  "product-quantity#product-page": {
    "props": {
      "size": "small",
      // "showLabel": true,
      "showLabel": false,
      "blockClass": "product-page-quantity"
    }
  },
  "flex-layout.col#buy-button": {
    "children": [
      // "add-to-cart-button#product-page",
      "vtex.add-to-cart-button:add-to-cart-button#product-page"
      // "rich-text#safe-purchase"
    ],
    "props": {
      // "width": "52%"
      "blockClass": ["product-buy-button", "buy-button"]
    }
  },

  /* Desabilitado */
  "rich-text#safe-purchase": {
    "title": "Texto - Compra Segura",
    "props": {
      "blockClass": "safe-purchase",
      "text": "Compra 100% segura"
    }
  },

  // "add-to-cart-button#product-page": {
  "vtex.add-to-cart-button:add-to-cart-button#product-page": {
    "props": {
      "onClickBehavior": "add-to-cart",
      // "isOneClickBuy": true, // Funciona se desabilitar a prop do minicart "customPixelEventName"
      // "onClickEventPropagation": "disabled", // Esta funcionando em conjunto com o minicart - la tem um evento de propagacao que causa o efeito de abrir o minicart
      // "customPixelEventId": "?" // Pode ser util para ferramentas externas e outros apps
      // "text": "Adicionar ao Carrinho",
      "text": "Comprar Agora",
      "blockClass": "add-to-cart_button"
    }
  },

  "flex-layout.col#product-unavailable": {
    "children": [
      "container#sku-variation-selector",
      "container#product-unavailable"
    ],
    "props": {
      "blockClass": "product-unavailable",
      "preventVerticalStretch": true
    }
  },

  // Compre junto
  "condition-layout.user#buy-together": {
    "props": {
      "conditions": [
        {
          "subject": "isAuthenticated",
          "arguments": {
            "value": true
          }
        }
      ],
      "Then": "condition-layout.product#product-content-availability"
    }
  },

  "condition-layout.product#product-content-availability": {
    "title": "Condicional - Compre Junto",
    "props": {
      "conditions": [
        {
          "subject": "isProductAvailable"
        }
      ],
      "Then": "flex-layout.row#buy-together"
    }
  },
  "flex-layout.row#buy-together": {
    // "children": [
    //   "buy-together"
    // ],
    "props": {
      "blockClass": "buy-together"
    }
  },

  // Quem Viu Comprou Tambem
  "flex-layout.row#shelf-buy-too": {
    "children": [
      "shelf.relatedProducts#shelf-buy-too"
    ],
    "props": {
      "blockClass": "shelf-buy-too"
    }
  },
  "shelf.relatedProducts#shelf-buy-too": {
    "blocks": [
      // "product-summary.shelf#main-product"
      "product-summary.shelf#main-product-new"
    ],
    "props": {
      "recommendation": "viewandBought",
      "productList": {
        "titleText": "As pessoas também estão comprando",
        "itemsPerPage": {
          "desktop": 4,
          "tablet": 2,
          "phone": 1
        }
      },
      "blockClass": "shelf-buy-too"
    }
  }
}
