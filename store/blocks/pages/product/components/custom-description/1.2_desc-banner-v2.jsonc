{
    "flex-layout.row#line-wrapper-x3": {
        "title": "[TESTES] Bloco x3",
        "children": [
            "flex-layout.col#col-wrapper-x3"
        ],
        "props": {
            // "blockClass": ["line-wrapper"]
            // DEBUG:
            "blockClass": ["line-wrapper", "line-wrapper-white"]
        }
    },
    "flex-layout.col#col-wrapper-x3": {
        "children": [
            "container#desc-banner_v2"
        ]
    },

    // Desc Banner v2
    "container#desc-banner_v2": {
        "title": "Wrapper Imagem Destaque",
        "children": [
            "rich-text#desc-banner_v2_text",
            "list-context.image-list#lp_grow-block-image-highlight-image" // Herda da LP Elements
        ],
        "props": {
            "blockClass": ["custom-block__container", "desc-banner_v2", "lp_grow-block-image-highlight"]
        }
    },

    "rich-text#desc-banner_v2_text": {
        "title": "Texto Acima",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "## Título H2\n\nBreve texto explicativo de até três linhas (mas ideal manter até duas linhas de conteúdo).",
            "blockClass": ["desc-banner_v2_text", "lp_text-block"]
        }
    }
}