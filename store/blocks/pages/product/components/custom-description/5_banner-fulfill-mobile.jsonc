{
    // Wrapper START
    "container#line-wrapper-5": {
        "title": "Bloco 5 - Apenas Mobile",
        "children": [
            "flex-layout.row#line-wrapper-5"
        ],
        "props": {
            "blockClass": "line-wrapper"
        }
    },
    "flex-layout.row#line-wrapper-5": {
        "children": [
            "flex-layout.col#col-wrapper-5"
        ],
        "props": {
            // "blockClass": "line-wrapper"
            "blockClass": ["line-wrapper", "line-wrapper-odd", "banner-fulfill-mobile"]
        }
    },
    "flex-layout.col#col-wrapper-5": {
        "children": [
            "container#custom-block__banner-fulfill-mob"
        ]
    },
    // Wrapper END

    "container#custom-block__banner-fulfill-mob": {
        "title": "Banner Tela Completa Mobile",
        "children": [
            "list-context.image-list#banner-fulfill-mob"
        ],
        "props": {
            "blockClass": ["custom-block__container", "custom-block__banner-fulfill", "custom-block__banner-fulfill-mob"]
            // "blockClass": ["custom-block__banner-fulfill", "custom-block__banner-fulfill-mob"]
        }
    },

    "list-context.image-list#banner-fulfill-mob": {
        "title": "Imagens",
        "props": {
            "preload": false,
            "height": "480px",
            "experimentalSetExplicitDimensions": true,
            "images": [
                {
                    "mobileImage": "https://dummyimage.com/376x480/343a40/6c757d",
                    "width": "376px",
                    "description": "atributo alt",
                    "loading": "lazy"
                },
                {
                    "mobileImage": "https://dummyimage.com/376x480/343a40/6c757d",
                    "width": "376px",
                    "description": "atributo alt",
                    "loading": "lazy"
                }
            ],
            "blockClass": "slider-custom__banner-fulfill-mob"
        },
        "children": ["slider-layout#banner-fulfill-mob"]
    },
    "slider-layout#banner-fulfill-mob": {
        "title": "Configurações Carrossel Imagens",
        "props": {
            "itemsPerPage": {
                "phone": 1
            },
            "showNavigationArrows": "never",
            "usePagination": true,
            "showPaginationDots": "mobileOnly",
            "infinite": true,
            "autoplay": {
                "timeout": 3000,
                "stopOnHover": true
            },
            "blockClass": ["slider-custom", "slider__custom-photo-grid", "slider-custom__banner-fulfill-mob"]
        }
    }
}