// Ainda nao finalizado o DEV deste bloco
{
    "flex-layout.row#line-wrapper-9": {
        "title": "Bloco 8",
        "children": [
            "flex-layout.col#col-wrapper-9"
        ],
        "props": {
            "blockClass": ["line-wrapper"]
        }
    },
    "flex-layout.col#col-wrapper-9": {
        "children": [
            "container#custom-block__highlights-grid"
        ]
    },
    //

    "container#custom-block__highlights-grid": {
        "title": "Grid - Sub Destaques",
        "children": [
            "flex-layout.row#highlights-grid__row"
        ],
        "props": {
            "blockClass": ["custom-block__container", "highlights-grid"]
        }
    },

    "flex-layout.row#highlights-grid__row": {
        "title": "",
        "children": [
            "flex-layout.col#highlights-grid__col-1",
            "flex-layout.col#highlights-grid__col-2"
        ],
        "props": {
            "blockClass": "highlights-grid__row"
        }
    },

    "flex-layout.col#highlights-grid__col-1": {
        "title": "Coluna Esquerda - Imagem Destaque",
        "children": [
            "list-context.image-list#highlights-grid__image"
        ],
        "props": {
            "blockClass": "highlights-grid__col-1"
        }
    },
    "list-context.image-list#highlights-grid__image": {
        "title": "Imagem Destaque",
        "props": {
            "images": [
                {
                    "image": "https://dummyimage.com/499x499",
                    "mobileImage": "https://dummyimage.com/499x499" // Ver dimensão do banner mobile
                }
            ],
            "blockClass": "image_highlights-grid__image"
        },
        "children": ["container.list-render#highlights-grid__image"]
    },
    "container.list-render#highlights-grid__image": {
        "props": {
            "blockClass": ["custom-description-banner", "container_highlights-grid__image"]
        }
    },

    "flex-layout.col#highlights-grid__col-2": {
