// Bloco fotos destaque - esilo pichau - produto Cadeira Gamer Mancer Tyr Pro
{
    "container#custom-block__slider-photo-grid": {
        "title": "Grid - Fotos Ambientadas",
        "children": [
            "list-context.image-list#slider-photo-grid"
        ],
        "props": {
            "blockClass": "custom-block__slider-photo-grid"
        }
    },

    "list-context.image-list#slider-photo-grid": {
        "title": "Imagens",
        "props": {
            "preload": false,
            "height": "680px",
            "experimentalSetExplicitDimensions": true,
            "images": [{
                    "image": "https://dummyimage.com/383x680",
                    "mobileImage": "https://dummyimage.com/383x680", // Ver dimensão do banner mobile
                    "width": "383px",
                    "description": "atributo alt",
                    "loading": "lazy"
                },
                {
                    "image": "https://dummyimage.com/383x680",
                    "mobileImage": "https://dummyimage.com/383x680", // Ver dimensão do banner mobile
                    "width": "383px",
                    "description": "atributo alt",
                    "loading": "lazy"
                },
                {
                    "image": "https://dummyimage.com/383x680",
                    "mobileImage": "https://dummyimage.com/383x680", // Ver dimensão do banner mobile
                    "width": "383px",
                    "description": "atributo alt",
                    "loading": "lazy"
                }
            ]
        },
        "children": ["slider-layout#slider-photo-grid"]
    },
    "slider-layout#slider-photo-grid": {
        "title": "Configurações Carrossel Imagens",
        "props": {
            "itemsPerPage": {
                "desktop": 3,
                "phone": 1
            },
            "showNavigationArrows": "desktopOnly",
            //"usePagination": false, - Propriedade interessante para criar 'slides' para mobile, mais leves e sem o classico slick carousel - usar em outros elemementos
            "dots": true,
            "infinite": true,
            "blockClass": ["slider-custom", "slider__custom-photo-grid"]
        }
    }
}