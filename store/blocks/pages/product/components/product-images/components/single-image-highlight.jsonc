{
    // "product-images#image-highlight": {
    "vtex.store-components:product-images#image-highlight": {
        "title": "Imagem Destaque do Produto",
        "props": {
            "displayMode": "first-image",
            "zoomMode": "disabled",
            "maxHeight": 2000,
            "placeholder": "https://sunhouse.vtexassets.com/assets/vtex.file-manager-graphql/images/b9986364-10d2-4f2f-bec6-4888402b196b___64eec9f2a5bc7ac77e8900973ade7851.png",
            // "aspectRatio": {
            //     "desktop": "16:9",
            //     "phone": "16:9" // Ajustar para aspect ratio de celular
            // },
            "blockClass": "product-image-highlight"
        }
    },

    // Ver se consigo usar o componente abaixo para gerar a imagem em alta qualidade e joga-la no bg inicial da page
    "vtex.store-components:product-images.high-quality-image#image-highlight": {
        "props": {
            "zoomMode": "disabled",
            "zoomFactor": 2,
            "blockClass": "product-image-highlight-zoomed"
        }
    }
    //
    // COMPONENTE DESABILITADO - OUTRO DEVERA SUBSTITUI-LO
}