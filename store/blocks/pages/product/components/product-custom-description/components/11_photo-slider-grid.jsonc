{
    // Wrapper START
    "container#line-wrapper-11": {
        "title": "Bloco 11",
        "children": [
            "flex-layout.row#line-wrapper-11"
        ],
        "props": {
            "blockClass": "line-wrapper"
        }
    },
    "flex-layout.row#line-wrapper-11": {
        "children": [
            "flex-layout.col#col-wrapper-11"
        ],
        "props": {
            "blockClass": "line-wrapper"
            // "blockClass": ["line-wrapper", "line-wrapper-odd"]
        }
    },
    "flex-layout.col#col-wrapper-11": {
        "children": [
            "container#custom-block__slider-photo-grid"
        ]
    },
    // Wrapper END

    "container#custom-block__slider-photo-grid": {
        "title": "Grid - Fotos Ambientadas",
        "children": [
            "list-context.image-list#slider-photo-grid"
        ],
        "props": {
            "blockClass": ["custom-block__container", "custom-block__slider-photo-grid"]
        }
    },

    "list-context.image-list#slider-photo-grid": {
        "title": "Imagens",
        "props": {
            "preload": false,
            "height": "680px",
            "experimentalSetExplicitDimensions": true,
            "images": [{
                    "image": "https://dummyimage.com/383x680",
                    "mobileImage": "https://dummyimage.com/383x680",
                    "width": "383px",
                    "description": "atributo alt",
                    "loading": "lazy"
                },
                {
                    "image": "https://dummyimage.com/383x680",
                    "mobileImage": "https://dummyimage.com/383x680",
                    "width": "383px",
                    "description": "atributo alt",
                    "loading": "lazy"
                },
                {
                    "image": "https://dummyimage.com/383x680",
                    "mobileImage": "https://dummyimage.com/383x680",
                    "width": "383px",
                    "description": "atributo alt",
                    "loading": "lazy"
                }
            ]
        },
        "children": ["slider-layout#slider-photo-grid"]
    },
    "slider-layout#slider-photo-grid": {
        "title": "Configurações Carrossel Imagens",
        "props": {
            "itemsPerPage": {
                "desktop": 3,
                "phone": 1
            },
            "showNavigationArrows": "desktopOnly",
            "dots": true,
            "infinite": true,
            "blockClass": ["slider-custom", "slider__custom-photo-grid"]
        }
    }
}
