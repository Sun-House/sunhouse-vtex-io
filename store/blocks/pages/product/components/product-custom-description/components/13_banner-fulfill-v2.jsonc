{
    // Wrapper START
    "container#line-wrapper-13": {
        "title": "Bloco 13",
        "children": [
            "flex-layout.row#line-wrapper-13"
        ],
        "props": {
            "blockClass": "line-wrapper"
        }
    },
    "flex-layout.row#line-wrapper-13": {
        "children": [
            "flex-layout.col#col-wrapper-13"
        ],
        "props": {
            "blockClass": ["line-wrapper", "banner-fulfill_v2"]
            // "blockClass": ["line-wrapper", "line-wrapper-odd", "banner-fulfill_v2"]
        }
    },
    "flex-layout.col#col-wrapper-13": {
        "children": [
            "container#lp_banner-fulfill_v2"
        ]
    },
    // Wrapper END

    "container#lp_banner-fulfill_v2": {
        "title": "Banner Fulfill v2",
        "children": [
            "list-context.image-list#lp_banner-fulfill_v2"
        ],
        "props": {
            "blockClass": "lp_banner-fulfill_v2"
        }
    },
    "list-context.image-list#lp_banner-fulfill_v2": {
        "title": "Imagem Única",
        "props": {
            "images": [{
                "image": "https://dummyimage.com/1920x599/6c757d/343a40",
                "mobileImage": "https://dummyimage.com/360x640/6c757d/343a40"
            }],
            "blockClass": ["custom-pdp_image", "banner-fulfill_v2"]
        },
        "children": [
            "container.list-render#lp_banner-fulfill_v2"
        ]
    },
    "container.list-render#lp_banner-fulfill_v2": {
        "props": {
            "blockClass": ["custom-pdp_image", "banner-fulfill_v2"]
        }
    }
}
