{
    // Wrapper START
    "container#line-wrapper-1": {
        "title": "Bloco 1",
        "children": [
            "flex-layout.row#line-wrapper-1"
        ],
        "props": {
            "blockClass": "line-wrapper"
        }
    },
    "flex-layout.row#line-wrapper-1": {
        "children": [
            "flex-layout.col#col-wrapper-1"
        ],
        "props": {
            "blockClass": "line-wrapper"
            // "blockClass": ["line-wrapper", "line-wrapper-odd"]
        }
    },
    "flex-layout.col#col-wrapper-1": {
        "children": [
            "container#custom-block__desc-banner"
        ]
    },
    // Wrapper END

    "container#custom-block__desc-banner": {
        "title": "Descricao com Banner",
        "children": [
            "flex-layout.row#desc-banner__row"
        ],
        "props": {
            "blockClass": ["custom-block__container", "custom-block__desc-banner"]
        }
    },
    "flex-layout.row#desc-banner__row": {
        "title": "Wrapper Descricao com Banner",
        "children": [
            "flex-layout.col#desc-banner_ColText",
            "flex-layout.col#desc-banner_ColImage"
        ],
        "props": {
            "blockClass": "desc-banner__row"
        }
    },
    "flex-layout.col#desc-banner_ColText": {
        "title": "Coluna da Descrição",
        "children": [
            "rich-text#desc-banner__textoDescricao"
        ],
        "props": {
            "blockClass": ["col_desc-banner_ColText"]
        }
    },
    "flex-layout.col#desc-banner_ColImage": {
        "title": "Coluna da Foto do Produto ou Marca",
        "children": [
            "list-context.image-list#desc-banner__imagemDescricao"
        ],
        "props": {
            "blockClass": ["col_desc-banner_ColImage"]
        }
    },
    "rich-text#desc-banner__textoDescricao": {
        "title": "Descricao Texto",
        "props": {
            "text": "## Nome do Produto\n**Texto em Negrito** e [link exemplo](https://www.example.com). Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis nulla risus, tincidunt at ultrices vel, pellentesque ac augue. Fusce auctor odio non tempus hendrerit. Etiam tempus ab! Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis nulla risus, tincidunt at ultrices vel, pellentesque ac augue. Fusce auctor odio non tempus hendrerit. Etiam tempus ab! Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis nulla risus, tincidunt at ultrices vel, pellentesque ac augue. Fusce auctor odio non tempus hendrerit!",
            "blockClass": ["wrapper__textoDescricao-esquerda", "pdp-h2-title"]
        }
    },
    "list-context.image-list#desc-banner__imagemDescricao": {
        "title": "Foto Destaque Descricao",
        "props": {
            "images": [
                {
                    "image": "https://dummyimage.com/581x499",
                    "mobileImage": "https://dummyimage.com/581x499" // Ver dimensão do banner mobile
                }
            ],
            "blockClass": "img_desc-banner__imagemDescricao"
        },
        "children": ["container.list-render#desc-banner__imagemDescricao"]
    },
    "container.list-render#desc-banner__imagemDescricao": {
        "props": {
            "blockClass": ["custom-description-banner", "container_desc-banner__imagemDescricao"]
        }
    }
}