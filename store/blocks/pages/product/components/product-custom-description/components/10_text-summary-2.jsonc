{
    // Wrapper START
    "container#line-wrapper-10": {
        "title": "Bloco 10",
        "children": [
            "flex-layout.row#line-wrapper-10"
        ],
        "props": {
            "blockClass": "line-wrapper"
        }
    },
    "flex-layout.row#line-wrapper-10": {
        "children": [
            "flex-layout.col#col-wrapper-10"
        ],
        "props": {
            "blockClass": ["line-wrapper", "text-summary2"]
            // "blockClass": ["line-wrapper", "line-wrapper-odd"]
        }
    },
    "flex-layout.col#col-wrapper-10": {
        "children": [
            "container#custom-block__text-summary2"
        ],
        "props": {
            "blockClass": ""
        }
    },
    // Wrapper END

    "container#custom-block__text-summary2": {
        "title": "Titulo e Texto entre Blocos 2",
        "children": [
            // "container#text-summary_spacer2",
            "container#wrapper__text-summary2"
        ],
        "props": {
            "blockClass": ["custom-block__container", "custom-block__text-summary"]
        }
    },

    "container#text-summary_spacer2": {
        "title": "Detalhe Visual",
        "props": {
            "blockClass": ["text-summary_spacer", "text-summary_spacer2"]
        }
    },
    "container#wrapper__text-summary2": {
        "title": "Wrapper Texto",
        "children": [
            "rich-text#text-summary__text2"
        ],
        "props": {
            "blockClass": "wrapper__text-summary"
        }
    },
    "rich-text#text-summary__text2": {
        "title": "Texto",
        "props": {
            "text": "## Texto Título Breve \n Texto subtítulo, ou breve texto explicativo de até três linhas (mas ideal manter até duas linhas de conteúdo).",
            "blockClass": ["wrapper__custom-description-title", "text-summary__text"]
        }
    }
}