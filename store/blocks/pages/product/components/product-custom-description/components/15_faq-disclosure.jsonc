{
    // Wrapper START
    "container#line-wrapper-15": {
        "title": "Bloco 15",
        "children": [
            "flex-layout.row#line-wrapper-15"
        ],
        "props": {
            "blockClass": "line-wrapper"
        }
    },
    "flex-layout.row#line-wrapper-15": {
        "children": [
            "flex-layout.col#col-wrapper-15"
        ],
        "props": {
            "blockClass": ["line-wrapper", "faq-disclosure"]
            // "blockClass": ["line-wrapper", "line-wrapper-odd"]
        }
    },
    "flex-layout.col#col-wrapper-15": {
        "children": [
            "container#custom-block__wrapper-faq-disclosure"
        ]
    },
    // Wrapper END

    "container#custom-block__wrapper-faq-disclosure": {
        "title": "FAQ - Perguntas Frequentes PDP",
        "children": [
            "flex-layout.row#faq-disclosure__title-row",
            "container#custom-block__faq-disclosure"
        ],
        "props": {
            "blockClass": ["custom-block__container", "custom-block__wrapper-faq-disclosure"]
        }
    },

    "flex-layout.row#faq-disclosure__title-row": {
        "children": [
            "rich-text#faq-disclosure__title-row"
        ],
        "props": {
            "blockClass": ["feature-card__title", "feature-card__title"]
        }
    },
    "rich-text#faq-disclosure__title-row": {
        "title": "Texto - Titulo FAQ",
        "props": {
            "text": "## Perguntas Frequentes",
            "blockClass": "wrapper__custom-description-title"
        }
    },
    "container#custom-block__faq-disclosure": {
        "children": [
            "disclosure-layout#faq-disclosure-line-1",
            "disclosure-layout#faq-disclosure-line-2",
            "disclosure-layout#faq-disclosure-line-3",
            "disclosure-layout#faq-disclosure-line-4",
            "disclosure-layout#faq-disclosure-line-5",
            "disclosure-layout#faq-disclosure-line-6",
            "disclosure-layout#faq-disclosure-line-7"
        ],
        "props": {
            "blockClass": "custom-block__faq-disclosure"
        }
    },

    // Lines Disclosures Declaration
    // Linha 1
    "disclosure-layout#faq-disclosure-line-1": {
        "children": [
            "disclosure-trigger#faq-disclosure-line-1",
            "disclosure-content#faq-disclosure-line-1"
        ],
        "props": {
            "blockClass": "faq-disclosure-line",
            "initialVisibility": "hidden"
        }
    },
    "disclosure-trigger#faq-disclosure-line-1": {
        "children": [
            "rich-text#faq-disclosure-line-1__title",
            "disclosure-state-indicator#product-page-informations"
        ],
        "props": {
            "blockClass": "faq-disclosure-line"
        }
    },
    "rich-text#faq-disclosure-line-1__title": {
        "title": "Linha 1 - Título",
        "props": {
            "text": "## Título da pergunta 1 da FAQ - Máximo 1 linha",
            "blockClass": "faq-disclosure-line__title"
        }
    },
    "disclosure-content#faq-disclosure-line-1": {
        "children": [
            "rich-text#faq-disclosure-line-1__text"
        ],
        "props": {
            "blockClass": "faq-disclosure-line"
        }
    },
    "rich-text#faq-disclosure-line-1__text": {
        "title": "Linha 1 - Texto",
        "props": {
            "text": "Nullam fermentum velit eget rhoncus rutrum. Aenean ut porta urna. Sed urna sapien, vulputate vitae convallis nec, lobortis nec erat. [Quisque](#) ac ipsum eu dui euismod porta in vitae augue. Pellentesque vel urna sed dui rutrum hendrerit nec non orci. \n \n Nunc vitae nunc purus. Nam tincidunt enim neque, quis ultrices felis convallis sit amet. Nullam dapibus laoreet venenatis. Vestibulum ullamcorper a massa vel convallis. Donec congue libero sed tortor varius tincidunt.",
            "blockClass": "faq-disclosure-line__text"
        }
    },

