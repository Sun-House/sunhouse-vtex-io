{
  "container#product-description-buy-together": {
    "title": "Compre Junto",
    "children": [
      "rich-text#buy-together-title",
      "buy-together"
    ],
    "props": {
      "blockClass": "product-description-buy-together"
    }
  },

  "rich-text#buy-together-title": {
    "title": "Titulo - Compre Junto",
    "props": {
      "text": "## Leve mais por menos",
      "blockClass": ["common-title", "buy-together-title"]
    }
  },

  "buy-together": {
    "title": "Configurações - Compre Junto",
    "children": [
      "flex-layout.col#buyTogetherContent"
    ]
  },

  "flex-layout.col#buyTogetherContent": {
    "children": [
      "flex-layout.row#buyTogetherContainer"
    ]
  },
  "flex-layout.row#buyTogetherContainer": {
    "children": [
      "buy-together-current-product",
      "flex-layout.col#icon-plus",
      "buy-together-product-list",
      "flex-layout.col#buyTogetherInformation"
    ],
    "props": {
      "preventHorizontalStretch": true,
      "horizontalAlign": "center",
      "blockClass": "buyTogetherContainer"
      // "blockClass": "bt-row"
    }
  },

  "flex-layout.col#icon-plus": {
    "children": [
      "icon-plus"
    ],
    "props": {
      "verticalAlign": "middle",
      "horizontalAlign": "center",
      "blockClass": "bt-plus-icon"
    }
  },

  "buy-together-current-product": {
    "title": "Produto Atual",
    "blocks": ["product-summary.shelf#buy-together-current"]
  },
  
  "buy-together-product-list": {
    "title": "Produto(s) Sugerido(s)",
    "blocks": ["product-summary.shelf#buy-together-suggested"],
    "props": {
      "swiperProps": {
        "spaceBetween": 50
      }
    }
  },

  "flex-layout.col#buyTogetherInformation": {
    "children": [
      "buy-together-message",
      "buy-together-total",
      "buy-together-buy-button"
    ],
    "props": {
      "preventVerticalStretch": true,
      "verticalAlign": "middle",
      "blockClass": "buy-together-info"
    }
  },

  "buy-together-buy-button": {
    "title": "Botão - Comprar Junto",
    "props": {
      "BuyButton": "vtex.add-to-cart-button:add-to-cart-button#buy-together"
    }
  },

  "vtex.add-to-cart-button:add-to-cart-button#buy-together": {
    "props": {
      "onClickBehavior": "add-to-cart",
      // "text": "Levar os Dois",
      "customPixelEventId": "bt_add-to-cart_button", // Em testes
      "blockClass": ["add-to-cart_button", "bt_add-to-cart_button"]
    }
  }
}
