{
    "product-summary.shelf#buy-together-current": {
        "children": [
            "product-summary-image#buy-together",
            "container#bt-float-product-info"
            // "product-summary-name",
            // "container#shelf-price_parcelado"
        ],
        "props": {
            "blockClass": ["buy-together", "buy-together-current"]
        }
    },
  
    "product-summary.shelf#buy-together-suggested": {
        "children": [
            "product-summary-image#buy-together",
            "container#bt-float-product-info"
            // "product-summary-name",
            // "container#shelf-price_parcelado"
        ],
        "props": {
            "blockClass": ["buy-together", "buy-together-suggested"]
        }
    },

    "product-summary-image#buy-together": {
        "title": "Imagem do produto Compre junto",
        "props": {
            "width": {
                "desktop": 600
            //     "mobile": 1000
            },
            "height": {
                "desktop": 800
            //     "mobile": 1000
            },

            // "aspectRatio": "3:4",
            "aspectRatio": {
                "desktop": "4:3"
                // "mobile": "1:1"
            },
            "showBadge": false,
            "blockClass": ["main-shelf", "buy-together"]
        }
    }
}
