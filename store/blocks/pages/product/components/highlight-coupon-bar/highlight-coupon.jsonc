{
    "flex-layout.row#product-highlight-coupon": {
        "children": [
            "container#wrapper__highlight-coupon"
        ],
        "props": {
            "blockClass": "product-highlight-coupon"
        }
    },

    "container#wrapper__highlight-coupon": {
        "title": "Faixa Destaque de Cupom",
        "children": [
            "flex-layout.row#highlight-coupon"
        ],
        "props": {
            "wrapper": true,
            "blockClass": ["wrapper__highlight-coupon", "highlight--coupon"]
        }
    },

    "flex-layout.row#highlight-coupon": {
        "children": [
            "rich-text#highlight-text",
            "container#highlight-coupon-cron",
            "coupon-button#highlight-coupon-button"
        ],
        "props" : {
            "preventVerticalStretch": true,
            "colJustify": "between",
            "colSizing": "auto",
            "blockClass": "wrapper__highlight-pdp"
        }
    },

    // Add Coupon Button
    "coupon-button#highlight-coupon-button": {
        "title": "Botão - Usar Cupom",
        "props": {
            "label": "Usar Cupom",
            "couponCode": "MAESUN7",
            "blockClass": "highlight-coupon-button"
        }
    },

    // Ainda nao foi desenvolvido - repensar sobre isso no futuro
    "rich-text#sale-text": {
        "title": "Flag Sale",
        "props": {
            "text": "SALE",
            "blockClass": "sale-highlight-text"
        }
    },
    //

    "rich-text#highlight-text": {
        "title": "Texto da Faixa",
        "props": {
            "blockClass": "text__coupon-info",
            "text": "Desconto garantido! Aproveite o cupom SUNHOUSE10 em qualquer valor de compra! Termina em"
        }
    },

    // Wrapper Cron App
    "container#highlight-coupon-cron": {
        "title": "Cronometro do Cupom",
        "children": [
            "cron-countdown#highlight-coupon"
        ],
        "props": {
            "wrapper": true,
            "blockClass": "highlight-coupon-cron-wrapper"
        }
    },
    "cron-countdown#highlight-coupon": {
        "title": "Configurações do Cronometro",
        "props": {
            "targetDate": "05/11/2029",
            "targetTime": "23:59:59",
            "blockClass": "highlight-coupon-cron"
        }
    },

    
    // ABAIXO FOI DESCONTINUADO NO REFRESH
    // Preciso rever e repensar no modelo a ser utilizado no mobile
    "container#wrapper__highlight-coupon-mobile": {
        "title": "Faixa Destaque de Cupom Mobile",
        "children": [
            "flex-layout.row#highlight-coupon-mobile"
        ],
        "props": {
            "wrapper": true,
            "blockClass": ["wrapper__highlight-coupon-mobile", "highlight--coupon-mobile"]
        }
    },

    "flex-layout.row#highlight-coupon-mobile": {
        "props" : {
            "blockClass": "wrapper__highlight-pdp-mobile"
        },
        "children": [
            "rich-text#highlight-text-mobile"
        ]
    },
    "rich-text#highlight-text-mobile": {
        "title": "Texto da Faixa",
        "props": {
            "blockClass": "text__coupon-info",
            "text": "Desconto garantido! Aproveite o cupom SUNHOUSE10 em qualquer valor de compra! Corre que é por tempo limitado!"
        }
    }
}
