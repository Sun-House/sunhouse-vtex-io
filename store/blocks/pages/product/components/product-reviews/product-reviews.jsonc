{
    "container#product-reviews": {
        "title": "Avaliações do Produto",
        "children": [
            "flex-layout.row#product-reviews"
        ],
        "props": {
            "blockClass": "product-reviews"
        }
    },

    "flex-layout.row#product-reviews": {
        "children": [
            "flex-layout.col#product-reviews"
        ],
        "props": {
            "blockClass": "product-reviews"
        }
    },

    "flex-layout.col#product-reviews": {
        "children": [
            "konfidencypartnerbr.konfidency-reviews:product-reviews"
            
            //"flex-layout.row#product-reviews-header" // Sera desenvolvido posteriormente - usado o bloco nativo da Konfidency acima
            // "flex-layout.row#product-reviews-main", // Sera desenvolvido posteriormente - usado o bloco nativo da Konfidency acima
            // "flex-layout.row#product-reviews-footer" // Sera desenvolvido posteriormente - usado o bloco nativo da Konfidency acima
        ],
        "props": {
            "blockClass": "product-reviews"
        }
    },

    // Serao desenvolvidos posteriormente:
    // Linha 1 - header contendo foto, nome do avaliador e data da avaliação
    "flex-layout.row#product-reviews-header": {
        "title": "Linha 1 - header contendo foto, nome do avaliador e data da avaliação",
        "children": [
            "flex-layout.col#product-reviews-header"
        ],
        "props": {
            "blockClass": "product-reviews-header"
        }
    },
    "flex-layout.col#product-reviews-header": {
        "title": "Linha 1 - header contendo foto, nome do avaliador e data da avaliação",
        "children": [
            // Image-component - pode ser image-text-list ou list-context.image-list
            "image-text-list#product-reviews_client-data"
            // "rich-text#product-reviews_client-data"
        ],
        "props": {
            "blockClass": "product-reviews-header"
        }
    }

    // Linha 2 - avaliação
    
}
