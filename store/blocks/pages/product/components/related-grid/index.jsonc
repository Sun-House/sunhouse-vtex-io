// Componente descontinuado - Sera descontinuado no Refresh
{
  "container#product__related-grid": {
    "title": "Produtos relacionados",
    "props": {
      "htmlId": "products-similars",
      "wrapper": true,
      "blockClass": ["product__related-grid", "container-center"]
    },
    "children": ["condition-layout.user#related-grid"]
  },

  "condition-layout.user#related-grid": {
    "props": {
      "conditions": [
        {
          "subject": "isAuthenticated",
          "arguments": {
            "value": true
          }
        }
      ],
      "Then": "related-grid"
    }
  },

  "related-grid": {
    "children": [
      "related-grid.summary",
      "related-grid.filter",
      "related-grid.list-products"
    ],
    "props": {
      "hideOutOfStockItems": false
    }
  },

  "related-grid.list-products": {
    "blocks": ["product-summary.shelf#related-grid"],
    "children": ["container.list-render#related-grid__list-products"]
  },

  "product-summary.shelf#related-grid": {
    "props": {
      "blockClass": "related-grid"
    },
    "children": [
      "stack-layout#shelf-product-image--grid",
      "product-summary-name",
      "related-grid.quantity-selector"
    ]
  },

  "stack-layout#shelf-product-image--grid": {
    "title": "Imagem do produto vitrine",
    "children": ["container#image-shelf", "container#shelf-sku-selector"],
    "props": {
      "blockClass": ["shelf-product-image", "product-grid"]
    }
  },

  "container.list-render#related-grid__list-products": {
    "props": {
      "blockClass": ["related-grid__list-products"]
    }
  }
}
