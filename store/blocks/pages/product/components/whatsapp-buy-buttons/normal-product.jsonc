{
	"flex-layout.row#whatsapp-button_normal-product": {
		"children": ["link#unavailable-cta-wpp"],
		"props": {
			"blockClass": "whatsapp-button_normal-product"
    	}
	},

	"link#unavailable-cta-wpp": {
		"title": "Botão - WhatsApp",
		"children": [
			"icon#unavailable-cta-wpp"
		],
		"props": {
			"label": "Compre por WhatsApp",
			"href": "https://wa.me/5511994877664",
			"target": "_blank",
			"blockClass": "unavailable-cta-wpp_link"
		}
	},
	"icon#unavailable-cta-wpp": {
		"props": {
			"id": "inf-whatsapp-white",
			"size": 20,
			"activeClassName": "vtex-store-components-3-x-inf-whatsapp-white"
		}
	}
}