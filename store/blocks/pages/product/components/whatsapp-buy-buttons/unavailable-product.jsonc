{
    "container#product-unavailable": {
		"title": "Wrapper - Produto Indisponível",
		"children": [
			"rich-text#unavailable-cta_line-1",
			"rich-text#unavailable-cta_line-2",
            // "link#unavailable-cta-wpp"
			"whatsapp-dynamic-button#wpp-button-unavailable"
		],
		"props": {
			"blockClass": "unavailable-cta_container"
		}
	},
	"rich-text#unavailable-cta_line-1": {
		"title": "Paragrafo 1 - Produto Indisponível",
		"props": {
			"text": "## Produto Indispon&iacute;vel\nDeseja saber sobre a **disponibilidade** ou **op&ccedil;&otilde;es similares** deste produto? Nos chame no **WhatsApp** clicando no bot&atilde;o abaixo!",
			"blockClass": "unavailable-cta_text"
		}
	},
	"rich-text#unavailable-cta_line-2": {
		"title": "Paragrafo 2 - Produto Indisponível",
		"props": {
			"text": "Ou venha nos visitar: **Rua Teodoro Sampaio, 1749 - Pinheiros - (11) 2503-2996**",
			"blockClass": ["unavailable-cta_text", "unavailable-cta_line-2"]
		}
	},

