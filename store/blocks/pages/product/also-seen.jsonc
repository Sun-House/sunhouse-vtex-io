{
  "container#product-shelf-also-seen": {
    "title": "Prateleira - Recomendações",
    "children": [
      "flex-layout.row#also-seen"
    ],
    "props": {
      "blockClass": "product-shelf-also-seen"
    }
  },
  
  "flex-layout.row#also-seen": {
    "children": [
      "list-context.related-product-list#also-seen"
    ],
    "props": {
      "blockClass": ["also-seen", "shelf-container"],
      "fullWidth": true
    }
  },

  "list-context.related-product-list#also-seen": {
    "title": "Conf. da Prateleira Nativa VTEX",
    "blocks": ["product-summary.shelf#main-product-new"],
    "children": [
      "flex-layout.col#also-seen"
    ],
    "props": {
      "recommendation": "view",
      "maxItems": 9
    }
  },

  "flex-layout.col#also-seen": {
    "children": [
      "rich-text#also-seen",
      "hover-container#also-seen"
    ],
    "props": {
      "blockClass": "also-seen"
    }
  },

  "rich-text#also-seen": {
    "title": "Título da Prateleira",
    "props": {
      "text": "## Produtos que você pode gostar", // Esse titulo sempre sera relativo ao tipo de prateleira usada e a estrategia
      "blockClass": ["also-seen", "common-title"]
    }
  },

  "hover-container#also-seen": {
    "children": [
      "responsive-layout.desktop#shelf-slider",
      "responsive-layout.mobile#shelf-slider"
    ],
    "props": {
      "blockClass": ["also-seen", "hover-shelf-list"]
    }
  }
}
