{
    // Bloco principal contendo as informacoes
    "flex-layout.row#product-infos-wrapper": {
        "children": [
            "flex-layout.col#product-description-wrapper"
        ],
        "props": {
            "blockClass": "product-infos-wrapper"
        }
    },

    "flex-layout.col#product-description-wrapper": {
        "children": [
            "container#product-description-simple",
            "container#product-description-custom"
        ],
        "props": {
            "blockClass": "product-description-wrapper"
        }
    },
    "flex-layout.col#product-description-wrapper-mobile": {
        "children": [
            "disclosure-layout#product-page-description",
            "disclosure-layout#product-page-specs"
        ],
        "props": {
            "blockClass": "product-description-wrapper-mobile"
        }
    },

    // Descricao basica praticada com texto e SEO - Originada do Sistema Movelsoft
    "container#product-description-simple": {
        "title": "Descrição Normal (Movelsoft)",
        "children": [
            "flex-layout.row#product-description"
        ],
        "props": {
            "blockClass": "product-description-simple"
        }
    },

    // Descricao do produto customizada - blocos em DEV
    "container#product-description-custom": {
        "title": "Descrição Customizada",
        "children": [
            "flex-layout.col#product-description-custom"
        ],
        "props": {
            "blockClass": "product-description-custom"
        }
    },
    "flex-layout.col#product-description-custom": {
        "title": "Blocos Customizaveis",
        "children": [
            "container#custom-block__desc-banner", // Descricao ao lado do banner (esquerda texto - direita imagem) - colunas iguais em tamanho - IMPORTANTE mas nao obrigatorio
            // Tamanho imagem desse bloco: 581x 499

            "container#custom-block__text-summary", // Bloco Titulo com Subtitulo - Um titulo, igual ao titulo de caracteristicas, porem, com um subtitulo embaixo, para quebrar o gelo de tanta imagem e separar blocos.
            // Bloco podera se repetir mais uma ou duas vezes

            "container#custom-block__banner-fulfill", // Banner expandido para destaque produto (estilo cadeira Siggy Elements) - OPICIONAL mas pode ficar agradavel visualmente
            // Tamanho imagem desse bloco: 1174x643

            "container#custom-block__banner-fulfill-mob", // Igual o bloco acima, mas com algumas configs especificas para o Mobile - Padrao com dois slides, mas podem ter mais
            // Tamanho imagem desse bloco: 376x480

            "container#custom-block__feature-cards", // Ate quatro cards, dois para cada coluna, informando caracteristicas destaque do produto - IMPORTANTE mas nao obrigatorio
            // Tamanho imagens desse bloco: 383x255
            
            // Banner ou imagem destaque a esquerda (com carrossel) e a direita, tres cards de beneficios, diferenciais ou caracteristicas destaque do produto
            //"container#custom-block__highlights-grid",
            // Tamanho imagem desse bloco: 581x 499 (igual em tamanho do elemento desc-banner - mas ver se muda - deixa mais quadrado)
            
            // "A DEFINIR - Ver no Figma - O bloco abaixo ficara no lugar ate definicao posterior no Figma
            "container#custom-block__text-summary2", // Bloco Titulo com Subtitulo 2 - Um titulo, igual ao titulo de caracteristicas, porem, com um subtitulo embaixo, para quebrar o gelo de tanta imagem e separar blocos.
            // Bloco podera se repetir mais uma ou duas vezes

            "container#custom-block__slider-photo-grid", // Tres fotos, destaques, ou links, do fornecedor, produto ou linha - OPICIONAL mas muito relevante visualmente
            // Tamanho imagens desse bloco: 383x680

            "container#custom-block__wrapper-faq-disclosure" // 7 linhas de Perguntas Frequentes, gera SEO - OPICIONAL mas muito relevante para SEO e infos para o cliente
            //sem fotos, apenas os disclosures de FAQ
        ],
        "props": {
            "blockClass": "blocks__product-description-custom"
        }
    }

    // Descricao do produto customizada - Blocos abaixo foram movidos para arquivos proprios em components/custom-description
    
    // Bloco Descrição produto resumida - Text esquerda e foto na direita
    // > MOVIDO PARA ARQUIVO PROPRIO

    // Bloco Titulo com Subtitulo
    // > MOVIDO PARA ARQUIVO PROPRIO
    
    // Banner expandido - destaque produto ou marca
    // > MOVIDO PARA ARQUIVO PROPRIO

    // Bloco caracteristicas do produto - modelo bootstrap cards
    // > MOVIDO PARA ARQUIVO PROPRIO

    // Bloco Destaques em Grade
    // > MOVIDO PARA ARQUIVO PROPRIO

    // Bloco Titulo com Subtitulo 2
    // > MOVIDO PARA ARQUIVO PROPRIO
    
    // Bloco fotos destaque - esilo pichau - produto Cadeira Gamer Mancer Tyr Pro
    // > MOVIDO PARA ARQUIVO PROPRIO

    // Bloco FAQ
    // > MOVIDO PARA ARQUIVO PROPRIO
}