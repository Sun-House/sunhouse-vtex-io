// Novo bloco de Descricao do Produto e Especificacoes - pode ser evoluido futuramente com avaliacoes tambem
{
    // Bloco principal contendo as informacoes
    "flex-layout.row#product-infos-wrapper": {
        "children": [
            "flex-layout.col#product-description-wrapper"
        ],
        "props": {
            "blockClass": "product-infos-wrapper"
        }
    },

    "flex-layout.col#product-description-wrapper": {
        "children": [
            "container#product-description-simple",
            "container#product-description-custom"
        ],
        "props": {
            "blockClass": "product-description-wrapper"
        }
    },
    "flex-layout.col#product-description-wrapper-mobile": {
        "children": [
            "disclosure-layout#product-page-description",
            "disclosure-layout#product-page-specs"
        ],
        "props": {
            "blockClass": "product-description-wrapper-mobile"
        }
    },

    // Descricao basica praticada com texto e SEO - Originada do Sistema Movelsoft
    "container#product-description-simple": {
        "title": "Descrição Normal (Movelsoft)",
        "children": [
            "flex-layout.row#product-description"
        ],
        "props": {
            "blockClass": "product-description-simple"
        }
    },

    // Descricao do produto customizada - blocos em DEV
    "container#product-description-custom": {
        "title": "Descrição Customizada",
        "children": [
            "flex-layout.col#product-description-custom"
        ],
        "props": {
            "blockClass": "product-description-custom"
        }
    },
    "flex-layout.col#product-description-custom": {
        "title": "Blocos Customizaveis",
        "children": [
            "container#custom-block__desc-banner", // Descricao ao lado do banner - colunas iguais em tamanho - IMPORTANTE mas nao obrigatorio
            // Tamanho imagem desse bloco: 581x 499 - definir tamanho fixo para esse container de imagem

            "container#custom-block__main-banner-wide", // banner wide para destaque produto - IMPORTANTE mas nao obrigatorio
            // Tamanho imagem desse bloco: 1174x254 - definir tamanho fixo para esse container de imagem

            "container#custom-block__feature-cards", // ate quatro cards, dois para cada coluna, informando caracteristicas destaque do produto - IMPORTANTE mas nao obrigatorio
            // Tamanho imagens desse bloco: 383x255 - definir tamanho fixo para esses containers de imagens

            "container#custom-block__col-features", // ate seis bloquinhos, dois para cada coluna, informando caracteristicas do produto - IMPORTANTE mas nao obrigatorio
            // Tamanho imagens desse bloco: 284x172 - definir tamanho fixo para esses containers de imagens

            "container#custom-block__col-photo-grid" // Tres fotos, destaques, ou links, do fornecedor, produto ou linha - OPICIONAL mas muito relevante visualmente
            // Tamanho imagens desse bloco: 383x680 - definir tamanho fixo para esses containers de imagens
        ],
        "props": {
            "blockClass": "blocks__product-description-custom"
        }
    },

    // Descricao do produto customizada - abaixo seraracao dos blocos declarados acima
    // Bloco Descrição produto resumida - Text esquerda e foto na direita
    "container#custom-block__desc-banner": {
        "title": "Descricao com Banner",
        "children": [
            "flex-layout.row#desc-banner__row"
        ],
        "props": {
            "blockClass": "custom-block__desc-banner"
        }
    },
    "flex-layout.row#desc-banner__row": {
        "title": "Descricao com Banner Agrupamento",
        "children": [
            "flex-layout.col#desc-banner_ColText",
            "flex-layout.col#desc-banner_ColImage"
        ],
        "props": {
            "blockClass": "desc-banner__row"
        }
    },
    "flex-layout.col#desc-banner_ColText": {
        "title": "Coluna da Descrição",
        "children": [
            "rich-text#desc-banner__textoDescricao"
        ],
        "props": {
            "blockClass": ["col_desc-banner_ColText"]
        }
    },
    "flex-layout.col#desc-banner_ColImage": {
        "title": "Coluna da Foto do Produto ou Marca",
        "children": [
            "list-context.image-list#desc-banner__imagemDescricao"
        ],
        "props": {
            "blockClass": ["col_desc-banner_ColImage"]
        }
    },
    "rich-text#desc-banner__textoDescricao": {
        "title": "Descricao Texto",
        "props": {
            "text": "## Nome do Produto \n **Texto em Negrito** e [link exemplo](https://www.example.com). Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis nulla risus, tincidunt at ultrices vel, pellentesque ac augue. Fusce auctor odio non tempus hendrerit. Etiam tempus ab! Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis nulla risus, tincidunt at ultrices vel, pellentesque ac augue. Fusce auctor odio non tempus hendrerit. Etiam tempus ab! Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis nulla risus, tincidunt at ultrices vel, pellentesque ac augue. Fusce auctor odio non tempus hendrerit. Etiam tempus ab!",
            "blockClass": ["wrapper__textoDescricao-esquerda"]
        }
    },
    "list-context.image-list#desc-banner__imagemDescricao": {
        "title": "Foto Destaque Descricao",
        "props": {
            "images": [
                {
                    "image": "https://dummyimage.com/581x499",
                    "mobileImage": "https://dummyimage.com/581x499" // Ver dimensão do banner mobile
                }
            ],
            "blockClass": "img_desc-banner__imagemDescricao"
        },
        "children": ["container.list-render#desc-banner__imagemDescricao"]
    },
    "container.list-render#desc-banner__imagemDescricao": {
        "props": {
            "blockClass": ["custom-description-banner", "container_desc-banner__imagemDescricao"]
        }
    },

    // Banner fino - destaque marca, fornecedor ou produto - curva A
    "container#custom-block__main-banner-wide": {
        "title": "Banner Apresentação",
        "children": [
            "list-context.image-list#main-banner-wide"
        ],
        "props": {
            "blockClass": "custom-block__main-banner-wide"
        }
    },
    "list-context.image-list#main-banner-wide": {
        "props": {
            "images": [
                {
                    "image": "https://dummyimage.com/1174x254",
                    "mobileImage": "https://dummyimage.com/1174x254" // Ver dimensão do banner mobile
                }
            ],
            "blockClass": "main-banner-wide"
        },
        "children": ["container.list-render#main-banner-wide"]
    },
    "container.list-render#main-banner-wide": {
        "props": {
            "blockClass": ["custom-description-banner", "main-banner-wide"]
        }
    },

    // Bloco caracteristicas 2 do produto - modelo bootstrap cards
    "container#custom-block__feature-cards": {
        "title": "Cards - Carcteristicas em Destaque",
        "children": [
            "flex-layout.row#feature-card__row"
        ],
        "props": {
            "blockClass": "custom-block__feature-cards"
        }
    },

