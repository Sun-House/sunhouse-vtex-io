// Novo bloco de Descricao do Produto e Especificacoes - pode ser evoluido futuramente com avaliacoes tambem
{
    // Bloco principal contendo as informacoes
    "flex-layout.row#product-infos-wrapper": {
        "children": [
            "flex-layout.col#product-description-wrapper"
        ],
        "props": {
            "blockClass": "product-infos-wrapper"
        }
    },

    "flex-layout.col#product-description-wrapper": {
        "children": [
            "container#product-description-simple",
            "container#product-description-custom"
        ],
        "props": {
            "blockClass": "product-description-wrapper"
        }
    },
    "flex-layout.col#product-description-wrapper-mobile": {
        "children": [
            "disclosure-layout#product-page-description",
            "disclosure-layout#product-page-specs"
        ],
        "props": {
            "blockClass": "product-description-wrapper-mobile"
        }
    },

    // Descricao basica praticada com texto e SEO
    "container#product-description-simple": {
        "title": "Descrição Normal (Texto)",
        "children": [
            "flex-layout.row#product-description"
        ],
        "props": {
            "blockClass": "product-description-simple"
        }
    },

    // Descricao do produto customizada - blocos ainda em DEV
    "container#product-description-custom": { // ver se é possivel criar bg customizado para fundo de toda a custom description
        "title": "Descrição Customizada",
        "children": [
            "flex-layout.col#product-description-custom"
        ],
        "props": {
            "blockClass": "product-description-custom"
        }
    },
    "flex-layout.col#product-description-custom": {
        "title": "Blocos Customizaveis",
        "children": [
            "container#custom-block__main-banner-wide", // banner wide para destaque produto - IMPORTANTE mas nao obrigatorio
            "container#custom-block__col-features", // ate quatro blocos, dois para cada coluna, informando caracteristicas do produto - IMPORTANTE mas nao obrigatorio
            "container#custom-block__col-seo", // col 1 esquerda - descricao em texto SEO simplificada e sem topicos - col 2 direita - foto destaque produto
            "container#custom-block__col-photo-grid" // ate seis blocos, dois para cada coluna, apresentando fotos ambientadas - OPICIONAL
        ],
        "props": {
            "blockClass": "blocks__product-description-custom"
        }
    },

    // Descricao do produto customizada - seraracao dos blocos declarados acima
    "container#custom-block__main-banner-wide": {
        "title": "Banner Apresentação",
        "children": [
            "list-context.image-list#main-banner-wide"
        ],
        "props": {
            "blockClass": "custom-block__main-banner-wide"
        }
    },
    "list-context.image-list#main-banner-wide": {
        "props": {
            "blockClass": "main-banner-wide",
            "images": [
                {
                    "image": "https://dummyimage.com/1200x260",
                    "mobileImage": "https://dummyimage.com/1200x260" // Ver dimensão do banner mobile
                }
            ]
        },
        "children": ["container.list-render#main-banner-wide"]
    },
    "container.list-render#main-banner-wide": {
        "props": {
            "blockClass": ["custom-description-banner", "main-banner-wide"]
        }
    },
    
    // Bloco caracteristicas do produto - foco em acabamento e detalhes - estilo Flexform
    "container#custom-block__col-features": {
        "title": "Grid - Principais Características",
        "children": [
            "flex-layout.row#feature__RowOne",
            "flex-layout.row#feature__RowTwo",
            "flex-layout.row#feature__RowThree"
        ],
        "props": {
            "blockClass": "custom-block__col-features"
        }
    },
    
    "flex-layout.row#feature__RowOne": {
        "title": "",
        "children": [
            "flex-layout.col#feature__RowOne-ColOne",
            "flex-layout.col#feature__RowOne-ColTwo",
            "flex-layout.col#feature__RowOne-ColThree",
            "flex-layout.col#feature__RowOne-ColFour"
        ],
        "props": {
            "blockClass": "blockOne"
        }
    },
    "flex-layout.col#feature__RowOne-ColOne": {
        "title": "",
        "children": [
            "list-context.image-list#RowOne-ColOne_image"
        ],
        "props": {
            "blockClass": ["wrapper__custom-description-banner"]
        }
    },
    "list-context.image-list#RowOne-ColOne_image": {
        "props": {
            "blockClass": "",
            "images": [
                {
                    "image": "https://dummyimage.com/289x175",
                    "mobileImage": "https://dummyimage.com/289x175"
                }
            ]
        },
        "children": ["container.list-render#RowOne-ColOne_image"]
    },
    "container.list-render#RowOne-ColOne_image": {
        "props": {
            "blockClass": ["custom-description-banner"]
        }
    },
    "flex-layout.col#feature__RowOne-ColTwo": {
        "title": "",
        "children": [
            "rich-text#RowOne-ColTwo_text"
        ],
        "props": {
            "blockClass": "wrapper__custom-description-banner"
        }
    },
    "rich-text#RowOne-ColTwo_text": {
        "title": "",
        "props": {
            "text": "## Sun House \n Para as noites tristes, algumas gotas de jasmim. Para acalmar as dores, exale camomila ou lavanda. Já nos dias frios, nada melhor que o cheirinho de canela espalhado pela casa. Com perfume, a vida fica mais bonita e aconchegante!",
            "blockClass": "wrapper__custom-description-text"
            // "textPosition": "CENTER"
            // "textAlignment": "CENTER"
        }
    },
