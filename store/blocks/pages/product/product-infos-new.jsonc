{
    "flex-layout.row#product-infos-wrapper": {
        "children": [
            "flex-layout.col#product-description-wrapper"
        ],
        "props": {
            "blockClass": "product-infos-wrapper"
        }
    },

    "flex-layout.col#product-description-wrapper": {
        "children": [
            "container#product-description-pure-text",
            "container#product-description-simple",
            "container#product-description-ms",

            // Novos blocos de informações do produto:
            "container#product-description-benefits",
            "container#product-description-video",
            "container#product-description-additional-infos",
            "container#product-description-important-text",
            "container#product-description-brand-text",

            // A principio ficara melhor por ultimo - mas ao fim do projeto podera mudar
            "container#product-description-custom",
            "container#product-faq"
        ],
        "props": {
            "blockClass": "product-description-wrapper"
        }
    },
    "flex-layout.col#product-description-wrapper-mobile": {
        "children": [
            "disclosure-layout#product-page-description",
            "disclosure-layout#product-page-specs"
        ],
        "props": {
            "blockClass": "product-description-wrapper-mobile"
        }
    }
}
