{
    "flex-layout.row#product-infos-wrapper": {
        "children": [
            "flex-layout.col#product-description-wrapper"
        ],
        "props": {
            "blockClass": "product-infos-wrapper"
        }
    },

    "flex-layout.col#product-description-wrapper": {
        "children": [
            "container#product-description-simple",
            "container#product-description-custom"
        ],
        "props": {
            "blockClass": "product-description-wrapper"
        }
    },
    "flex-layout.col#product-description-wrapper-mobile": {
        "children": [
            "disclosure-layout#product-page-description",
            "disclosure-layout#product-page-specs"
        ],
        "props": {
            "blockClass": "product-description-wrapper-mobile"
        }
    },

    // Normal Description Wrapper
    "container#product-description-simple": {
        "title": "Descrição Normal (Movelsoft)",
        "children": [
            "flex-layout.row#product-description"
        ],
        "props": {
            "blockClass": "product-description-simple"
        }
    },

    // Custom Description v1 - Wrapper
    "container#product-description-custom": {
        "title": "Descrição Customizada",
        "children": [
            "flex-layout.row#product-description-custom"
        ],
        "props": {
            "blockClass": "product-description-custom"
        }
    },
    
    "flex-layout.row#product-description-custom": {
        "title": "Blocos Customizaveis",
        "children": [
            "flex-layout.col#product-description-custom"
        ],
        "props": {
            "blockClass": "product-custom-description_line-wrapper"
        }
    },
    "flex-layout.col#product-description-custom": {
        "children": [
            "container#line-wrapper-1",
            "container#line-wrapper-2",
            "container#line-wrapper-3",
            "container#line-wrapper-4",
            "container#line-wrapper-5",
            "container#line-wrapper-6",
            "container#line-wrapper-7",
            "container#line-wrapper-8",
            "container#line-wrapper-9",
            "container#line-wrapper-10",
            "container#line-wrapper-11",
            "container#line-wrapper-12",
            "container#line-wrapper-13",
            "container#line-wrapper-14",
            "container#line-wrapper-15" // Bloco da FAQ - conforme task da liveSEO, preciso mover esse para outra parte da PDP e desvincular da custom description, pois será para todos os produtos
            // "container#line-wrapper-16"
        ],
        "props": {
            "blockClass": ["blocks__product-description-custom", "product-custom-description_col-wrapper"]
        }
    }
}
