{
	// Bloco de Preços 1 - Versao original Edson - Destaque para o preço no Pix

	// List Price Block - PDP
    // "container#product-listPrice-new": {
	"container#product-low-price": {
		// "title": "Preço (com preço de lista) produto vitrine",
		"title": "Preço Pix Destacado",
		"children": [
			"product-list-price#product-page", // Preço DE
			"discount-price#product-page", // Preço PIX
			"product-selling-price#product-page", // Preço POR - Só vai aparecer no caso de nao renderizar o Installments Block (confirmar se é isso mesmo)
			"flex-layout.col#installments-content" // Lista de parcelas com texto informativo de parcelamento
		],
		"props": {
			// "blockClass": "shelf-product-listPrice"
			"blockClass": ["shelf-product-listPrice", "product-low-price"]
		}
	},

    "product-list-price#product-page": {
		// "title": "Preço de lista produto vitrine",
		"props": {
			"message": "{listPriceValue}",
			"blockClass": "product-shelf-price"
		}
	},

	"discount-price#product-page": {
		// "title": "Preço PIX produto vitrine",
		"props": {
			"hideWithoutDiscount": true,
			"message": "{priceValue}",
			"blockClass": "shelf-default",
			// "promotionName": "Desconto Pagamento à Vista (7%)"
			"promotionName": "Desconto Pagamento a Vista (10%)"
		}
	},

	"product-selling-price#product-page": {
		// "title": "Preço (com preço de lista) produto vitrine",
		"props": {
			"message": "<bold>{sellingPriceValue}</bold>",
			"markers": ["bold"],
			"blockClass": "product-shelf-price"
		}
	},
	// List Price Block - PDP

    
    // Installments Block - PDP
    "flex-layout.col#installments-content": {
        "children": [
            "product-installments#page-product"
        ],
        "props": {
            "blockClass": "installments-content"
        }
    },
    "product-installments#page-product": {
        "props": {
            "installmentsCriteria": "max-quantity",
            "markers": ["bold"],
            // "message": "Ou <bold>{installmentsTotalValue}</bold> em até <bold>{installmentsNumber}x</bold> de <bold>{installmentValue}</bold> sem juros no cartão de crédito",
            "message": "À vista no <bold>PIX</bold>, Ou em até <bold>{installmentsNumber}x de {installmentValue}</bold>",
            "blockClass": "product-page"
        }
    },
    // Installments Block - PDP
	
	// Bloco de Preços 2 - Versao destaque para o preço em 10x
	"container#product-high-price": {
		"title": "Preço Parcelado Destacado",
		"children": [
			"product-list-price#product-high-price", // Preço DE
			// Criar um overlay para o componente abaixo para abrir drawner à direita com lista de parcelas
			// ,"product-installments-list" -> Precisa ser configurado para aparecer em modal ou drawer lateral
			// Esse DEV poderá nao sair no lançamento do Refresh, mas ficará em backlog prioritario
			"flex-layout.col#installments-content-high-price", // Preço POR + parcelas
			"discount-price#product-high-price"
		],
		"props": {
			"blockClass": ["shelf-product-listPrice", "product-high-price"]
		}
	},

	// PREÇO DE
	"product-list-price#product-high-price": {
		"title": "Preço DE",
		"props": {
			"message": "{listPriceValue}",
			"blockClass": ["product-shelf-price", "product-high-price--from"]
		}
	},

	"product-selling-price#product-high-price": {
		"title": "Preço POR - Nao aparece sempre",
		"props": {
			"message": "<bold>{sellingPriceValue}</bold>",
			"markers": ["bold"],
			"blockClass": ["product-shelf-price", "product-high-price--selling-price"]
		}
	},
    
    // LINHA DE PARCELAS COM TEXTO INFORMATIVO DE PARCELAMENTO
    "flex-layout.col#installments-content-high-price": {
        "children": [
            "product-installments#page-product-high-price"
		],
        "props": {
            "blockClass": "installments-content"
        }
    },
    "product-installments#page-product-high-price": {
        "props": {
            "installmentsCriteria": "max-quantity",
            "markers": [
				"highlight",
				"bold"
			],
			"message": "<highlight>{installmentsTotalValue}</highlight> em até <bold>{installmentsNumber}x</bold> de <bold>{installmentValue}</bold>",
            "blockClass": ["product-page", "product-high-price--to-price"]
        }
    },

	// PREÇO PIX
	"discount-price#product-high-price": {
		"title": "Preço PIX",
		"props": {
			"hideWithoutDiscount": true,
			"message": "Ou {priceValue} à vista no PIX",
			// "promotionName": "Desconto Pagamento à Vista (7%)",
			"promotionName": "Desconto Pagamento a Vista (10%)",
			"blockClass": "product-high-price--pix"
		}
	}
}
