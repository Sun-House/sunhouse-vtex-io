{
  "store.custom#designers": {
    "blocks": [
      "responsive-layout.desktop#banner-designers",
      "responsive-layout.tablet#banner-designers",
      "responsive-layout.phone#banner-designers",
      "container#designers-breadcrumb",
      "container#designers-info",
      "container#designer--1",
      "container#designer--2",
      "container#designer--3",
      "container#designer-group",
      "container#designer--6",
      "container#designer-group--2"
    ]
  },

  "container#designer-group": {
    "props": {
      "wrapper": true,
      "blockClass": ["designer-group", "designer-group--1", "container-center"]
    },
    "children": ["container#designer--4", "container#designer--5"]
  },

  "container#designer-group--2": {
    "props": {
      "wrapper": true,
      "blockClass": ["designer-group", "designer-group--2", "container-center"]
    },
    "children": ["container#designer--7", "container#designer--8"]
  },

  // Main banners
  "responsive-layout.desktop#banner-designers": {
    "children": ["image#banner-designers"]
  },

  "responsive-layout.tablet#banner-designers": {
    "children": ["image#banner-designers"]
  },

  "responsive-layout.phone#banner-designers": {
    "children": ["image#banner-designers--mobile"]
  },

  "image#banner-designers": {
    "title": "Banner do designer",
    "props": {
      "blockClass": ["designer"],
      "src": "assets/images/designers/banner.png"
    }
  },

  "image#banner-designers--mobile": {
    "title": "Banner do designer para mobile",
    "props": {
      "blockClass": ["designer", "designer--mobile"],
      "src": "assets/images/designers/banner-mobile.png"
    }
  },

  // Main info
  "container#designers-info": {
    "props": {
      "wrapper": true,
      "blockClass": ["designers-info", "container-center"]
    },
    "children": [
      "rich-text#designers-info--title",
      "container#designers-info--content"
    ]
  },

  "rich-text#designers-info--title": {
    "props": {
      "blockClass": "designers-info-title",
      "text": "#inspire\n # Designers"
    }
  },

  "container#designers-info--content": {
    "props": {
      "blockClass": "designers-info--content"
    },
    "children": ["rich-text#designers-info", "image#designers-info"]
  },

  "rich-text#designers-info": {
    "props": {
      "blockClass": "designers-info",
      "text": "Bem-vindo à nossa página dedicada aos maiores designers de móveis renomados e atuais! Aqui, você encontrará uma coleção única de designers de todo o mundo, com uma ampla gama de estilos e habilidades. Desde designers consagrados com décadas de experiência, até jovens talentos que estão rapidamente se destacando na indústria, nós reunimos o melhor da atualidade.\n\nSe você está procurando por uma peça de móvel para complementar sua casa, ou se deseja fazer uma escolha significativa para sua empresa ou escritório, pode encontrar o design perfeito para você nessa página. Aqui, você pode navegar pelos portfólios de cada designer e escolher o estilo e a habilidade que melhor se adapte às suas necessidades.\nNão perca mais tempo, comece a navegar em nossa página agora mesmo e descubra o designer ideal para suas necessidades. Estamos animados para ajudá-lo a encontrar a peça perfeita de móvel!"
    }
  },

  "image#designers-info": {
    "title": "Banner",
    "props": {
      "blockClass": ["info"],
      "src": "assets/images/designers/info.png"
    }
  },

