  "rich-text#designer__content--4": {
    "props": {
      "blockClass": "designer__content",
      "text": "Eero Saarinen (1910-1961), arquiteto e designer finlandês, emigrou para os EUA em 1923 e formou-se em arquitetura em Yale. Suas formas orgânicas e modernistas marcaram concursos de design de móveis, influenciando o design contemporâneo."
    }
  },

  "link#designer__content--4": {
    "props": {
      "blockClass": "designer__content",
