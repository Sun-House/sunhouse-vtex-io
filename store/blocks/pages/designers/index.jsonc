  "rich-text#designer__title--1": {
    "props": {
      "blockClass": ["designer__title", "designer__title--1"],
      "text": "## Charles e Ray Eames"
    }
  },

  "container#designer__content--1": {
    "props": {
      "blockClass": ["designer__content", "designer__content--1"]
    },
    "children": [
      "container#designer__title--1",
      "rich-text#designer__content--1",
      "link#designer__content--1"
    ]
  },

  "rich-text#designer__content--1": {
    "props": {
      "blockClass": ["designer__content", "designer__content--1"],
      "text": "Charles e Ray Eames (1907-1978 e 1912-1988) foram uma dupla americana icônica no design mundial. Eles se conheceram na faculdade e, após o casamento, formaram uma parceria de sucesso no desenvolvimento de móveis. Juntos, revolucionaram o design do século XX, criando peças que equilibram funcionalidade e estética. Suas criações, como as cadeiras moldadas, são até hoje referências no design moderno, com um legado que permanece forte no mobiliário contemporâneo."
    }
  },

  "link#designer__content--1": {
    "props": {
      "blockClass": ["designer__content", "designer__content--1"],
      "label": "Conheça suas peças",
      "href": "/designers/charles-e-ray-eames"
    }
  },

  // Harry Bertóia
  "container#designer--2": {
    "props": {
      "wrapper": true,
      "blockClass": ["designer", "designer--2", "container-wrapper"]
    },
    "children": ["container#designer__content--2", "image#designer__image--2"]
  },

  "image#designer__image--2": {
    "title": "Banner do designer",
    "props": {
      "blockClass": ["designer", "designer--2"],
      "src": "assets/images/designers/designer--2.png"
    }
  },

  "container#designer__title--2": {
    "props": {
      "blockClass": ["designer__title", "designer__title--2"]
    },
    "children": ["image#designer__title--2", "rich-text#designer__title--2"]
  },

  "image#designer__title--2": {
    "title": "Banner do designer",
    "props": {
      "blockClass": ["designer__title", "designer__title--2"],
      "src": "assets/images/designers/designer-title--2.png"
    }
  },

  "rich-text#designer__title--2": {
    "props": {
      "blockClass": "designer__title",
      "text": "## Harry Bertóia"
    }
  },

  "container#designer__content--2": {
    "props": {
      "blockClass": ["designer__content", "designer__content--2"]
    },
    "children": [
      "container#designer__title--2",
      "rich-text#designer__content--2",
      "link#designer__content--2"
    ]
  },

  "rich-text#designer__content--2": {
    "props": {
      "blockClass": "designer__content",
      "text": "Harry Bertoia nasceu em San Lorenzo, Itália, em 10 de março de 1915. Designer de renome, estudou na Cranbrook Academy of Art, onde conheceu ícones como Charles e Ray Eames. Suas criações são conhecidas pela leveza e inovação. Harry definia suas obras como 'feitas de ar', destacando a simplicidade e a transparência de suas peças. Entre suas criações mais famosas estão as cadeiras em arame, que se tornaram clássicos do design mundial. O legado de Bertoia é marcado por sua habilidade de combinar arte e funcionalidade de forma única."
    }
  },

  "link#designer__content--2": {
    "props": {
      "blockClass": "designer__content",
      "label": "Conheça suas peças",
      "href": "/designers/harry-bertoia"
    }
  },

  // Xavier Pauchard
  "container#designer--3": {
    "props": {
      "blockClass": ["designer", "designer--3"]
