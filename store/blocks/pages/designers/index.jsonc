  "image#designer__image--1": {
    "title": "Banner do designer",
    "props": {
      "blockClass": ["designer", "designer--1"],
      "src": "assets/images/designers/designer--1.png"
    }
  },

  "image#designer__image--1--mobile": {
    "title": "Banner do designer para mobile",
    "props": {
      "blockClass": ["designer", "designer--1", "designer--mobile"],
      "src": "assets/images/designers/designer-mobile--1.png"
    }
  },

  "container#designer__title--1": {
    "props": {
      "blockClass": ["designer__title", "designer__title--1"]
    },
    "children": ["image#designer__title--1", "rich-text#designer__title--1"]
  },

  "image#designer__title--1": {
    "title": "Banner do designer",
    "props": {
      "blockClass": ["designer__title", "designer__title--1"],
