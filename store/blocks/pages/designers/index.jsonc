  "rich-text#designer__content--8": {
    "props": {
      "blockClass": "designer__content",
      "text": "Theo Egami é um designer que une história e cultura oriental em suas criações. Suas peças são marcadas pela simplicidade, harmonia e funcionalidade. Influenciado pelo minimalismo japonês, Theo valoriza o equilíbrio e a precisão em cada detalhe, criando móveis que refletem sua trajetória pessoal e profissional. Combinando estética e funcionalidade, seu trabalho é um reflexo de sua busca constante por inovação, sempre mantendo a essência da cultura oriental em evidência."
    }
  },

  "link#designer__content--8": {
    "props": {
      "blockClass": "designer__content",
      "label": "Conheça suas peças",
      "href": "/designers/theo-egami"
