{
  "store.custom#collection": {
    "blocks": ["sunhouse.search-result:search-result-layout.customQuery#collection"],
    // Nova infraestrutura de SEO - Reflete desktop e mobile simultaneamente
    "children": [
      "container#search-seo-new"
    ],
    //
    "props": {
      "context": {
        "skusFilter": "ALL_AVAILABLE",
        "orderByField": "OrderByTopSaleDESC",
        "maxItemsPerPage": 28
      }
    }
  },
  "sunhouse.search-result:search-result-layout.customQuery#collection": {
    "title": "Configurações de Coleção",
    "blocks": [
      "sunhouse.search-result:search-result-layout.desktop",
      "sunhouse.search-result:search-result-layout.mobile",
      "sunhouse.search-result:search-not-found-layout"
    ]
  }
}
