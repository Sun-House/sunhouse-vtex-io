{
  "container#institutional": {
    "props": {
      "blockClass": "institutional"
    },
    "children": [
      "container#institutional-breadcrumb",
      "container#institutional-wrapper-menu-content"
    ]
  },

  "container#institutional-wrapper-menu-content": {
    "props": {
      "blockClass": ["wrapper-menu-content"]
    },
    "children": [
      "container#institutional-menu",
      "container#institutional-content"
    ]
  },

  "container#institutional-content": {
    "props": {
      "blockClass": "institutional-content"
    },

    "children": [
      "rich-text#institutional-title",
      "rich-text#institutional-description"
    ]
  },

  "rich-text#institutional-title": {
    "title": "Título",
    "props": {
      "text": "# PRIVACIDADE E SEGURANÇA",
      "blockClass": ["title", "clean"]
    }
  },

