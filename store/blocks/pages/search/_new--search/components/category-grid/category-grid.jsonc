{
    "container#plp-category-grid": {
        "title": "Grid Categorias",
        "children": [
            "flex-layout.row#plp-category-grid"
        ],
        "props": {
            "blockClass": "plp-category-grid"
        }
    },

    "flex-layout.row#plp-category-grid": {
        "children": [
            "flex-layout.col#plp-category-grid"
        ],
        "props": {
            "colSizing": "equal",
            "preventVerticalStretch": true,
            "blockClass": "plp-category-grid"
        }
    },
    "flex-layout.col#plp-category-grid": {
        "children": [
            "image-text-list#plp-category-grid_images"
        ],
        "props": {
            "width": "grow",
            "blockClass": "plp-category-grid"
        }
    },

    "image-text-list#plp-category-grid_images": {
        "title": "Grid Itens",
        "children": [
            "responsive-layout.desktop#plp-category-grid",
            "responsive-layout.mobile#plp-category-grid"
        ],
        "props": {
            "imageTextArray": [
                {
                    "imageText": "Categoria",
                    "image": "https://dummyimage.com/300x300",
                    "link": "#"
                },
                {
                    "imageText": "Categoria",
                    "image": "https://dummyimage.com/300x300",
                    "link": "#"
                },
                {
                    "imageText": "Categoria",
                    "image": "https://dummyimage.com/300x300",
                    "link": "#"
                },
                {
                    "imageText": "Categoria",
                    "image": "https://dummyimage.com/300x300",
                    "link": "#"
                },
                {
                    "imageText": "Categoria",
                    "image": "https://dummyimage.com/300x300",
                    "link": "#"
                }
            ],
            "blockClass": "plp-category-grid_items"
        }
    },

    "responsive-layout.desktop#plp-category-grid": {
        "children": [
            // "embla-carousel#plp-category-grid_carousel.desktop"
            "slider-layout#plp-category-grid_carousel.desktop"
        ]
    },
    "slider-layout#plp-category-grid_carousel.desktop": {
        "title": "Configurações do Slider",
        "props": {
            "itemsPerPage": {
                "desktop": 5
            },
            "showPaginationDots": "never", // Acredito que será o ideal ter apenas no Mobile - validar conforme prop abaixo
            "showNavigationArrows": "desktopOnly", // Talvez precise mudar para o Refresh - a definir Mobile
            "infinite": false,
			"navigationStep": 1,
            "blockClass": ["shelf", "main-shelf", "plp-category-grid_carousel"]
        }
    },

    // Descontinuado - pessimo de configurar, app criado pela Eplus cheio de bugs e problemas estruturais
    "embla-carousel#plp-category-grid_carousel.desktop": {
        "props": {
            "options": {
                "navigation": false,
                "dots": false,
                "draggable": false,
                "loop": false,
                "align": "center"
            },
            "blockClass": "plp-category-grid_carousel"
        }
    },
    //

    "responsive-layout.mobile#plp-category-grid": {
        "children": [
            "embla-carousel#plp-category-grid_carousel.mobile"
        ]
    },
    "embla-carousel#plp-category-grid_carousel.mobile": {
        "props": {
            "options": {
                "navigation": false,
                "dots": false,
                "draggable": true,
                "dragFree": true,
                "loop": false,
                // "align": "center" // Aparentemente nao esta fazendo diferença ou ajudando em algo aqui
                // "selectedOnClick": true, // Aparentemente nao esta fazendo diferença
                "disabledPreventClick": true
            },
            "blockClass": "plp-category-grid_carousel-mobile"
        }
    }
}
