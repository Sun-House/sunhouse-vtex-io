// Componente principal da Vitrine de Ambientes - repete tanto para o slider quanto para o unico
{
    "flex-layout.row#ambient-showcase": {
        "children": [
            "flex-layout.col#ambient-showcase-left", // Imagem(ns)
            "flex-layout.col#ambient-showcase-right" // Produtos (2x2)
        ],
        "props": {
            // "colGap": 6, - Aplica o tachyon somente na primeira coluna, o que resulta em comportamento estranho para a segunda coluna em relação a ocupar mais espaço verticalmente do que a primeira
            "colSizing": "equal",
            "blockClass": "ambient-showcase-item"
        }
    },

    // Coluna da esquerda - Imagem unica do Ambiente (ou pode ser feita uma lista de imagens, algo a se pensar posteriormente)
    "flex-layout.col#ambient-showcase-left": {
        "title": "Coluna Esquerda - Imagem",
        "children": [
            "list-context.image-list#ambient-showcase-image"
        ],
        "props": {
            "paddingRight": 4,
            "blockClass": "ambient-showcase-item"
        }
    },

    "list-context.image-list#ambient-showcase-image": {
        "title": "Imagem",
        "props": {
            "images": [
                {
                    "image": "https://dummyimage.com/598x976", // Tamanho medio ideal - devera mudar de acordo com o contexto da prateleira (produto ou SKU)
                    "maxHeight": "100%" // Apenas para evitar o padrao que reduz a imagem, para CLS/LCP sera controlado via CSS
                }
            ],
            "blockClass": "ambient-showcase-image"
        },
        "children": [
            "container.list-render#ambient-showcase-image"
        ]
    },
    "container.list-render#ambient-showcase-image": {
        "props": {
            "blockClass": "ambient-showcase-image"
        }
    },

    // Coluna da direita - Vitrine de Produtos (2x2)
    "flex-layout.col#ambient-showcase-right": {
        "title": "Coluna Direita - Produtos",
        "children": [
            "container#ambient-showcase_product-list",
            "container#ambient-showcase_sku-list"
        ],
        "props": {
            "paddingLeft": 4,
            "blockClass": "ambient-showcase-item"
        }
    },

    "container#ambient-showcase_product-list": {
        // "title": "Lista de Produtos",
        "title": "Lista Nativa VTEX",
        "children": [
            "hover-container#ambient-showcase_shelf-product-list"
        ],
        "props": {
            "blockClass": "ambient-showcase_shelf-product-list"
        }
    },

    "container#ambient-showcase_sku-list": {
        "title": "Lista de SKUs",
        "children": [
            "hover-container#ambient-showcase_shelf-sku-list"
        ],
        "props": {
            "blockClass": "ambient-showcase_shelf-sku-list"
        }
    },

    "responsive-layout.desktop#ambient-showcase_shelf": {
        "children": [
            "container.list-render#ambient-showcase_shelf"
        ]
    },
    "container.list-render#ambient-showcase_shelf": {
        "props": {
            "blockClass": "ambient-showcase_shelf"
        }
    }

    // *****
    // Ainda nao desenvolvido:
    // "responsive-layout.mobile#ambient-showcase_shelf": {
    //     "children": [
    //         // Possivelmente vira um embla carousel ou um slider layout - AINDA EM DEV
    //     ]
    // }
}
