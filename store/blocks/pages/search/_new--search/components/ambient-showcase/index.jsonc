{
    "container#ambient-showcase-wrapper": {
        "title": "Vitrine de Ambientes",
        "children": [
            "container#ambient-showcase-unique",
            "container#ambient-showcase-slider"
        ],
        "props": {
            "blockClass": "ambient-showcase-wrapper"
        }
    },

    // Single - Unico
    "container#ambient-showcase-unique": {
        "title": "Unico",
        "children": [
            "container#ambient-showcase"
        ],
        "props": {
            "blockClass": ["ambient-showcase", "ambient-showcase_unique"]
        }
    },

    // Slider - Carrossel
    "container#ambient-showcase-slider": {
        "title": "Carrossel",
        "children": [
            "slider-layout#ambient-showcase"
        ],
        "props": {
            "blockClass": ["ambient-showcase", "ambient-showcase_slider"]
        }
    }
}
