{
  "store.search": {
    "blocks": ["sunhouse.search-result:search-result-layout#cluster-and-search"],
    "props": {
      "context": {
        "skusFilter": "ALL_AVAILABLE",
        "orderByField": "OrderByTopSaleDESC",
        "maxItemsPerPage": 12
      }
    }
  },
  "store.search#department": {
    "blocks": ["sunhouse.search-result:search-result-layout"],
    "props": {
      "context": {
        "skusFilter": "ALL_AVAILABLE",
        "orderByField": "OrderByTopSaleDESC",
        "maxItemsPerPage": 12
      }
    }
  },
  "store.search#category": {
    "blocks": ["sunhouse.search-result:search-result-layout"],
    "props": {
      "context": {
        "skusFilter": "ALL_AVAILABLE",
        "orderByField": "OrderByTopSaleDESC",
        "maxItemsPerPage": 12
      }
    }
  },
  "store.search#brand": {
    "blocks": ["sunhouse.search-result:search-result-layout"],
    "props": {
      "context": {
        "skusFilter": "ALL_AVAILABLE",
        "orderByField": "OrderByTopSaleDESC",
        "maxItemsPerPage": 12
      }
    }
  },
  "store.search#subcategory": {
    "blocks": ["sunhouse.search-result:search-result-layout"],
    "props": {
      "context": {
        "skusFilter": "ALL_AVAILABLE",
        "orderByField": "OrderByTopSaleDESC",
        "maxItemsPerPage": 12
      }
    }
  },
  
  //
  "container#banner-department-desktop": {
    "title": "Banner-Departamento/Categoria",
    // "children": ["image#search-result"],
    "children": [
      "info-card#banner-category"
    ],
    "props": {
      "blockClass": "search-banner"
    }
  },
  //

  // Componente desativado no Refresh - Precisa ser removido
  "image#search-result": {
    "title": "Banner Departamento",
    "props": {
      "src": "assets/images/search/banner.png",
      "blockClass": "search-result"
    }
  },
  //

  "sunhouse.search-result:search-result-layout#cluster-and-search": {
    "blocks": [
      "sunhouse.search-result:search-result-layout.desktop#cluster-and-search",
      "sunhouse.search-result:search-result-layout.mobile#cluster-and-search",
      "sunhouse.search-result:search-not-found-layout"
    ]
  },
  "sunhouse.search-result:search-result-layout": {
    "blocks": [
      "sunhouse.search-result:search-result-layout.desktop",
      "sunhouse.search-result:search-result-layout.mobile",
      "sunhouse.search-result:search-not-found-layout"
    ]
  },

  "sunhouse.search-result:search-result-layout.desktop#cluster-and-search": {
    "title": "Pagina de busca desktop",
    "children": [
      // "flex-layout.row#search-breadcrumb",
      "flex-layout.row#search-result-cluster-and-search",
      "container#search-seo",
      "container#spacing-default"
      // "container#blog-cards",
      // "container#spacing-default"
    ],
    "props": {
      "showFacetQuantity": true
    }
  },
  "sunhouse.search-result:search-result-layout.mobile#cluster-and-search": {
    "title": "Pagina de busca mobile",
    "children": [
      // "flex-layout.row#search-breadcrumb",
      "flex-layout.row#search-result.mobile",
      "container#search-seo",
      // "flex-layout.row#banners-slider"
      "container#spacing-default"
      // "container#blog-cards",
      // "container#spacing-default"
    ],
    "props": {
      "showFacetQuantity": true
    }
  },
  "flex-layout.row#search-result-cluster-and-search": {
    "children": [
      "flex-layout.col#search-result-desktop-cluster-and-search"
    ],
    "props": {
      "blockClass": "search-result",
      "fullWidth": true
    }
  },
  "condition-layout.user#unlogged": {
    "props": {
      "conditions": [
        {
          "subject": "isAuthenticated",
          "arguments": {
            "value": true
          }
        }
      ],
      "Else": "container#unlogged"
    }
  },
  "container#unlogged": {
    "props": {
      "blockClass": "unlogged"
    }
  },
  "flex-layout.col#search-result-desktop-cluster-and-search": {
    "children": [
      // Linha inicial apos o banner ou header
      // "flex-layout.row#filters-container.desktop",
      // "flex-layout.row#wrapper_post-header-line.desktop", - Sendo renderizada em outra estrutura neste arquivo
      //

      // "flex-layout.row#fetch-less",
      "flex-layout.row#search-content.desktop"
      // "flex-layout.row#fetch-more"
    ],
    "props": {
      "blockClass": "search-result"
    }
  },
  "sunhouse.search-result:search-result-layout.desktop": {
    "title": "Search Desktop",
    "children": [
      "container#banner-department-desktop",
      // Esse componente precisara ser recriado do zero - acredito que seja mais pratico
      // "container#categories-slider",
      "container#plp-category-grid",
      //
      // "flex-layout.row#search-breadcrumb",
      "flex-layout.row#search-result.desktop",
      "container#search-seo",
      // "flex-layout.row#banners-slider",
      "container#spacing-default"
      // "container#blog-cards",
      // "container#spacing-default"
    ],
    "props": {
      "defaultGalleryLayout": "grid",
      "blockClass": "search-result",
      "pagination": "show-more",
      "preventRouteChange": true, // Impede recarregar a pagina quando filtros sao aplicados
      "showProductsCount": true,
      "showFacetQuantity": true,
      "hiddenFacets": {
        "specificationFilters": {
          "hiddenFilters": [{ "name": "Marca" }]
        }
      }
    }
  },

  // Esse componente precisara ser recriado do zero - acredito que seja mais pratico
  "container#categories-slider": {
    "title": "Carrossel de categorias",
    "children": [
      "flex-layout.row#categories-slider"
    ],
    "props": {
      "blockClass": "categories-slider",
      "shouldRender": false
    }
  },
  //

  "sunhouse.search-result:search-result-layout.mobile": {
    "title": "Search Mobile",
    "children": [
      "container#banner-department-mobile",
      "container#categories-slider",
      // "flex-layout.row#search-breadcrumb",
      "flex-layout.row#search-result.mobile",
      "container#search-seo",
      "container#spacing-default"
      // "container#blog-cards",
      // "container#spacing-default"
      // "flex-layout.row#banners-slider"
    ],
    "props": {
      "defaultGalleryLayout": "grid",
      "blockClass": "search-result",
      "pagination": "show-more",
      "showProductsCount": true,
      "showFacetQuantity": true,
      "hiddenFacets": {
        "specificationFilters": {
          "hiddenFilters": [{ "name": "Marca" }]
        }
      }
    }
  },
  "container#banner-department-mobile": {
    "title": "Banner Mobile - Mobile.",
    "children": ["image#department-banner-mobile"],
    "props": {
      "blockClass": "banner-department-mobile"
    }
  },
  "image#department-banner-mobile": {
    "props": {
      "alt": "banner-mobile",
      "title": "banner-mobile",
      "src": "assets/images/search/banner.png"
    }
  },
  "flex-layout.row#search-breadcrumb": {
    "children": ["breadcrumb.search#search-result"],
    "props": {
      "preserveLayoutOnMobile": true,
      "fullWidth": false,
      "blockClass": "search-breadcrumb"
    }
  },
  "flex-layout.row#search-result.desktop": {
    "children": [
      "flex-layout.col#search-result.desktop"
    ],
    "props": {
      "blockClass": "search-result",
      "fullWidth": true
    }
  },
  "flex-layout.col#search-result.desktop": {
    "children": [
      // Linha inicial apos o banner ou header
      // "flex-layout.row#filters-container.desktop",
      // "flex-layout.row#wrapper_post-header-line.desktop", - Sendo renderizada em outra estrutura neste arquivo
      //

      // "flex-layout.row#fetch-less",
      "flex-layout.row#search-content.desktop"
      // "flex-layout.row#fetch-more"
    ],
    "props": {
      "blockClass": "search-result"
    }
  },
  "flex-layout.row#search-result.mobile": {
    "children": [
      "flex-layout.col#search-result.mobile"
    ],
    "props": {
      "blockClass": "search-result"
    }
  },
  "flex-layout.col#search-result.mobile": {
    "children": [
      "flex-layout.row#filters-container.mobile",
      // "flex-layout.row#paged-controls-top", -> For Paged Controls
      "flex-layout.row#fetch-less",
      "flex-layout.row#search-content.mobile",
      // "flex-layout.row#paged-controls-bottom" -> For Paged Controls
      "flex-layout.row#fetch-more"
    ],
    "props": {
      "preserveLayoutOnMobile": true,
      "preventVerticalStretch": true,
      "fullWidth": true,
      "blockClass": "search-result-mobile"
    }
  },
  "flex-layout.row#filters-container.desktop": {
    "children": [
      // "sunhouse.search-result:search-products-count-per-page",
      "flex-layout.col#order-content"
    ],
    "props": {
      "preserveLayoutOnMobile": true,
      "colSizing": "auto",
      "horizontalAlign": "right",
      "blockClass": "filters-container"
    }
  },
  "flex-layout.row#filters-container.mobile": {
    "children": [
      "flex-layout.col#filters-container.mobile"
    ],
    "props": {
      "preserveLayoutOnMobile": true,
      "blockClass": "filters-container"
    }
  },
  "flex-layout.col#filters-container.mobile": {
    "children": [
      "flex-layout.row#filters-container-top.mobile",
      "flex-layout.row#filters-container-bottom.mobile"
    ],
    "props": {
      "blockClass": "filters-container"
    }
  },
  "flex-layout.row#filters-container-top.mobile": {
    "children": [
      "flex-layout.col#order-content"
    ],
    "props": {
      "preserveLayoutOnMobile": true,
      "marginBottom": 6,
      "colJustify": "between",
      "colSizing": "auto",
      "horizontalAlign": "center",
      "blockClass": ["filters-container-top", "filters-container-top-mobile"]
    }
  },
  "flex-layout.row#filters-container-bottom.mobile": {
    "children": [
      "sunhouse.search-result:search-products-count-per-page"
    ],
    "props": {
      "blockClass": "filters-container-bottom"
    }
  },
  
  "sunhouse.search-result:sidebar-close-button": {
    "props": {
      "type": "filled",
      "size": 18
    }
  },
  "flex-layout.col#order-content": {
    "children": ["sunhouse.search-result:order-by.v2"],
    "props": {
      "blockClass": "order-content",
      "verticalAlign": "middle",
      "preventVerticalStretch": true
    }
  },
  "sunhouse.search-result:order-by.v2": {
    "props": {
      "hiddenOptions": []
    }
  },
  "flex-layout.row#paged-controls-top": {
    "children": ["paged-controls"],
    "props": {
      "blockClass": "paged-controls-top",
      "preventHorizontalStretch": true,
      "horizontalAlign": "right",
      "fullWidth": false
    }
  },
  "flex-layout.row#paged-controls-bottom": {
    "children": [
      "paged-controls#bottom"
      // "flex-layout.row#fetch-more" -> Esse duplicava o botao de Ver Mais
    ],
    "props": {
      "blockClass": "paged-controls-bottom",
      "preventHorizontalStretch": true,
      "horizontalAlign": "center",
      "fullWidth": false
    }
  },
  "paged-controls": {
    "props": {
      "maxPageButtons": 4,
      "showLastPage": true,
      "showFirstPage": true,
      "PreviousPageIcon": "icon#prev-page",
      "NextPageIcon": "icon#next-page"
    }
  },
  "paged-controls#bottom": {
    "props": {
      "maxPageButtons": 4,
      "showLastPage": true,
      "showFirstPage": true,
      "PreviousPageIcon": "icon#prev-page",
      "NextPageIcon": "icon#next-page",
      "scrollToTop": "smooth"
    }
  },
  "icon#prev-page": {
    "props": {
      "id": "nav-caret--left",
      "size": 11,
      "activeClassName": "vtex-store-components-3-x-prevIcon"
    }
  },
  "icon#next-page": {
    "props": {
      "id": "nav-caret--right",
      "size": 11,
      "activeClassName": "vtex-store-components-3-x-nextIcon"
    }
  },
  // Botao Ver mais e Ver menos
  "flex-layout.row#fetch-more": {
    "children": [
      "sunhouse.search-result:search-fetch-more"
    ]
  },
  "flex-layout.row#fetch-less": {
    "children": [
      "sunhouse.search-result:search-fetch-previous"
    ]
  },
  "sunhouse.search-result:search-fetch-more": {
    "props": {
      "htmlElementForButton": "a"
    }
  },
  "sunhouse.search-result:search-fetch-previous": {
    "props": {
      "htmlElementForButton": "a"
    }
  },

  //
  "flex-layout.row#search-content.desktop": {
    "children": [
      "flex-layout.col#search-content.desktop",
			"flex-layout.col#filter-content.desktop"
    ],
    "props": {
      "blockClass": "search-content"
    }
  },
	"flex-layout.col#search-content.desktop": {
		"children": [
      "container#spacing-default",
      //
			"flex-layout.row#wrapper_post-header-line.desktop",
      "flex-layout.row#fetch-less",
      "hover-container#search-content-new-shelf",
      "flex-layout.row#fetch-more"
		],
		"props": {
			// "blockClass": "bf-search-content_col"
      "blockClass": ["search-content_col", "search-content_col-main"]
		}
	},
	"flex-layout.col#filter-content.desktop": {
		"children": [
      "container#spacing-default",
      //
			"vtex.search-result:filter-navigator.v3"
		],
		"props": {
      "width": "25%",
			"marginLeft": "5",
			// "blockClass": "bf-search-content_col"
      "blockClass": ["search-content_col", "search-content_col-filter"]
		}
	},
  //

  // Esse componente precisa ser removido apos a implementacao do novo search-result
  "hover-container#search-content": {
    "children": [
      // "sunhouse.search-result:search-content"
      "vtex.search-result:search-content#new-shelf"
    ],
    "props": {
      "blockClass": "hover-search-content"
    }
  },
  //

  "hover-container#search-content-new-shelf": {
		"title": "Lista de Produtos",
		"children": [
      "vtex.search-result:search-content#new-shelf"
		],
		"props": {
			"blockClass": "hover-search-content"
		}
	},

  "flex-layout.row#search-content.mobile": {
    "children": [
      "sunhouse.search-result:search-content"
    ],
    "props": {
      "blockClass": "search-content"
    }
  },
  // "sunhouse.search-result:search-content": {
  "vtex.search-result:search-content#new-shelf": {
    "blocks": [
      // "sunhouse.search-result:gallery",
      // "sunhouse.search-result:not-found"
      "vtex.search-result:gallery#new-shelf",
      "vtex.search-result:not-found#new-shelf"
    ]
  },

  // Esse precisa ser removido apos a implementacao do novo search-result
  "sunhouse.search-result:gallery": {
    "props": {
      "layouts": [
        {
          "name": "list",
          "component": "ListSummary",
          "itemsPerRow": 1
        },
        {
          "name": "grid",
          "component": "GridSummary",
          "itemsPerRow": {
            "desktop": 4,
            "tablet": 2,
            "mobile": 1
          }
        }
      ],
      "GridSummary": "product-summary.shelf#main-product-new",
      "ListSummary": "product-summary.shelf#main-product-new"
    }
  },
  //

  // Esse se mantem intacto
  "container#search-seo": {
    "children": [
      "rich-text#search-seo"
    ],
    "props": {
      "wrapper": true,
      "colSizing": "auto",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true,
      "horizontalAlign": "center",
      "blockClass": ["search-seo", "container-center"]
    }
  },
  "rich-text#search-seo": {
    "title": "Texto Seo",
    "props": {
      "text": "## Sun House - Ofertas Incríveis - Loja Física e Online \n Na Sun House Você Encontra Diversas Opções em Decoração, Cozinha, Mesa, Cama, e Muito Mais Encontre as melhores ofertas de Móveis e Ótimas condições de pagamento para você!",
      "blockClass": "search-seo",
      "textPosition": "CENTER"
    }
  }
}
