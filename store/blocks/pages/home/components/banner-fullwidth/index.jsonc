{
    "container#fullwidth-static-banner": {
        "children": [
            "info-card#banner-fullwidth"
        ],
        "props": {
            "blockClass": ["fullwidth-static-banner"]
        }
    },

    "info-card#banner-fullwidth": {
        "title": "Banner Estático",
        "props": {
            "isFullModeStyle": true,
			"textMode": "rich-text",
            
            // Esses deverao ser ajustados
            "textPosition": "center",
            "textAlignment": "center",
            //

            "headline": "# Titulo do Banner Fullwidth Estático",
            // "subhead": "## Subtítulo do banner",
            // "bodyText": "Lorem Ipsum is simply dummy text of the printing and typesetting.\nLorem Ipsum is simply dummy text of the.",
            "callToActionMode": "button",
            "callToActionText": "Conheça",
            "callToActionUrl": "/", // A ser definido pelo Site Editor
			"imageUrl": "https://sunhouse.vtexassets.com/assets/vtex.file-manager-graphql/images/0a74edaf-ba4c-4a14-87cf-f8662b531cda___9adbd1dac1bb2760cb724f63cd46a53e.jpg",
			"mobileImageUrl": "https://sunhouse.vtexassets.com/assets/vtex.file-manager-graphql/images/0a74edaf-ba4c-4a14-87cf-f8662b531cda___9adbd1dac1bb2760cb724f63cd46a53e.jpg",
            "imageAltText": "Texto ALT para SEO",
			"fetchpriority": "auto",
			"preload": true,
            "blockClass": ["main-banner", "main-banner-home", "banner-fullwidth"]
        }
    }
}
