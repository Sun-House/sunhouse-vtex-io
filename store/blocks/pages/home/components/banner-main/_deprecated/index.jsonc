{
  "list-context.image-list#banner-main": {
    "children": ["slider-layout#banner-main"],
    "title": "Banner Principal",
    "props": {
      "images": [
        {
          "image": "assets/images/main-banner.png",
          "mobileImage": "assets/images/main-banner-mobile.png",
          "description": "Banner Principal",
          "link": {
            "url": "/"
          },
          "title": "Banner Principal"
        },
        {
          "image": "assets/images/main-banner.png",
          "mobileImage": "assets/images/main-banner-mobile.png",

          "description": "Banner Principal",
          "link": {
            "url": "/"
          },
          "title": "Banner Principal"
        }
      ]
    }
  },

  "slider-layout#banner-main": {
    "props": {
      "itemsPerPage": 1,
      "infinite": true,
      "autoplay": {
        "timeout": 4000,
        "stopOnHover": true
      },
      "blockClass": ["banner", "banner-main"]
    }
  }
}
