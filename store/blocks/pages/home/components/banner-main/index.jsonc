{
    "slider-layout#banner-main-slider": {
        "title": "Configurações do Slider",
        "props": {
            "itemsPerPage": 1,
            "infinite": true,
            "autoplay": {
                "timeout": 6000,
                "stopOnHover": false
            },
            "blockClass": ["banner", "banner-main"]
        }
    }
}
