{
  "container#banner-infos": {
    "title": "Banner Informações",
    "props": {
      "blockClass": "banner-infos"
    },
    "children": ["rich-text#banner-infos", "image-text-list#banner-infos"]
  },

  "rich-text#banner-infos": {
    "title": "Titulo Banner Informações",
    "props": {
      "text": "## Dicas no Blog da Sun House \n\n Inspire-se com ideias criativas para deixar sua casa mais aconchegante",
      "blockClass": ["common-title", "banner-infos"]
    }
  },

  "image-text-list#banner-infos": {
    "title": "Banner Informações Lista",
    "children": [
      "responsive-layout.desktop#banner-infos",
      "responsive-layout.mobile#banner-infos"
    ],
    "props": {
      "blockClass": "banner-infos",
      // abaixo setei as imagens fixas - ja que nao terao alteracoes frequentes
      "imageTextArray": [
        {
          //"image": "assets/images/home/blog-1.png",
          "image": "assets/images/banner-infos/blog-1.png",
          "link": "https://blog.sunhouse.com.br/moveis-estilo-industrial/",
          "imageText": "Movéis estilo industrial: incorpore-os na sua decoração!",
          "target": "_blank"
        },
        {
          "image": "assets/images/banner-infos/blog-2.png",
          "link": "https://blog.sunhouse.com.br/8-inspiracoes-de-decoracao-para-a-sua-sala-de-estar/",
          "imageText": "8 Inspirações de decoração para a sua sala de estar!",
          "target": "_blank"
        },
        {
          "image": "assets/images/banner-infos/blog-3.png",
          "link": "https://blog.sunhouse.com.br/estilos-de-decoracao-para-se-inspirar/",
          "imageText": "Estilos de decoração: descubra 13 ideias para se inspirar",
          "target": "_blank"
        },
        {
          "image": "assets/images/banner-infos/blog-4.png",
          "link": "https://blog.sunhouse.com.br/palha-indiana/",
          "imageText": "Palha Indiana: conheça os detalhes deste acabamento único",
          "target": "_blank"
        }
      ]
    }
  },

  "responsive-layout.desktop#banner-infos": {
    "children": ["embla-carousel#banner-infos"]
  },
  "responsive-layout.mobile#banner-infos": {
    "children": ["embla-carousel#banner-infos-mobile"]
  },

  "embla-carousel#banner-infos": {
    "props": {
      "blockClass": "banner-infos",
      "options": {
        //"dots": true,
        // precis mudar pra true abaixo caso va ter mais de quatro elementos
        "navigation": false,
        "draggable": false,
        "forceLoop": false,
        "align": "start"
      }
    }
  },

  "embla-carousel#banner-infos-mobile": {
    "props": {
      "blockClass": "banner-infos",
      "options": {
        //"dots": true,
        "navigation": true,
        "loop": true,
        "draggable": true,
        "align": "start"
      }
    }
  }
}
