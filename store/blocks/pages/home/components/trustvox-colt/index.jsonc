{
    "flex-layout.row#trustvox-colt-highlight": {
        "title": "Carrossel Opiniões RA Trustvox",
        "children": [
            "flex-layout.col#trustvox-colt-highlight"
        ],
        "props": {
            "blockClass": "trustvox-colt-highlight"
        }
    },
    
    "flex-layout.col#trustvox-colt-highlight": {
        "children": [
            "flex-layout.row#trustvox-title-wrapper",
            "rich-text#trustvox-text",
            "colt-ratrustvox"
        ],
        "props": {
            "blockClass": "trustvox-colt-highlight"
        }
    },

    "flex-layout.row#trustvox-title-wrapper": {
        "children": [
            "icon#trustvox-text_icon",
            "rich-text#trustvox-title"
        ],
        "props": {
            "horizontalAlign": "center",
            "preventHorizontalStretch": true,
            "preserveLayoutOnMobile": true,
            "preventVerticalStretch": true,
            "marginBottom": 5,
            "marginTop": 3,
            "blockClass": "trustvox-title-wrapper"
        }
    },

    "icon#trustvox-text_icon": {
        "props": {
            "id": "inf-star-shine",
            "activeClassName": "vtex-store-components-3-x-inf-star-shine"
        }
    },
    "rich-text#trustvox-title": {
        "title": "Título - Carrossel RA",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "## Loja confiável",
            "blockClass": "trustvox-colt-highlight_text"
        }
    },
    "rich-text#trustvox-text": {
        "title": "Texto Abaixo - Carrossel RA",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "Avaliações reais auditadas pelo __Reclame AQUI__",
            "blockClass": "trustvox-colt-highlight_text"
        }
    }
}