    },
    "image#area-externa": {
        "title": "Imagem da Categoria 5",
        "props": {
            // "src": "https://dummyimage.com/500x600", // Mantive aqui para base
            "src": "https://sunhouse.vtexassets.com/assets/vtex.file-manager-graphql/images/e15f72de-c65d-49b3-9625-8206f5834e9f___f4e5b3ccda938800194e090c83a6dd51.png",
