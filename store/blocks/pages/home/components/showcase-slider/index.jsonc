    },
    "image#escritorio": {
        "title": "Imagem da Categoria 4",
        "props": {
            "src": "https://sunhouse.vtexassets.com/assets/vtex.file-manager-graphql/images/33a8309d-31d2-466b-8165-1f5d3263efd3___0e6e76cbd8e0c2d8d69b59b4b92d0c04.png",
            "link": {
                "url": "/moveis-por-ambiente/escritorio"
            },
