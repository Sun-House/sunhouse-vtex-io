{
	// Colar estrutura padrao criada para Categorias, utilizar a categoria Buffet (ou qualquer outra que tem o conteudo pronto) para testes, e validar o JSON-LD gerado no Rich Results Test do Google (ultimo TODO pendente do DEVELOPMENT_LOG)

	"container#faq-ld-disclosure_wrapper": { // Esse vai aonde precisa para testar, ele ja engloba o titulo e o container da FAQ
        "title": "FAQ - Perguntas Frequentes - IN DEV",
        "children": [
            "flex-layout.row#footer-faq-disclosure__title-row",  // Herdando o titulo ja existente em outro bloco/arquivo
            "container#faq-ld-disclosure"
        ],
        "props": {
			"blockClass": ["custom-block__container", "custom-block__wrapper-faq-disclosure", "category-faq"]
        }
    },

	// Bloco que gera a FAQ em si
	"container#faq-ld-disclosure": {
        "children": [
			"disclosure-ld-layout-group#faq-disclosure-lines"
        ],
        "props": {
            "blockClass": "custom-block__faq-disclosure"
        }
    },

	// Wrapper para as linhas da FAQ - apenas assim funcionará corretamente no Rich Results Test do Google pois gerará apenas uma tag script com o JSON-LD correto
	"disclosure-ld-layout-group#faq-disclosure-lines": {
		"title": "Conf. das Perguntas",
		"children": [
			"disclosure-ld-layout#faq-disclosure-line-1",
            "disclosure-ld-layout#faq-disclosure-line-2",
            "disclosure-ld-layout#faq-disclosure-line-3",
            "disclosure-ld-layout#faq-disclosure-line-4",
            "disclosure-ld-layout#faq-disclosure-line-5",
            "disclosure-ld-layout#faq-disclosure-line-6",
            "disclosure-ld-layout#faq-disclosure-line-7"
		]
	},

    // Lines Disclosures Declaration
    // Linha 1
    "disclosure-ld-layout#faq-disclosure-line-1": {
        "title": "Pergunta 1",
        "children": [
            "disclosure-ld-trigger#faq-disclosure-line-1",
            "disclosure-ld-content#faq-disclosure-line-1"
        ],
        "props": {
            "blockClass": "faq-disclosure-line",
            "initialVisibility": "hidden"
        }
    },
    "disclosure-ld-trigger#faq-disclosure-line-1": {
        "children": [
            "rich-text#faq-disclosure-line-1__title",
            "disclosure-ld-state-indicator#product-page-informations"
        ],
        "props": {
            "blockClass": "faq-disclosure-line"
        }
    },
    "rich-text#faq-disclosure-line-1__title": {
        "title": "Pergunta",
        "props": {
            "text": "## Título da pergunta 1 da FAQ - Máximo 1 linha",
            "blockClass": "faq-disclosure-line__title"
        }
    },
    "disclosure-ld-content#faq-disclosure-line-1": {
        "children": [
            "rich-text#faq-disclosure-line-1__text"
        ],
        "props": {
            "blockClass": "faq-disclosure-line"
        }
    },
    "rich-text#faq-disclosure-line-1__text": {
        "title": "Resposta",
        "props": {
            "text": "Nullam fermentum velit eget rhoncus rutrum. Aenean ut porta urna. Sed urna sapien, vulputate vitae convallis nec, lobortis nec erat. [Quisque](#) ac ipsum eu dui euismod porta in vitae augue. Pellentesque vel urna sed dui rutrum hendrerit nec non orci. \n \n Nunc vitae nunc purus. Nam tincidunt enim neque, quis ultrices felis convallis sit amet. Nullam dapibus laoreet venenatis. Vestibulum ullamcorper a massa vel convallis. Donec congue libero sed tortor varius tincidunt.",
            "blockClass": "faq-disclosure-line__text"
        }
    },

    // Linha 2
