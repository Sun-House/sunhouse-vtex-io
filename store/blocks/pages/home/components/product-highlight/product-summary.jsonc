{
    "product-summary.shelf#product-highlight": {
        "title": "Vitrine de Produto Destaque",
        "children": [
            "product-installments#new-shelf-installments", // Preço aqui
            "flex-layout.col#shelf-buy-button"
            
            // Novo esquema de botoes abaixo 
            // "flex-layout.row#product-highlight_cta-buttons"
        ],
        "props": {
            "blockClass": "main-shelf-new" // Pode ser necessario ajustar
        }
    },

    "flex-layout.row#product-highlight_cta-buttons": {
        "children": [
            "product-summary-name#product-highlight_open-product", // Botao para abrir o produto linkado
            "flex-layout.col#shelf-buy-button" // Botao de adicionar ao carrinho
        ],
        "props": {
            "blockClass": "cta-buttons"
        }
    },

    "product-summary-name#product-highlight_open-product": {
        "title": "Botão Abrir PDP",
        "props": {
            "showFieldsProps": {
                "showProductReference": false,
                "showBrandName": false,
                "showSku": false
            },
            "tag": "div",
            "blockClass": "product-highlight_open-product"
        }
    }
}
