{
    "container#fullwidth-banner-shelf": {
        "title": "Prateleira Fullwidth - Home",
        "children": [
            "info-card#banner-fullwidth-shelf",
            "list-context.product-list#home-shelf-full"
        ],
        "props": {
            "blockClass": ["fullwidth-banner-shelf"]
        }
    },

    "info-card#banner-fullwidth-shelf": {
        "title": "Banner Estático com Prateleira",
        "props": {
            "isFullModeStyle": true,
            "callToActionMode": "none",
			"imageUrl": "https://sunhouse.vtexassets.com/assets/vtex.file-manager-graphql/images/90d5e709-7ebb-40a0-aa7b-d6f59dc6cd2e___340f2e28353ab3e07bf51dbfcada08c4.png",
			"mobileImageUrl": "https://sunhouse.vtexassets.com/assets/vtex.file-manager-graphql/images/90d5e709-7ebb-40a0-aa7b-d6f59dc6cd2e___340f2e28353ab3e07bf51dbfcada08c4.png",
            "imageAltText": "Texto ALT para SEO",
			"fetchpriority": "auto",
			"preload": true,
            "blockClass": ["main-banner", "main-banner-home", "banner-fullwidth-shelf"]
        }
    }
}
