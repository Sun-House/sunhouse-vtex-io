    //     "props": {
    //         "blockClass": "stores-landing-form"
    //     }
    // },
    // "custom-form#form-test": {
    //     "props": {
    //         "blockClass": "form-test"
    //     }
    // },

    // Bloco de formulario - in DEV **Testes**
    //

    
    // Page Pre-Footer
    "container#stores-landing-pre-footer": {
        "title": "Page Pre-Footer",
        "children": [
            // Ideal bloco do instagram, mas pelo nivel de complexidade, será implementado posteriormente
            // Por hora ficara o bloco de Showcase Slider
            "container#showcase-slider"
        ]
    }
}
