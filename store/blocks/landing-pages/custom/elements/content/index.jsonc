    // Wide-Block - "Titulo2" + "Subtitulo" + "Button" + "Video"
    "container#lp-video-highlight": {
        "title": "",
        "children": [
            "rich-text#lp-video-highlight",
            "video#lp-video-highlight-video"
        ],
        "props": {
            "blockClass": "lp-video-highlight"
        }
    },
    // texto flutuante sobre o video
    "rich-text#lp-video-highlight": {
        "title": "Texto",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "## Título 2 - Estilizado \n ## Subtitulo \n [Botão](#)",
            "blockClass": ["lp_text-block", "lp_text", "lp_title-2", "lp_subtitulo", "lp-video-highlight"]
        }
    },
    // video playback sem controles
    "video#lp-video-highlight-video": {
        "props": {
            "name": "", // SEO and accessibility
            "description": "", // SEO and accessibility
            "poster": "", // Imagem que vai sobrepor o video -> nesse caso nao sei se vai precisar
            "controlsType": "none",
            "width": "100%",
            "height": "684px",
            "loop": true,
            "autoPlay": true,
            "playsInline": true,
            "muted": true,
            "src": "https://www.youtube.com/watch?v=U_TsfCE3d2M",
            "blockClass": "lp-video-highlight"
        }
    },

    // Grow-Block - "Titulo2" + "Subtitulo" + "Text-Block" + "Imagem destaque" + "Button"
    "container#lp_grow-block-image-highlight": {
        "title": "",
        "children": [
            "rich-text#lp_grow-block-image-highlight-text",
