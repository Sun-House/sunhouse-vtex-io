    "list-context.image-list#lp_grow-block-image-highlight-image": {
        "props": {
            "images": [{
                "image": "https://dummyimage.com/1410x1132",
                "mobileImage": "https://dummyimage.com/360x640" // Ver resolucao mobile
            }],
            "blockClass": ["lp_image", "lp_grow-block-image-highlight-image"]
        },
        "children": [
