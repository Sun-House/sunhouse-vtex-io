    "list-context.image-list#lp_grow-block-image-highlight-image": {
        "title": "Imagem Única",
        "props": {
            "images": [{
                "image": "https://dummyimage.com/1220x979",
                "mobileImage": "https://dummyimage.com/360x640" // Ver resolucao mobile
            }],
            "blockClass": ["lp_image", "lp_grow-block-image-highlight-image"]
        },
        "children": [
            "container.list-render#lp_grow-block-image-highlight-image"
        ]
    },
    "container.list-render#lp_grow-block-image-highlight-image": {
        "props": {
            "blockClass": ["lp_image", "lp_grow-block-image-highlight-image"]
        }
    },
    "rich-text#lp_grow-block-image-highlight-button": {
        "title": "Botão CTA",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "[Botão](#)",
            "blockClass": ["lp_button", "lp_grow-block-image-highlight-button"]
        }
    },
    
