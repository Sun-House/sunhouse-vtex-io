        }
    },
    // text
    "rich-text#lp_footer-highlight_text": {
        "title": "Texto",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "## Título H2 \n ### Título H3 \n Breve texto explicativo de até três linhas (mas ideal manter até duas linhas de conteúdo).",
