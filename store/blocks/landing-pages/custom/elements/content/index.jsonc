        }
    },
    // video com controles
    "video#lp_footer-highlight_video": {
        "props": {
            "name": "", // SEO and accessibility
            "description": "", // SEO and accessibility
            "poster": "", // Imagem que vai sobrepor o video
            "controlsType": "custom-vtex",
            "width": "960px",
            "height": "540px",
            "loop": false,
            "autoPlay": false,
            "playsInline": true,
            "muted": false,
