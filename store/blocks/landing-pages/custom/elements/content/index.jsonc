        }
    },
    "flex-layout.col#lp-wrapper-row-5": {
        "title": "",
        "children": [
            "container#lp_footer-highlight"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.col#lp-wrapper-row-6": {
        "title": "",
        "children": [
            "rich-text#lp_footer-highlight_text-highlight"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    
    // Blocos:

    // Block-Banner-Full - "Imagem única - tela inteira"
    "container#lp-banner-hero": {
        "title": "Bloco Banner Tela Completa",
        "children": [
            "list-context.image-list#lp-banner-hero"
        ],
        "props": {
            "blockClass": "lp-banner-hero"
        }
    },
    "list-context.image-list#lp-banner-hero": {
        "props": {
            "images": [{
                "image": "https://dummyimage.com/1920x710",
                "mobileImage": "https://dummyimage.com/360x640" // validar resolucao mobile
            }],
            //"blockClass": "banner-fulfill"
            "blockClass": ["lp_image", "lp-banner-hero"]
        },
        "children": [
            "container.list-render#lp-banner-hero"
        ]
    },
    "container.list-render#lp-banner-hero": {
        "props": {
            //"blockClass": ["custom-description-banner", "banner-fulfill"]
            "blockClass": ["lp_image", "lp-banner-hero"]
        }
    },

    // Grid-Block - "Text-Block" + "Titulo" + "Grid-5"
    "container#lp_grid-cadeiras": {
        "title": "Grid Cadeiras Destaque",
        "children": [
            "rich-text#lp_grid-cadeiras-text",
            "slider-layout#lp_grid-cadeiras"
        ],
        "props": {
            "blockClass": "lp_grid-cadeiras"
        }
    },
    "rich-text#lp_grid-cadeiras-text": {
        "title": "Texto",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "## Título 1 Padrão \n ## Título 2 - Estilizado \n Texto subtítulo, ou breve texto explicativo de até três linhas (mas ideal manter até duas linhas de conteúdo).",
            "blockClass": ["lp_text-block", "lp_text", "lp_title-1"]
        }
    },
    
    // Bloco Grid de Imagens
    // Slider
    "slider-layout#lp_grid-cadeiras": {
        "title": "",
        "props": {
            "itemsPerPage": {
                "desktop": 5,
                "phone": 2
            },
            "showNavigationArrows": "desktopOnly",
            "dots": true,
            "infinite": true,
            "blockClass": "lp_grid-slider"
        },
        "children": [
            "flex-layout.col#grid-cadeiras_col-1",
            "flex-layout.col#grid-cadeiras_col-2",
            "flex-layout.col#grid-cadeiras_col-3",
            "flex-layout.col#grid-cadeiras_col-4",
            "flex-layout.col#grid-cadeiras_col-5"
        ]
    },
    // Colunas
    // Col-1
    "flex-layout.col#grid-cadeiras_col-1": {
        "children": [
            "list-context.image-list#grid-cadeiras_col-1",
            "rich-text#grid-cadeiras_col-1"
        ],
        "props": {
            "blockClass": "lp_grid_col"
        }
    },
    "list-context.image-list#grid-cadeiras_col-1": {
        "title": "",
        "props": {
            "images": [{
                "image": "https://dummyimage.com/254x343"
                //,"mobileImage": "https://dummyimage.com/383x255"
            }],
            "blockClass": ["lp_image"]
        },
        "children": ["container.list-render#grid-cadeiras_col-1"]
    },
    "container.list-render#grid-cadeiras_col-1": {
        "props": {
            "blockClass": ["lp_image"]
        }
    },
    "rich-text#grid-cadeiras_col-1": {
        "title": "",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "### CATEGORIA",
