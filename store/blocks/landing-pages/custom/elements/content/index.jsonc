{
    // Wrapper Linhas Full Body
    "flex-layout.row#lp_wrapper-row-1": {
        "title": "",
        "children": [
            "flex-layout.col#lp_wrapper-row-1"
        ],
        "props": {
            "blockClass": ["full-body", "wrapper-row"]
        }
    },
    "flex-layout.row#lp_wrapper-row-2": {
        "title": "",
        "children": [
            "flex-layout.col#lp_wrapper-row-2"
        ],
        "props": {
            "blockClass": ["full-body", "wrapper-row"]
        }
    },
    "flex-layout.row#lp_wrapper-row-3": {
        "title": "",
        "children": [
            "flex-layout.col#lp_wrapper-row-3"
        ],
        "props": {
            "blockClass": ["full-body", "wrapper-row"]
        }
    },
    "flex-layout.row#lp_wrapper-row-4": {
        "title": "",
        "children": [
            "flex-layout.col#lp_wrapper-row-4"
        ],
        "props": {
            "blockClass": ["full-body", "background-line"]
        }
    },
    "flex-layout.row#lp_wrapper-row-5": {
        "title": "",
        "children": [
            "flex-layout.col#lp_wrapper-row-5"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.row#lp_wrapper-row-6": {
        "title": "",
        "children": [
            "flex-layout.col#lp_wrapper-row-6"
        ],
        "props": {
            "blockClass": ["full-body", "footer-line"]
        }
    },

    // Wrapper Colunas Full Body
    "flex-layout.col#lp_wrapper-row-1": {
        "title": "",
        "children": [
            "container#lp_grid-cadeiras"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.col#lp_wrapper-row-2": {
        "title": "",
        "children": [
            "container#lp_grow-block-image-highlight"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.col#lp_wrapper-row-3": {
        "title": "",
        "children": [
            "container#lp_grow-block-mosaic"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.col#lp_wrapper-row-4": {
        "title": "",
        "children": [
            "container#lp_grid-category"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.col#lp_wrapper-row-5": {
        "title": "",
        "children": [
            "container#lp_footer-highlight"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.col#lp_wrapper-row-6": {
        "title": "",
        "children": [
            "list-context.image-list#lp_footer-highlight_icon",
            "rich-text#lp_footer-highlight_text-highlight"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    

    // Blocos:

    // Block-Banner-Full - "Imagem única - tela inteira"
    "container#lp_banner-hero": {
        "title": "Bloco Banner Tela Completa",
        "children": [
            "list-context.image-list#lp_banner-hero"
        ],
        "props": {
            "blockClass": "lp_banner-hero"
        }
    },
    "list-context.image-list#lp_banner-hero": {
        "props": {
            "images": [{
                "image": "https://dummyimage.com/1920x710",
                "mobileImage": "https://dummyimage.com/360x640" // validar resolucao mobile
            }],
            //"blockClass": "banner-fulfill"
            "blockClass": ["lp_image", "lp_banner-hero"]
        },
        "children": [
            "container.list-render#lp_banner-hero"
        ]
    },
    "container.list-render#lp_banner-hero": {
        "props": {
            "blockClass": ["lp_image", "lp_banner-hero"]
        }
    },

    // Grid-Block - "Text-Block" + "Titulo" + "Grid-5"
    "container#lp_grid-cadeiras": {
        "title": "Grid Cadeiras Destaque",
        "children": [
            "rich-text#lp_grid-cadeiras_text",
            "flex-layout.row#lp_grid-cadeiras"
        ],
        "props": {
            "blockClass": "lp_grid-cadeiras"
        }
    },
    "rich-text#lp_grid-cadeiras_text": {
        "title": "Texto",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "# Título H1 \n breve texto explicativo de até três linhas (mas ideal manter até duas linhas de conteúdo). \n ## Título H2",
            "blockClass": ["lp_text-block", "lp_grid-cadeiras_text"]
        }
    },
    
    // Bloco Grid de Imagens
    "flex-layout.row#lp_grid-cadeiras": {
        "title": "",
        "children": [
            "flex-layout.col#lp_grid-cadeiras"
        ],
        "props": {
            "colSizing": "equal",
            "preventVerticalStretch": true,
            "blockClass": "lp_grid"
        }
    },
    "flex-layout.col#lp_grid-cadeiras": {
        "title": "",
        "children": [
            "image-text-list#lp_grid-cadeiras_images"
        ],
        "props": {
            "width": "grow",
            "blockClass": "lp_grid"
        }
    },

    "image-text-list#lp_grid-cadeiras_images": {
        "children": [
            "embla-carousel#lp_grid-cadeiras_carousel"
        ],
        "props": {
            "imageTextArray": [{
                    "imageText": "Categoria",
                    "image": "https://dummyimage.com/223x300",
                    "link": "#"
                },
                {
                    "imageText": "Categoria",
                    "image": "https://dummyimage.com/223x300",
                    "link": "#"
                },
                {
                    "imageText": "Categoria",
                    "image": "https://dummyimage.com/223x300",
                    "link": "#"
                },
                {
                    "imageText": "Categoria",
                    "image": "https://dummyimage.com/223x300",
                    "link": "#"
                },
                {
                    "imageText": "Categoria",
                    "image": "https://dummyimage.com/223x300",
                    "link": "#"
                }
            ],
            "blockClass": "lp_grid_images"
        }
    },
    "embla-carousel#lp_grid-cadeiras_carousel": {
        "props": {
            "options": {
                "navigation": false,
                "dots": false,
                "draggable": true,
                "loop": false,
                "align": "center"
            },
            "blockClass": "lp_grid_carousel"
        }
    },
    
    // Bloco Grid de Mais Vendidas
    "container#lp_most-selling": {
        "title": "",
        "children": [
            "rich-text#lp_most-selling-title",
            "list-context.image-list#lp_most-selling-images"
        ],
        "props": {
            "blockClass": "lp_most-selling"
        }
    },
    "rich-text#lp_most-selling-title": {
        "title": "Texto",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "## Título H2",
            "blockClass": ["lp_most-selling-title"]
        }
    },
    "list-context.image-list#lp_most-selling-images": {
        "title": "",
        "children": [
            "container.list-render#lp_most-selling-images"
        ],
        "props": {
            "images": [{
                    "image": "https://dummyimage.com/596x821",
                    "mobileImage": "", // validar medida mobile
                    "link": {
                        "url": "#"
                    }
                },
                {
                    "image": "https://dummyimage.com/596x396",
                    "mobileImage": "", // validar medida mobile
                    "link": {
                        "url": "#"
                    }
                },
                {
                    "image": "https://dummyimage.com/596x396",
                    "mobileImage": "", // validar medida mobile
                    "link": {
                        "url": "#"
                    }
                }
            ]
        }
    },
    "container.list-render#lp_most-selling-images": {
        "props": {
            "blockClass": ["lp_image", "lp_banners-grid", "lp_mais-vendidas-images"],
            "wrapper": true
        }
    },

    // Wide-Block - "Titulo2" + "Subtitulo" + "Button" + "Video"
    "container#lp_video-highlight": {
        "title": "",
        "children": [
            "rich-text#lp_video-highlight_text",
            "video#lp_video-highlight-video"
        ],
        "props": {
            "blockClass": "lp_video-highlight"
        }
    },
    // texto flutuante sobre o video
    "rich-text#lp_video-highlight_text": {
        "title": "Texto",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "## Título H2 \n ### Subtitulo H3 \n [Botão](#)",
            "blockClass": ["lp_text-block", "lp_button", "lp_video-highlight_text"]
        }
    },
    // video playback sem controles
    "video#lp_video-highlight-video": {
        "props": {
            "name": "", // SEO and accessibility
            "description": "", // SEO and accessibility
            "poster": "", // Imagem que vai sobrepor o video -> nesse caso nao sei se vai precisar
            "controlsType": "none",
            "width": "100%",
            "height": "684px",
            "loop": true,
            "autoPlay": true,
            "playsInline": true,
            "muted": true,
            "src": "https://www.youtube.com/watch?v=U_TsfCE3d2M",
            "blockClass": "lp_video-highlight"
        }
    },

    // Grow-Block - "Titulo2" + "Subtitulo" + "Text-Block" + "Imagem destaque" + "Button"
    "container#lp_grow-block-image-highlight": {
        "title": "",
        "children": [
            "rich-text#lp_grow-block-image-highlight_text",
            "list-context.image-list#lp_grow-block-image-highlight-image",
            "rich-text#lp_grow-block-image-highlight-button"
        ],
        "props": {
            "blockClass": "lp_grow-block-image-highlight"
        }
    },
    "rich-text#lp_grow-block-image-highlight_text": {
        "title": "Texto",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "## Título H2 \n ### Subtitulo H3 \n Breve texto explicativo de até três linhas (mas ideal manter até duas linhas de conteúdo).",
            "blockClass": ["lp_text-block", "lp_grow-block-image-highlight_text"]
        }
    },
    "list-context.image-list#lp_grow-block-image-highlight-image": {
        "props": {
            "images": [{
                "image": "https://dummyimage.com/1220x979",
                "mobileImage": "https://dummyimage.com/360x640" // Ver resolucao mobile
            }],
            "blockClass": ["lp_image", "lp_grow-block-image-highlight-image"]
        },
        "children": [
            "container.list-render#lp_grow-block-image-highlight-image"
        ]
    },
    "container.list-render#lp_grow-block-image-highlight-image": {
        "props": {
            "blockClass": ["lp_image", "lp_grow-block-image-highlight-image"]
        }
    },
    "rich-text#lp_grow-block-image-highlight-button": {
        "title": "Botão",
        "props": {
            "textAlignment": "CENTER",
            "textPosition": "CENTER",
            "text": "[Botão](#)",
            "blockClass": ["lp_button", "lp_grow-block-image-highlight-button"]
        }
    },
    
