{
    // Wrapper Linhas Full Body
    "flex-layout.row#lp-wrapper-row-1": {
        "title": "",
        "children": [
            "flex-layout.col#lp-wrapper-row-1"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.row#lp-wrapper-row-2": {
        "title": "",
        "children": [
            "flex-layout.col#lp-wrapper-row-2"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.row#lp-wrapper-row-3": {
        "title": "",
        "children": [
            "flex-layout.col#lp-wrapper-row-3"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.row#lp-wrapper-row-4": {
        "title": "",
        "children": [
            "flex-layout.col#lp-wrapper-row-4"
        ],
        "props": {
            "blockClass": ["full-body", "background-line"]
        }
    },
    "flex-layout.row#lp-wrapper-row-5": {
        "title": "",
        "children": [
            "flex-layout.col#lp-wrapper-row-5"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.row#lp-wrapper-row-6": {
        "title": "",
        "children": [
            "flex-layout.col#lp-wrapper-row-6"
        ],
        "props": {
            "blockClass": ["full-body", "footer-line"]
        }
    },

    // Wrapper Colunas Full Body
    "flex-layout.col#lp-wrapper-row-1": {
        "title": "",
        "children": [
            "container#lp_grid-cadeiras"
        ],
        "props": {
            "blockClass": "full-body"
        }
    },
    "flex-layout.col#lp-wrapper-row-2": {
        "title": "",
        "children": [
            "container#lp_grow-block-image-highlight"
        ],
        "props": {
            "blockClass": "full-body"
