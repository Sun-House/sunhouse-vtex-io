{
	"product-summary.shelf#black-friday": {
		"children": [
			"stack-layout#bf-shelf-product-image",
            "container#product-highlights",
			"product-summary-name#bf-shelf",
            "condition-layout.product#bf-shelf-product-availability"
		],
		"props": {
			"blockClass": "black-friday"
		}
	},

    "condition-layout.product#bf-shelf-product-availability": {
        "props": {
            "conditions": [
                {
                "subject": "isProductAvailable"
                }
            ],
            "Then": "flex-layout.col#bf-shelf-product-available",
            "Else": "flex-layout.col#shelf-product-unavailable"
        }
    },

    "flex-layout.col#bf-shelf-product-available": {
        "title": "Produto Vitrine Disponível - BF",
        "children": [
            "container#bf-price-block"
        ],
        "props": {
            "blockClass": ["shelf-product-available", "bf-shelf-product-available"]
        }
    },
    
    "container#bf-price-block": {
        "title": "Price Block Wrapper - Vitrine",
        "children": [
            "product-list-price#bf-shelf",
			"discount-price#bf-shelf"
        ],
        "props": {
            "wrapper": "true",
            "blockClass": "bf_price-block"
        }
    },

    "product-summary-name#bf-shelf": {
        "props": {
            "blockClass": ["main-shelf", "bf-shelf"]
        }
    },

    // Bloco da foto do produto
    "stack-layout#bf-shelf-product-image": {
        "title": "Imagem do Produto - Shelf Black Friday",
        "children": [
            "container#bf-image-shelf",
            "add-to-list-btn#main-shelf"
        ],
        "props": {
            "blockClass": ["shelf-product-image", "bf_shelf-product-image"]
        }
    },

	// Bloco que renderiza o preço cheio do produto riscado - Preço "DE:"
	"product-list-price#bf-shelf": {
		"title": "Preço de lista produto vitrine",
		"props": {
            "hideWithoutDiscount": false,
			"message": "{listPriceValue}",
			"blockClass": ["product-shelf-price", "bf-list-price-shelf"]
		}
	},

	// Bloco que renderiza o preço a vista no pix - Preço "POR:" 1 - Padrao
	"discount-price#bf-shelf": {
		"props": {
			"hideWithoutDiscount": false,
			"message": "{priceValue} PIX",
			// "promotionName": "Desconto Pagamento à Vista (7%)",
			"promotionName": "Desconto Pagamento a Vista (10%)",
			"blockClass": ["lp_pix-price-shelf", "bf-shelf"]
		}
	},

	// [INATIVO] Bloco que renderiza o preço parcelado - Preço "POR:" 2 - Mostra apenas quando o preço a vista nao renderiza
	"product-selling-price#bf-shelf": {
		"title": "Preço (com preço de lista) produto vitrine",
		"props": {
			"message": "<bold>{sellingPriceValue}</bold>",
			"markers": ["bold"],
			"blockClass": "product-shelf-price"
		}
	},

	// [INATIVO] Bloco que renderiza o preço parcelado com parcelas e informacoes do parcelamento - Complemento de Preço
	"product-installments#shelf-installments": {
		"props": {
			"markers": ["bold"],
			"message": "Ou <bold>{installmentsTotalValue}</bold> em até <bold>{installmentsNumber}x</bold> de <bold>{installmentValue}</bold> sem juros no cartão de crédito",
			"installmentsCriteria": "max-quantity-without-interest",
			"blockClass": "shelf-installments"
		}
	},

    "container#bf-image-shelf": {
        "children": [
            "product-summary-image#black-friday",
            "container#product-sku-variation"
        ],
        "props": {
            "blockClass": ["image-shelf", "bf_image-shelf"]
        }
    },

    "product-summary-image#black-friday": {
        "title": "Imagem do Produto - Vitrine",
        "props": {
            "aspectRatio": "1:1",
            "width": 294,
            "height": 294,
            "hoverImage": {
                "criteria": "index",
                "index": 1
            },
            "blockClass": "bf_main-shelf"
        }
    }
}
