{
  // Shelf antiga - Sera descontinuada no Refresh
  "product-summary.shelf#main-product": {
    "title": "Produto vitrine",
    "children": [
      "stack-layout#shelf-product-image",
      "container#product-highlights",
      // "flex-layout.row#countdown-product-timer",
      // "container#shelf-specification-badges",
      // "container#shelf-reviews",
      "product-summary-name",
      // "condition-layout.product#shelf-product-availability"
      "condition-layout.product#shelf-elf-checker"
    ],
    "props": {
      "blockClass": "main-shelf"
    }
  },
  
  // Shelf nova - Padrao para o Refresh
  "product-summary.shelf#main-product-new": {
    "title": "Vitrine de Produtos",
		"children": [
			"stack-layout#new-shelf-product-image",
      // Versão MVP - Precisara ser melhorada posteriormente:
      "flex-layout.row#shelf-enhanced-sku-selector",
      "flex-layout.col#hover-block-wrapper"
		],
		"props": {
			"blockClass": "main-shelf-new"
		}
	},

  "flex-layout.col#hover-block-wrapper": {
    "children": [
      "product-summary-name#new-shelf",
      "condition-layout.product#shelf-elf-checker"
    ],
    "props": {
      "blockClass": "hover-block-wrapper"
    }
  },

  "flex-layout.row#shelf-enhanced-sku-selector": {
    "children": [
      "shelf-enhanced-sku-selector#default-shelf"
    ],
    "props": {
      "blockClass": "shelf-enhanced-sku-selector"
    }
  },

  // Shelf Enhanced SKU Selector - pronto para o MVP do Refresh
  "shelf-enhanced-sku-selector#default-shelf": {
    "props": {
      "maxItems": 8,
      "imageWidth": 30,
      "imageHeight": 30
    }
  },

  // Bloco da foto do produto
  "stack-layout#new-shelf-product-image": {
      "title": "Imagem do Produto - Shelf New",
      "children": [
          "container#image-shelf-new",
          "add-to-list-btn#main-shelf"
      ],
      "props": {
          "blockClass": ["shelf-product-image", "shelf-new-product-image"]
      }
  },

  "container#image-shelf-new": {
      "children": [
          "product-summary-image#new-shelf"
      ],
      "props": {
          "blockClass": ["image-shelf", "bf_image-shelf"]
      }
  },
  "product-summary-image#new-shelf": {
      "title": "Imagem do Produto - Vitrine",
      "props": {
          // "aspectRatio": "1:1",
          "aspectRatio": "13:16", // Apliquei via css, mas validar se nao é melhor usar aqui direto e remover o css
          // "width": 294,
          // "height": 294,
          "width": 368, // Pode ser necessario ajustar isso para outras prateleiras - Esse é o ajuste ideal para a prateleira grid (maior imagem de prateleira do site)
          "height": 424, // Pode ser necessario ajustar isso para outras prateleiras - Esse é o ajuste ideal para a prateleira grid (maior imagem de prateleira do site)
          "hoverImage": {
              "criteria": "index",
              "index": 1
          },
          "blockClass": "new_main-shelf"
      }
  },

  "product-summary-name#new-shelf": {
      "props": {
          "blockClass": "new-shelf"
      }
  },

  // Shelf Black Friday - Sera descontinuada no Refresh - Manter para backup
  "product-summary.shelf#bf-main-product": {
    "title": "Vitrine de Produtos",
		"children": [
			"stack-layout#bf-shelf-product-image",

      // Shelf SKU Selector
      // "product-summary-sku-selector#default-shelf",
      // "shelf-enhanced-sku-selector#default-shelf",
      "flex-layout.row#shelf-enhanced-sku-selector",
      //

      "container#product-highlights",
			"product-summary-name#bf-shelf",
      "condition-layout.product#shelf-elf-checker"
		],
		"props": {
			"blockClass": ["black-friday", "main-shelf-new"]
		}
	},

  "product-summary-sku-selector#default": {
    "props":{
      "showVariationsLabels": ["false"],
      "displayMode": "slider",
      "sliderDisplayThreshold": 5
    }
  },

  // VALIDAR - ESSE COMPONENTE ESTA SENDO USADO?
  "product-summary-sku-selector#default-shelf": {
    "props":{
      "displayMode": "slider",
      "sliderArrowSize": 10,
      "sliderDisplayThreshold": 1,
      "sliderItemsPerPage": {
        "desktop": 6,
        "phone": 4
      },
			"hideImpossibleCombinations": false,
			"visibility": "always",
			"initialSelection": "empty",
			"showVariationsErrorMessage": true, // Nao entendi o funcionamento — nao esta funcionando a principio
			"showVariationsLabels": ["none"],
			"thumbnailImage": "tampo",
			"imageHeight": {
        "desktop": 5,
        "phone": 5
      },
			"imageWidth": {
        "desktop": 5,
        "phone": 5
      },
			"visibleVariations": [
				// "Medida",
				"Tampo (acabamento)"
				// "Base (acabamento)"
			],

			"blockClass": "sku-selector_default-shelf"
    }
  },
  //

  "product-summary-name": {
    "props": {
      "blockClass": "main-shelf"
    }
  },

  "stack-layout#shelf-product-image": {
    "title": "Imagem do produto vitrine",
    "children": [
      "container#image-shelf",
      "add-to-list-btn#main-shelf"
    ],
    "props": {
      "blockClass": "shelf-product-image"
    }
  },

  "add-to-list-btn#main-shelf": {
    "title": "Botão adicionar a lista de desejos",
    "props": {
      "blockClass": ["main-shelf", "add-to-list-btn"]
    }
  },

  "container#image-shelf": {
    "children": [
      "product-summary-image",
      "container#product-sku-variation"
    ],
    "props": {
      "blockClass": "image-shelf"
    }
  },

  "product-summary-image": {
    "title": "Imagem do produto vitrine",
    "props": {
      "aspectRatio": "1:1",
      "width": 294,
      "height": 294,
      "hoverImage": {
        "criteria": "index",
        "index": 1
      },
      "blockClass": "main-shelf"
    }
  },

  "container#shelf-specification-badges": {
    "children": ["condition-layout.user#shelf-specification-badges"],
    "props": {
      "blockClass": "shelf-specification-badges"
    }
  },

  "condition-layout.user#shelf-specification-badges": {
    "props": {
      "conditions": [
        {
          "subject": "isAuthenticated",
          "arguments": {
            "value": true
          }
        }
      ],
      "Then": "product-specification-badges#selo"
    }
  },

  "condition-layout.product#shelf-elf-checker": {
    "title": "Condicional - Status Produto",
    "props": {
      "conditions": [
        {
          "subject": "productClusters",
          "arguments": {
            "id": "427"
          }
        }
      ],
      "Then": "flex-layout.col#shelf-product-exclusive",
      "Else": "condition-layout.product#shelf-corporate-checker"
    }
  },

  "condition-layout.product#shelf-corporate-checker": {
    "title": "Condicional - Status Produto",
    "props": {
      "conditions": [
        {
          "subject": "productClusters",
          "arguments": {
            "id": "443"
          }
        }
      ],
      "Then": "flex-layout.col#shelf-product-corporate",
      "Else": "condition-layout.product#shelf-product-availability"
    }
  },

  "condition-layout.product#shelf-product-availability": {
    "props": {
      "conditions": [
        {
          "subject": "isProductAvailable"
        }
      ],
      "Then": "flex-layout.col#shelf-product-available",
      "Else": "flex-layout.col#shelf-product-unavailable"
    }
  },
  
  "flex-layout.col#shelf-product-exclusive": {
    "title": "Produto Vitrine - Exclusivo",
    "children": [
      "rich-text#shelf-product-exclusive-button",
      "rich-text#shelf-product-exclusive-cta"
    ],
    "props": {
      "preventVerticalStretch": true,
      "verticalAlign": "top",
      "blockClass": "shelf-product-exclusive"
    }
  },

  "rich-text#shelf-product-exclusive-button": {
    "title": "Texto Produto Exclusivo - Vitrine",
    "props": {
      "text": "__Produto Exclusivo__",
      "blockClass": ["shelf-product-info-text", "shelf-product-exclusive-button"]
    }
  },

  "rich-text#shelf-product-exclusive-cta": {
    "title": "CTA Produto Exclusivo - Vitrine",
    "props": {
      "text": "__Venda Exclusiva • Saiba Mais__",
      "blockClass": "shelf-product-exclusive-cta"
    }
  },

  "flex-layout.col#shelf-product-corporate": {
    "title": "Produto Vitrine - Corporativo",
    "children": [
      "rich-text#shelf-product-corporate-button",
      "rich-text#shelf-product-corporate-cta"
    ],
    "props": {
      "preventVerticalStretch": true,
      "verticalAlign": "top",
      "blockClass": "shelf-product-exclusive"
    }
  },

  "rich-text#shelf-product-corporate-button": {
    "title": "Texto Produto Corporativo - Vitrine",
    "props": {
      "text": "__Preço Sob Consulta__",
      "blockClass": ["shelf-product-info-text", "shelf-product-corporate-button"]
    }
  },

  "rich-text#shelf-product-corporate-cta": {
    "title": "CTA Produto Corporativo - Vitrine",
    "props": {
      "text": "__Solicitar Orçamento__",
      "blockClass": "shelf-product-corporate-cta"
    }
  },
  
  // Nao esta sendo usado
  "rich-text#know-more-cta": {
    "title": "Texto Saiba Mais - Vitrine",
    "props": {
      "textAlignment": "CENTER",
      "textPosition": "CENTER",
      "text": "Clique e saiba mais",
      "blockClass": "quick-view"
    }
  },
  
  "flex-layout.col#shelf-product-available": {
    "title": "Produto Vitrine - Disponível",
    "children": [
      "container#shelf-price_parcelado",
      //Ficara inativo no codigo pois quebra layout no Refresh:
      // "container#shelf-price_pix",
      "hover-container#actions"
    ],
    "props": {
      "blockClass": "shelf-product-available"
    }
  },

  "container#product-sku-variation": {
    "title": "Texto de variação Produto",
    "children": [
      "container#shelf-sku-selector",
      "rich-text#see-all-variations"
    ],
    "props": {
      "blockClass": "product-sku-variation"
    }
  },
  "rich-text#see-all-variations": {
    "props": {
      "blockClass": "product-variation",
      "text": "**Entre e veja todos**"
    }
  },
  
  // Parcelamento
  "product-installments#shelf-installments": {
    "props": {
      "markers": ["bold"],
      "message": "Ou <bold>{installmentsTotalValue}</bold> em até <bold>{installmentsNumber}x</bold> de <bold>{installmentValue}</bold> sem juros no cartão de crédito",
      "installmentsCriteria": "max-quantity-without-interest",
      "blockClass": "shelf-installments"
    }
  },

  "hover-container#actions": {
    "title": "Ações Prateleira",
    "children": [
      "flex-layout.col#shelf-product-without-variation"
    ],
    "props": {
      "blockClass": "actions"
    }
  },

  // Old Price Block - Shelf - Sendo usada? Nao sei, mas vou manter por aqui a principio START
  // START
  "container#shelf-product-listPrice": {
    "title": "Preço (com preço de lista) produto vitrine",
    "children": [
      "product-list-price#shelf",
      "discount-price#shelf-default",
      "product-selling-price#shelf"
    ],
    "props": {
      "blockClass": "shelf-product-listPrice"
    }
  },

  "discount-price#shelf-default": {
    "props": {
      "hideWithoutDiscount": true,
      "message": "{priceValue} à vista no PIX",
      "blockClass": "shelf-default",
      "promotionName": "Desconto Pagamento a Vista (10%)"
    }
  },

  "product-list-price#shelf": {
    "title": "Preço de lista produto vitrine",
    "props": {
      "message": "{listPriceValue}",
      "blockClass": "product-shelf-price"
    }
  },

  "product-selling-price#shelf": {
    "title": "Preço (com preço de lista) produto vitrine",
    "props": {
      "message": "<bold>{sellingPriceValue}</bold>",
      "markers": ["bold"],
      "blockClass": "product-shelf-price"
    }
  },
  // Old Price Block - Shelf - Sendo usada? Nao sei, mas vou manter por aqui a principio
  // END

  "flex-layout.col#shelf-product-unavailable": {
    "title": "Produto Vitrine - Indisponível",
    "children": [
      "rich-text#shelf-product-unavailable",
      "rich-text#shelf-product-unavailable-cta"
    ],
    "props": {
      "preventVerticalStretch": true,
      "verticalAlign": "top",
      "blockClass": "shelf-product-unavailable"
    }
  },
  "rich-text#shelf-product-unavailable": {
    "title": "Texto Produto Indisponível - Vitrine",
    "props": {
      "text": "__Esgotado__",
      "blockClass": ["shelf-product-info-text", "shelf-product-unavailable"]
    }
  },
  "rich-text#shelf-product-unavailable-cta": {
    "title": "CTA Produto Indisponível - Vitrine",
    "props": {
      "text": "__Consulte Disponibilidade__",
      "blockClass": "shelf-product-unavailable-cta"
    }
  },
  
  "hover-container#shelf-product-unavailable-button": {
    "title": "Hover botão avise-me prateleira",
    "children": ["container#shelf-product-unavailable-button"],
    "props": {
      "blockClass": "shelf-product-unavailable-button",
      "hoverItem": false
    }
  },

  "container#shelf-product-unavailable-button": {
    "children": [
      "rich-text#shelf-product-unavailable-button",
      "responsive-layout.desktop#quick-view"
    ],
    "props": {
      "blockClass": "shelf-product-unavailable-button"
    }
  },

  "rich-text#shelf-product-unavailable-button": {
    "title": "Botão produto indisponível vitrine",
    "props": {
      "text": "__Avise-me quando chegar__",
      "blockClass": "shelf-product-unavailable-button"
    }
  },

  "flex-layout.col#shelf-product-without-variation": {
    "title": "Produto vitrine sem variação de sku",
    "children": [
      "hover-container#shelf-product-buy-quantity"
    ],
    "props": {
      "blockClass": "shelf-product-without-variation"
    }
  },

  "container#shelf-sku-selector": {
    "title": "Seletor de sku produto vitrine",
    "children": [
      "condition-layout.user#shelf-sku-selector"
    ],
    "props": {
      "blockClass": "shelf-sku-selector"
    }
  },

  "condition-layout.user#shelf-sku-selector": {
    "props": {
      "conditions": [
        {
          "subject": "isAuthenticated",
          "arguments": {
            "value": true
          }
        }
      ],
      "Then": "product-summary-sku-selector"
    }
  },

  "product-summary-sku-selector": {
    "props": {
      "visibleVariations": ["tamanho"],
      "initialSelection": "empty"
    }
  },

  "hover-container#shelf-product-buy-quantity": {
    "title": "Hover botão comprar/quantidade prateleira",
    "children": [
      "flex-layout.row#shelf-product-buy-quantity"
    ],
    "props": {
      "blockClass": "shelf-product-buy-quantity",
      "hoverItem": false
    }
  },

  "responsive-layout.desktop#quick-view": {
    "children": ["modal-trigger#quick-view"]
  },

  "flex-layout.row#shelf-product-buy-quantity": {
    "title": "Seletor de quantidade/botão comprar produto vitrine",
    "children": [
      "flex-layout.col#shelf-buy-button"
    ],
    "props": {
      "blockClass": "shelf-product-buy-quantity",
      "colSizing": "auto",
      "preventHorizontalStretch": true,
      "preserveLayoutOnMobile": true,
      "colGap": 0
    }
  },

  "flex-layout.col#shelf-quantity": {
    "children": ["product-summary-quantity#shelf-quantity"],
    "props": {
      "blockClass": "shelf-quantity",
      "marginRight": 4,
      "paddingRight": 0
    }
  },

  "flex-layout.col#shelf-buy-button": {
    "children": [
      "vtex.add-to-cart-button:add-to-cart-button#shelf-buy"
    ],
    "props": {
      "blockClass": ["shelf-buy-button", "buy-button"],
      "width": "grow"
    }
  },

  "product-summary-quantity#shelf-quantity": {
    "title": "Seletor de quantidade produto vitrine",
    "props": {
      "size": "small",
      "showLabel": false,
      "blockClass": "shelf-quantity",
      "showUnit": false
    }
  },

  // "add-to-cart-button#shelf-buy": {
  "vtex.add-to-cart-button:add-to-cart-button#shelf-buy": {
    "title": "Botão comprar produto vitrine",
    "props": {
      "customPixelEventId": "addToCart",
      
      // Preciso testar todos esses e entender qual o ideal para o Refresh:
      "onClickBehavior": "add-to-cart",
      // "onClickBehavior": "ensure-sku-selection",
      // "onClickBehavior":"go-to-product-page",
      // "onClickBehavior":"add-to-cart-and-trigger-shipping-modal",
      //

      // "text": "Comprar",
      "text": "Comprar Agora",
      "blockClass": "shelf-buy"
    }
  },

  "product-specification-badges#selo": {
    "props": {
      "specificationGroupName": "allSpecifications",
      "specificationsOptions": [
        {
          "specificationName": "selo editavel 1",
          "displayValue": "SPECIFICATION_VALUE"
        },
        {
          "specificationName": "selo editavel 2",
          "displayValue": "SPECIFICATION_VALUE"
        }
      ]
    }
  }
}
