{
  "flex-layout.col#column-spacer": {
    "props": {
      "width": "grow"
    }
  },

  "flex-layout.row#line-spacer": {
    "children": [
      "flex-layout.col#column-spacer"
    ]
  },

  "container#link-whatsapp-float": {
    "title": "Botão WhatsApp - Flutuante",
    "children": [
      "link#whatsapp-float"
    ],
    "props": {
      "blockClass": "whatsapp-float"
    }
  },
  "link#whatsapp-float": {
    "title": "Link WhatsApp",
    "children": [
      "icon#whatsapp"
    ],
    "props": {
      "target": "_blank",
      "href": "https://api.whatsapp.com/send?phone=5511994877664",
      "blockClass": "whatsapp-float"
    }
  },
  "icon#whatsapp": {
    "props": {
      "id": "bnd-whatsapp",
      "size": 51,
      "activeClassName": "vtex-store-components-3-x-whatsappIcon"
    }
  }
}
