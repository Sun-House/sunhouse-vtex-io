        }
    },

    // Linha 5
    "disclosure-ld-layout#faq-disclosure-line-5": {
        "title": "Pergunta 5",
        "children": [
            "disclosure-ld-trigger#faq-disclosure-line-5",
            "disclosure-ld-content#faq-disclosure-line-5"
        ],
        "props": {
            "blockClass": "faq-disclosure-line",
            "initialVisibility": "hidden"
        }
    },
    "disclosure-ld-trigger#faq-disclosure-line-5": {
        "children": [
