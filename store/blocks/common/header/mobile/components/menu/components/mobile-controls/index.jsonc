{
  "container#menu-mobile-controls": {
    "props": {
      "blockClass": "menu-mobile-controls"
    },
    "children": [
      "container#mobile-login",
      "container#menu-mobile-controls--logged"
    ]
  },

  "container#menu-mobile-controls--logged": {
    "props": {
      "blockClass": "menu-mobile-controls--logged"
    },
    "children": [
      // "link#stores-landing",
      // "link#corporate-mobile",
      "link#wizard-mobile",
      "minicart.v2",
      "link#mobile-wishlist"
    ]
  },

  "container#mobile-login": {
    "props": {
      "blockClass": "mobile-login"
    },
    "children": ["conditional-login#mobile-login"]
  },

  "conditional-login#mobile-login": {
    "blocks": [
      "conditional-login.unlogged#mobile-login",
      "conditional-login.logged#mobile-login"
    ]
  },

  "conditional-login.unlogged#mobile-login": {
    "children": ["link#mobile-login"]
  },
  "link#mobile-login": {
    "title": "Link Login",
    "props": {
      "href": "/login",
      "blockClass": "mobile-login"
    },
    "children": ["rich-text#mobile-loggin-unlogged"]
  },
  "rich-text#mobile-loggin-unlogged": {
    "props": {
      "text": "#### Login \n **Entre** ou **Cadastre-se**",
      "blockClass": "mobile-login"
    }
  },
  "conditional-login.logged#mobile-login": {
    "children": ["conditional-login.greeting", "link#mobile-logout"]
  },

  "link#mobile-logout": {
    "title": "Link Sair",
    "props": {
      "blockClass": "mobile-logout",
      "label": "[Sair]",
      "href": "/logout"
    }
  },

  "link#mobile-account": {
    "title": "Link Meus Pedidos",
    "props": {
      "href": "/_secure/account#/orders",
      "label": "Meus Pedidos",
      "blockClass": "menu-mobile-link"
    }
  },
  
  // Link Showroom Virtual
  "link#stores-landing-mobile": {
    "title": "Link Showroom Virtual",
    "props": {
      "href": "/landing/nossas-lojas#showroom-virtual",
      "label": "Showroom Virtual",
      "blockClass": "menu-mobile-stores-landing"
    }
  },

  // Link Vendas Corporativas
  "link#corporate-mobile": {
    "title": "Link Vendas Corporativas",
    "props": {
      "href": "/institucional/vendas-corporativas",
      "label": "Vendas Corporativas",
      "blockClass": ["menu-mobile-stores-landing", "menu-mobile-corporate"]
    }
  },

  // Link Wizard - Coringa para usar facilmente no Site Editor sem precisar rebuildar versão da loja
  "link#wizard-mobile": {
    "title": "Link Coringa",
    "props": {
      "href": "/",
      "label": "Wizard",
      "blockClass": ["menu-mobile-stores-landing", "menu-mobile-wizard"]
    }
  },

  "link#mobile-wishlist": {
    "title": "Link Favoritos",
    "props": {
      "href": "/wishlist",
      "label": "Lista de Favoritos",
      "blockClass": ["menu-mobile-link", "menu-mobile-link--wishlist"]
    },
    "children": ["icon#wishlist"]
  }
}
