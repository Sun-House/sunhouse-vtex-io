{
  "container#header--desktop__main": {
    "title": "Principal",
    "children": [
      "container#header--desktop__controls--left",
      "logo#logo-desktop",
      "container#header--desktop__controls--right"
    ],
    "props": {
      "wrapper": true,
      "blockClass": ["header--desktop__main", "container-center"]
    }
  },

  "container#header--desktop__controls--left": {
    "title": "Controles esquerda",
    "children": [
      "link#stores",
      // "link#showroom", // Link para showroom virtual
      // "link#corporate", // Link para vendas corporativas
      "link#wizard", // Link coringa - tem um ajuste no Css que mostra o icone de acordo com o link atribuido
      "link#instagram"
      // "link#wishlist--left"
    ],
    "props": {
      "wrapper": true,
      "blockClass": [
        "header--desktop__controls",
        "header--desktop__controls--left"
      ]
    }
  },

  "link#stores": {
    "title": "Lojas",
    "children": [
      "icon#stores"
    ],
    "props": {
      "label": "Lojas",
      // "href": "/institucional/nossas-lojas",
      "href": "/landing/nossas-lojas",
      "target": "_blank",
      "blockClass": ["header-links", "header-links--stores"]
    }
  },
  "icon#stores": {
    "props": {
      "id": "hpa-stores",
      "size": 22,
      "activeClassName": "vtex-store-components-3-x-storesIcon"
    }
  },
  
  // Link Showroom
  "link#showroom": {
    "title": "Showroom",
    "props": {
      "label": "Showroom Virtual",
      "href": "/landing/nossas-lojas#showroom-virtual",
      "blockClass": ["header-links", "link-showroom"]
    }
  },

  // Link Corporate
  "link#corporate": {
    "title": "Corporate",
    "props": {
      "label": "Vendas Corporativas",
      "href": "/institucional/vendas-corporativas", // Precisa ser ajustado para a nova rota abaixo comentada
      // "href": "/landing/corporate",
      // "blockClass": ["header-links", "link-showroom", "link-corporate"]
      "blockClass": ["header-links", "link-corporate"]
    }
  },

  // Link Wizard - Coringa para usar facilmente no Site Editor sem precisar rebuildar versão da loja
  "link#wizard": {
    "title": "Link Coringa",
    "props": {
      "label": "Wizard",
      "href": "/", // Aqui sera ajustado de acordo com a necessidade diretamente pelo Site Editor
      "blockClass": ["header-links", "link-wizard"]
    }
  },

  // Link Instagram
  "link#instagram": {
    "title": "Link Instagram",
    "props": {
      "label": "Nosso Instagram",
      "href": "https://www.instagram.com/sunhousemoveis/",
      "blockClass": ["header-links", "link-instagram"]
    }
  },

  "link#wishlist--left": {
    "title": "Link Favoritos",
    "children": [
      "icon#wishlist",
      "icon#wishlist-filled"
    ],
    "props": {
      "label": "Favoritos",
      "href": "/wishlist",
      "blockClass": ["wishlist", "header-links"]
    }
  },
  "icon#wishlist": {
    "props": {
      "id": "inf-heart",
      "size": 21,
      "activeClassName": "vtex-store-components-3-x-heartIcon"
    }
  },
  "icon#wishlist-filled": {
    "props": {
      "id": "inf-heart--filled",
      "size": 21,
      "activeClassName": "vtex-store-components-3-x-heartFilledIcon"
    }
  },

  "container#header--desktop__controls--right": {
    "title": "Controles direita",
    "children": [
      // "link#wishlist--right",
      "conditional-login#desktop",
      "overlay-trigger#search-bar", // Deixar esse botao de busca para o Sticky Header mais intuitivo
      // "minicart.v2"
      "container#minicart-container"
    ],
    "props": {
      "blockClass": [
        "header--desktop__controls",
        "header--desktop__controls--right"
      ]
    }
  },

  "link#wishlist--right": {
    "title": "Link Favoritos",
    "children": [
      "icon#wishlist",
      "icon#wishlist-filled"
    ],
    "props": {
      "href": "/wishlist",
      "blockClass": [
        "wishlist",
        "wishlist--right",
        "header-links",
        "header-links--wishlist--right"
      ]
    }
  },

  "logo#logo-desktop": {
    "title": "Logo",
    "props": {
      "title": "Logo",
      "href": "/",
      // "url": "assets/images/logo-white.svg",
      "url": "https://sunhouse.vtexassets.com/assets/vtex.file-manager-graphql/images/855a109a-b6fb-4f17-a929-f26bab9665e7___aa2a67a186894146b5041b8c57e0bc51.png",
      "width": "62",
      "height": "62",
      "blockClass": ["logo-image--desktop", "logo-white"]
    }
  }
}
