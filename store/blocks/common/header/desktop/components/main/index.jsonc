{
  "container#header--desktop__main": {
    "title": "Principal",
    "children": [
      "container#header--desktop__controls--left",
      "logo#logo-desktop",
      "container#header--desktop__controls--right"
    ],
    "props": {
      "wrapper": true,
      "blockClass": ["header--desktop__main", "container-center"]
    }
  },

  "container#header--desktop__controls--left": {
    "title": "Controles esquerda",
    "children": [
      "link#stores",
      "link#showroom",
      "link#wishlist--left"
      // "conditional-login#desktop"
    ],
    "props": {
      "wrapper": true,
      "blockClass": [
        "header--desktop__controls",
        "header--desktop__controls--left"
      ]
    }
  },

  "link#stores": {
    "title": "Lojas",
    "children": [
      "icon#stores"
    ],
    "props": {
      "label": "Lojas",
      "href": "/institucional/nossas-lojas",
      "target": "_blank",
      "blockClass": ["header-links", "header-links--stores"]
    }
  },
  "icon#stores": {
    "props": {
      "id": "hpa-stores",
      "size": 22,
      "activeClassName": "vtex-store-components-3-x-storesIcon"
    }
  },
  
  // Link Showroom
  "link#showroom": {
    "title": "Showroom",
    "props": {
      "label": "Showroom Virtual",
      "href": "/institucional/showroom",
      "blockClass": ["header-links", "link-showroom"]
    }
  },

  "link#wishlist--left": {
    "title": "Link Favoritos",
    "children": [
      "icon#wishlist",
      "icon#wishlist-filled"
    ],
    "props": {
      "label": "Favoritos",
      "href": "/wishlist",
      "blockClass": ["wishlist", "header-links"]
    }
  },
  "icon#wishlist": {
    "props": {
      "id": "inf-heart",
      "size": 21,
      "activeClassName": "vtex-store-components-3-x-heartIcon"
    }
  },
  "icon#wishlist-filled": {
    "props": {
      "id": "inf-heart--filled",
      "size": 21,
      "activeClassName": "vtex-store-components-3-x-heartFilledIcon"
    }
  },

  "container#header--desktop__controls--right": {
    "title": "Controles direita",
    "children": [
      // "link#wishlist--right",
      "conditional-login#desktop",
      "overlay-trigger#search-bar", // Deixar esse botao de busca para o Sticky Header mais intuitivo
      // "minicart.v2"
      "container#minicart-container"
    ],
    "props": {
      "blockClass": [
        "header--desktop__controls",
        "header--desktop__controls--right"
      ]
    }
  },

  "link#wishlist--right": {
    "title": "Link Favoritos",
    "children": [
      "icon#wishlist",
      "icon#wishlist-filled"
    ],
    "props": {
      "href": "/wishlist",
      "blockClass": [
        "wishlist",
        "wishlist--right",
        "header-links",
        "header-links--wishlist--right"
      ]
    }
  },

  "logo#logo-desktop": {
    "title": "Logo",
    "props": {
      "title": "Logo",
      "href": "/",
      "url": "assets/images/logo-white.svg",
      "width": "62",
      "height": "62",
      // "width": 62,
      // "height": 62,
      "blockClass": ["logo-image--desktop", "logo-white"]
    }
  }
}
