{
  "container#header--desktop--home": {
    "children": [
      "fixed-layout#desktop-header--home"
    ],
    "props": {
      "blockClass": ["header", "header--desktop", "header--desktop--home"]
    }
  },

  "fixed-layout#desktop-header--home": {
    "children": [
      "container#header--desktop__content"
    ],
    "props": {
      "threshold": 50, // (Valor em px) Esse é o cara que cria o bug que quando scrolla para o topo rapido, o header continua no modo fixo - quanto menor o valor, mais provevel de bugar
      // Esse nao esta funcionando, conforme nao existe nada referenciando ele no app da Eplus do fixed-layout
      // "thresholdByRouteId": {
      //   "store.home": 50
      // },
      //
      "blockClass": ["sticky-header", "sticky-header--home"]
    }
  },

  "fixed-layout#desktop-header": {
    "children": [
      "container#header--desktop__content"
    ],
    "props": {
      "threshold": 100, // (Valor em px) Esse é o cara que cria o bug que quando scrolla para o topo rapido, o header continua no modo fixo - quanto menor o valor, mais provevel de bugar
      // Esse nao esta funcionando, conforme nao existe nada referenciando ele no app da Eplus do fixed-layout
      // "thresholdByRouteId": { 
      //   "store.home": 500
      // },
      //
      "blockClass": "sticky-header"
    }
  },

  "container#header--desktop__content": {
    "title": "Cabeçalho Desktop",
    "children": [
      // Em teste de posicionamento e comportamento
      "container#youtube-shorts",
      //
      "container#header__top-bar",
      "container#header__top-bar-cron",
      "container#header--desktop__main",
      "container#header--desktop__menu"
    ],
    "props": {
      "blockClass": "header--desktop__content"
    }
  }
}
