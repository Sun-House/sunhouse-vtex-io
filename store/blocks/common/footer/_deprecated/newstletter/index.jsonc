{
  "container#newsletter": {
    "title": "Newsletter",
    "props": {
      "blockClass": "newsletter",
      "wrapper": true
    },
    "children": ["sunhouse.form:form#newsletter"]
  },

  "sunhouse.form:form#newsletter": {
    "props": {
      "blockClass": "newsletter",
      "entity": "NL",
      "resetAfterSuccess": true,
      "Success": "container#success-newsletter"
    },
    "children": ["rich-text#newsletter", "container#newsletter-content"]
  },

  "rich-text#newsletter": {
    "title": "Newsletter Texto",
    "props": {
      "text": "#### Assine nossa newsletter \n\n Fique por dentro das nossas novidades e promoções",
      "blockClass": "newsletter"
    }
  }
}
