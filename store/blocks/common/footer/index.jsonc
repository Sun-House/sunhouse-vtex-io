{
  "footer": {
    "blocks": ["footer-layout.desktop", "footer-layout.mobile"]
  },
  
  "footer#without-seo-info": {
    "blocks": ["footer-layout.desktop#without-seo-info", "footer-layout.mobile#without-seo-info"]
  },
  
  "footer-layout.desktop": {
    "title": "Footer Desktop",
    "children": [
      "container#newsletter-rdstation",
      "flex-layout.row#footer-logo",
      "flex-layout.row#footer-content",
      "flex-layout.row#footer-social",
      "flex-layout.row#footer-bottom"
    ],
    "props": {
      "blockClass": ["global-footer", "footer-wrapper-desktop"]
    }
  },
  "footer-layout.mobile": {
    "title": "Footer Mobile",
    "children": [
      "flex-layout.row#footer-content-mobile",
      // "container#social-medias-mobile",
      "flex-layout.row#footer-social",
      // "flex-layout.row#footer-payments-title",
      // "flex-layout.row#footer-payments-content",
      "flex-layout.row#footer-security-title",
      "flex-layout.row#footer-security-content",
      // "container#footer-selo-mobile",
      "flex-layout.row#footer-bottom"
    ],
    "props": {
      "blockClass": ["global-footer", "footer-wrapper-mobile"]
    }
  },
  "footer-layout.desktop#without-seo-info": {
    "children": [
      // Inserir aqui novo bloco de newsletter
      "flex-layout.row#footer-content",
      "flex-layout.row#footer-bottom"
    ],
    "props": {
      "blockClass": ["global-footer", "footer-wrapper-desktop_wsi"]
    }
  },
  "footer-layout.mobile#without-seo-info": {
    "children": [
      // Inserir aqui novo bloco de newsletter
      "flex-layout.row#footer-content-mobile",
      // "container#social-medias-mobile",
      "flex-layout.row#footer-social",
      // "flex-layout.row#footer-payments-title",
      // "flex-layout.row#footer-payments-content",
      "flex-layout.row#footer-security-title",
      "flex-layout.row#footer-security-content",
      // "container#footer-selo-mobile",
      "flex-layout.row#footer-bottom"
    ],
    "props": {
      "blockClass": ["global-footer", "footer-wrapper-mobile_wsi"]
    }
  },
  "container#footer-selo-mobile": {
    "title": "Footer Selos Mobile",
    "children": [
      "link#vtex"
      // "link#eplus",
      // "certificate-ratrustvox" - Removido da Loja
    ],
    "props": {
      "blockClass": ["footer-selos-mobile"]
    }
  },
  "container#social-medias-mobile": {
    "title": "Social Media Mobile",
    "children": [
      "container#social-medias-mobile-text",
      // Excluir assim que finalizar o novo bloco
      // "list-context.image-list#social"
      //
      "image-text-list#social"
    ],
    "props": {
      "blockClass": "footer-social-medias-mobile"
    }
  },
  "container#social-medias-mobile-text": {
    "children": [
      "rich-text#social-medias-mobile-text"
    ],
    "props": {
      "blockClass": "title-social-medias"
    }
  },
  "rich-text#social-medias-mobile-text": {
    "title": "Social Media Texto",
    "props": {
      "text": "#### Redes Sociais",
      "blockClass": ["footer", "footer-title", "footer-right-title"]
    }
  },
  "container#social-medias-mobile-icons-container": {
    "children": [
      "link#facebook",
      "link#instagram",
      "link#pinterest",
      "link#blog"
    ],
    "props": {
      "blockClass": "footer-link-social-medias-icons"
    }
  },

  "flex-layout.row#footer-content": {
    "title": "Footer Content",
    "children": [
      "flex-layout.col#footer-content-left",
      "flex-layout.col#footer-content-right"
    ],
    "props": {
      "blockClass": "footer-content",
      "preventHorizontalStretch": true
    }
  },

  "flex-layout.col#footer-content-left": {
    "title": "Footer Content Esquerda",
    "children": [
      // "flex-layout.row#footer-logo",
      "flex-layout.row#footer-schedules",
      // "flex-layout.row#footer-social"
      "flex-layout.row#footer-phone",
      "flex-layout.row#footer-email",
      "flex-layout.row#footer-address"
    ],
    "props": {
      "blockClass": "footer-content-left",
      "preventVerticalStretch": true
    }
  },
  "flex-layout.row#footer-logo": {
    "children": [
      "image#logo-desktop-footer"
    ],
    "props": {
      "blockClass": "footer-logo"
    }
  },
  "flex-layout.row#footer-schedules": {
    "children": [
      "rich-text#footer-schedules-content"
    ],
    "props": {
      "blockClass": "footer-schedules"
    }
  },

  //
  "flex-layout.row#footer-phone": {
    "children": [
      "rich-text#footer-phone"
    ],
    "props": {
      "blockClass": "footer-phone"
    }
  },
  "flex-layout.row#footer-email": {
    "children": [
      "rich-text#footer-email"
    ],
    "props": {
      "blockClass": "footer-email"
    }
  },
  "flex-layout.row#footer-address": {
    "children": [
      "rich-text#footer-address"
    ],
    "props": {
      "blockClass": "footer-address"
    }
  },
  //

  "flex-layout.row#footer-social": {
    "children": [
      // "flex-layout.col#footer-social"
      "rich-text#footer-social",
      // Excluir assim que finalizar o novo bloco
      // "list-context.image-list#social"
      //
      "image-text-list#social"
    ],
    "props": {
      "blockClass": "footer-social"
    }
  },
  // "flex-layout.col#footer-social": {
  //   "children": [
  //     "rich-text#footer-social",
  //     "list-context.image-list#social"
  //   ],
  //   "props": {
  //     "blockClass": "footer-social"
  //   }
  // },
  "flex-layout.col#footer-content-right": {
    "title": "Footer Content Direita",
    "children": [
      // "flex-layout.row#footer-content-about", - Movido permanentemente para home.jsonc - a principio precisa repensar nesse bloco da home
      "flex-layout.row#footer-content-lists"
    ],
    "props": {
      "blockClass": "footer-content-right",
      "preventVerticalStretch": true
    }
  },

  //
  "container#pre-footer-about": {
    "children": [
      // "responsive-layout.desktop#pre-footer-about",
      // "responsive-layout.mobile#pre-footer-about"
      "flex-layout.row#footer-content-about",
      "container#home-faq"
    ],
    "props": {
      "blockClass": "footer-content-about"
    }
  },

  // A principio nao vou usar sistema responsivo para esses blocos
  "responsive-layout.desktop#pre-footer-about": {
    "children": [
      // "container#footer-about-text"
      "flex-layout.row#footer-content-about",
      "container#home-faq"
    ],
    "props": {
      "blockClass": "render-block_pre-footer-about"
    }
  },
  "responsive-layout.mobile#pre-footer-about": {
    "children": [
      "disclosure-content#footer-about"

      // USAR ESSE (QUE AINDA PRECISA SER CRIADO):
      // "container#wrapper_footer-about-mobile"
      ,"container#home-faq"
    ],
    "props": {
      "blockClass": "render-block_pre-footer-about_mobile"
    }
  },
  //

  "flex-layout.row#footer-content-about": {
    "children": [
      "container#footer-about-text"
    ],
    "props": {
      "blockClass": "footer-content-about"
    }
  },
  "container#footer-about-text": {
    "title": "Texto Sobre Nós - Apenas Home",
    "children": [
      "rich-text#footer-about-text"
    ],
    "props": {
      "blockClass": "container-footer-about-text"
    }
  },
  "rich-text#footer-about-text": {
    "title": "Texto Sobre-Nos",
    "props": {
      "text": "### Sobre a Sun House \n\n A Sun House é uma loja de móveis online e física que oferece aos nossos clientes os melhores móveis e itens de decoração para quartos, salas, cozinhas, banheiros e muito mais.\n\nAqui você encontra uma variedade enorme de produtos, como também o sofá perfeito para sua sala, a cama mais confortável e as mesas de cabeceiras mais duradouras para complementar o seu quarto.\n\nSe você está precisando de uma cadeira nova, com certeza encontrará os mais diversos estilos e designs, ou se estiver em busca de uma mesa de trabalho para seu ambiente corporativo, terá o melhor aproveitamento em nossas seções do site.\n\nIncrível, não é mesmo? Além de oferecermos os melhores móveis e artigos para decoração, aqui na loja online você tem a oportunidade de comprar durante todo o ano com ofertas incríveis! Tudo isso para te oferecer o melhor custo-benefício e decorar a sua casa com muita facilidade, sem abrir mão da qualidade.",
      "blockClass": ["footer", "footer-about-text"]
    }
  },

  // FAQ - Perguntas Frequentes Home
  "container#home-faq": {
      "title": "FAQ - Perguntas Frequentes Home",
      "children": [
          "flex-layout.row#footer-faq-disclosure__title-row",
          "container#custom-block__faq-disclosure"
      ],
      "props": {
          "blockClass": ["custom-block__container", "custom-block__wrapper-faq-disclosure", "home-faq"]
      }
  },

  // FAQ - Perguntas Frequentes Categorias
  "container#category-faq": {
      "title": "FAQ - Perguntas Frequentes Categorias",
      "children": [
          "flex-layout.row#footer-faq-disclosure__title-row",
          "container#custom-block__faq-disclosure"
      ],
      "props": {
          "blockClass": ["custom-block__container", "custom-block__wrapper-faq-disclosure", "category-faq"]
      }
  },

  "flex-layout.row#footer-faq-disclosure__title-row": {
    "children": [
      "rich-text#footer-faq-disclosure__title-row"
    ],
    "props": {
      "blockClass": ["feature-card__title", "feature-card__title", "footer-faq-title_row"]
    }
  },
  "rich-text#footer-faq-disclosure__title-row": {
    "title": "Titulo FAQ",
    "props": {
      "text": "## Perguntas Frequentes",
      "textAlignment": "CENTER",
      "textPosition": "CENTER",
      "blockClass": "footer-faq-title"
    }
  },

  "flex-layout.row#footer-bottom": {
    "title": "Footer Linhas",
    "children": [
      "flex-layout.col#footer-bottom-left",
      "flex-layout.col#footer-bottom-right"
    ],
    "props": {
      "blockClass": "footer-bottom"
    }
  },
  "flex-layout.col#footer-bottom-left": {
    "children": [
      "rich-text#footer-bottom-text"
    ],
    "props": {
      "blockClass": "footer-bottom-left"
    }
  },
  "flex-layout.col#footer-bottom-right": {
    "children": [
      "flex-layout.row#footer-payments-content"
    ],
    "props": {
      "blockClass": "footer-bottom-right"
    }
  },

  // O bloco em si foi descontinuado, reutilizado apenas a linha das bandeiras de pagamento
  "flex-layout.col#footer-payments": {
    "title": "Pagamentos",
    "children": [
      "rich-text#footer-payments",
      "flex-layout.row#footer-payments-content"
    ],
    "props": {
      // "preventVerticalStretch": true,
      // "width": "grow",
      "blockClass": "footer-payments"
    }
  },
  "rich-text#footer-payments": {
    "title": "Titulo Pagamentos",
    "props": {
      "text": "#### Pagamentos",
      "blockClass": ["footer", "footer-payments", "footer-title", "footer-right-title"]
    }
  },
  "flex-layout.row#footer-payments-content": {
    "title": "Icones Pagamentos",
    "children": [
      "image#mastercard",
      "image#visa",
      "image#elo",
      "image#diners",
      "image#amex",
      // "image#paypal",
      "image#pix"
      // "image#boleto"
    ],
    "props": {
      // "colSizing": "auto",
      // "preventHorizontalStretch": true,
      // "preventVerticalStretch": true,
      // "preserveLayoutOnMobile": true,
      "blockClass": ["footer-payments-content", "footer-list", "footer-payments-list"]
    }
  },
  
  "rich-text#footer-bottom-text": {
    "props": {
      "text": "© Sun House - Todos os direitos reservados\nConcept Móveis e Decorações Ltda CNPJ 14.234.441/0001-62 IE: 146.455.109.119",
      "blockClass": ["footer", "footer-bottom-text"]
    }
  },
  //


  "icon#arrow-line": {
    "props": {
      "id": "nav-caret--up",
      "size": 18,
      "activeClassName": "vtex-store-components-3-x-arrowLine"
    }
  },

  "icon#arrow-line-rotate": {
    "props": {
      "id": "nav-caret--down",
      "size": 18,
      "activeClassName": "vtex-store-components-3-x-arrowLineRotate"
    }
  },

  "image#logo-desktop-footer": {
    "title": "Logo",
    "props": {
      "alt": "Logo Sun House",
      "title": "Logo Sun House",
      "src": "assets/images/logo-white.svg", // Imagem final definida via Site Editor
      "blockClass": ["logo-footer"],
      "maxWidth": "145px",
      "link": {
        "url": "/"
      }
    }
  }
}
