{
  "container#newsletter-content": {
    "children": ["container#newsletter-content-form", "form.checkbox#checkbox"],
    "props": {
      "blockClass": "newsletter-content"
    }
  },

  "container#newsletter-content-form": {
    "props": {
      "blockClass": "newsletter-content-form"
    },
    "children": [
      "form.input#name",
      "form.input#email",
      "form.submit#newsletter"
    ]
  },

  "form.input#name": {
    "props": {
      "fieldEntity": "name",
      "label": "Nome",
      "placeholder": "Digite seu nome",
      "required": true,
      "type": "text",
      "errorMessage": "Por favor, verifique seu nome. ",
      "blockClass": ["newsletter", "newsletter-name"]
    }
  },
  "form.input#email": {
    "props": {
      "fieldEntity": "email",
      "label": "Email",
      "placeholder": "Digite seu email",
      "required": true,
      "type": "email",
      "errorMessage": "Por favor, verifique o email digitado.",
      "blockClass": ["newsletter", "newsletter-email"]
    }
  },
  "form.submit#newsletter": {
    "props": {
      "label": "Assinar",
      "blockClass": ["newsletter", "newsletter-submit"]
    }
  },
  "form.checkbox#checkbox": {
    "props": {
      "fieldEntity": "allowed",
      "required": true,
      "errorMessage": "A opção precisa estar marcada.",
      "blockClass": ["newsletter"],
      "Text": "rich-text#checkbox"
    }
  },

  "rich-text#checkbox": {
    "props": {
      "text": "Aceito me registrar, eu aceito os [Termos de Uso](/institucional/politica-de-privacidade) da Sun House.",
      "blockClass": ["newsletter-checkbox"]
    }
  },

  "container#success-newsletter": {
    "props": {
      "blockClass": ["success-newsletter"]
    },
    "children": ["rich-text#success-newsletter", "form.submit#newsletter-back"]
  },

  "rich-text#success-newsletter": {
    "title": "Newsletter Texto Sucesso",
    "props": {
      "text": "#### E-mail cadastrado com sucesso! \n\n Em breve você receberá nossos conteúdos exclusivos por e-mail. Aproveite!",
      "blockClass": ["success-newsletter"]
    }
  },

  "form.submit#newsletter-back": {
    "props": {
      "label": "Voltar",
      "blockClass": ["newsletter", "newsletter-back"],
      "backSuccess": true
    }
  }
}
