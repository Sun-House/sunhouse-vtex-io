{
    "image-text-list#social": {
        "title": "Links - Redes Sociais",
        "children": [
            "container.list-render#social"
        ],
        "props": {
            "imageLoading": "lazy",
            "imageWidth": 20,
            "imageHeight": 20,
            "imageTextArray": [
                {
                    // Facebook
                    "image": "assets/images/footer/facebook-f-icon.png",
                    "link": "https://www.facebook.com/Sunhousemoveis/",
                    "target": true
                },
                {
                    // Instagram
                    "image": "assets/images/footer/instagram-f-icon.png",
                    "link": "https://www.instagram.com/sunhousemoveis/",
                    "target": true
                },
                {
                    // Pinterest
                    "image": "assets/images/footer/pinterest-f-icon_2.png",
                    "link": "https://br.pinterest.com/sunhousemoveis/",
                    "target": true
                },
                {
                    // WhatsApp
                    "image": "assets/images/footer/whatsapp-f-icon.png",
                    "link": "https://wa.me/5511994877664",
                    "target": true
                },
                {
                    // Blog
                    "image": "assets/images/footer/blog-f-icon.png",
                    "link": "https://blog.sunhouse.com.br/",
                    "target": true
                }
            ],
            "blockClass": "footer-social-content"
        }
    }

