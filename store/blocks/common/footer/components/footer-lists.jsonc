{
  "flex-layout.row#footer-content-lists": {
    "title": "Footer Menu",
    "children": [
      "flex-layout.col#footer-for-you",
      "flex-layout.col#footer-institutional",
      "flex-layout.col#footer-informations",
      // "flex-layout.col#footer-payments", - O bloco em si foi descontinuado, reutilizado apenas a linha das bandeiras de pagamento
      "flex-layout.col#footer-security"
    ],
    "props": {
      "blockClass": "footer-content-lists",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true
    }
  },
  "flex-layout.col#footer-for-you": {
    "title": "Para Você",
    "children": [
      "rich-text#footer-for-you",
      "rich-text#footer-for-you-content"
    ],
    "props": {
      "blockClass": "footer-for-you",
      "preventVerticalStretch": true,
      "width": "grow"
    }
  },
  "flex-layout.col#footer-institutional": {
    "title": "Institucional",
    "children": [
      "rich-text#footer-institutional",
      "rich-text#footer-institutional-content"
    ],
    "props": {
      "blockClass": "footer-institutional",
      "preventVerticalStretch": true,
      "width": "grow"
    }
  },
  "flex-layout.col#footer-informations": {
    "title": "Informações",
    "children": [
      "rich-text#footer-informations",
      "rich-text#footer-informations-content"
    ],
    "props": {
      "blockClass": "footer-informations",
      "preventVerticalStretch": true,
      "width": "grow"
    }
  },

  "flex-layout.col#footer-security": {
    // "title": "Segurança",
    "title": "Certificações",
    "children": [
      "rich-text#footer-security",
      "flex-layout.row#footer-security-content"
    ],
    "props": {
      "blockClass": "footer-security",
      "preventVerticalStretch": true,
      "width": "grow"
    }
  },
  "rich-text#footer-for-you": {
    "title": "Titulo Para Você",
    "props": {
      "text": "#### Para você",
      "blockClass": ["footer", "footer-for-you", "footer-title", "footer-right-title"]
    }
  },
  "rich-text#footer-for-you-content": {
    "title": "Texto Para Você",
    "props": {
      "text": "- [Minha conta](/account#/profile)\n- [Pedidos](/account#/orders)\n- [Minha sacola](/checkout#/cart)",
      "blockClass": ["footer", "footer-for-you-content", "footer-list"]
    }
  },
  "rich-text#footer-institutional": {
    "title": "Titulo Sobre Nós",
    "props": {
      "text": "#### Sobre Nós",
      "blockClass": ["footer", "footer-institutional", "footer-title", "footer-right-title"]
    }
  },
  "rich-text#footer-institutional-content": {
    "title": "Texto Sobre Nós",
    "props": {
      "text": "- [Quem somos](/institucional/sobre-nos)\n- [Nossas Lojas](/institucional/nossas-lojas)\n- [Fale conosco](/institucional/fale-conosco)\n- [Politica de Privacidade](/institucional/politica-de-privacidade)\n- [Preciso de Ajuda](/institucional/ajuda)",
      "blockClass": ["footer", "footer-institutional-content", "footer-list"]
    }
  },
  "rich-text#footer-informations": {
    "title": "Titulo Informações",
    "props": {
      "text": "#### Informações",
      "blockClass": ["footer", "footer-informations", "footer-title", "footer-right-title"]
    }
  },
  "rich-text#footer-informations-content": {
    "title": "Texto Informações",
    "props": {
      // politica de privacidade; duvidas frequentes; trocas e devolucoes; prazos de envio; formas de pagamento
      "text": "- <a href='https://blog.sunhouse.com.br/' target='_blank'>Nosso blog</a>\n- [Montagens](/institucional/montagens)\n- [Vendas Corporativas](/institucional/vendas-corporativas)\n- [Perguntas Frequentes](/institucional/perguntas-frequentes)\n- <a href='https://design.sunhouse.com.br/' target='_blank'>Parcerias para Arquitetos</a>",
      "blockClass": ["footer", "footer-informations-content", "footer-list"]
    }
  },
  
  "rich-text#footer-security": {
    "title": "Titulo Certificações",
    "props": {
      "text": "#### Certificações",
      "blockClass": ["footer", "footer-security", "footer-title", "footer-right-title"]
    }
  },

  "rich-text#footer-social": {
    "title": "Texto - Siga Nossas Redes",
    "props": {
      "text": "Siga nossas redes",
      "blockClass": ["footer", "footer-social"]
    }
  },
  "list-context.image-list#social": {
    "title": "Icones Redes Sociais",
    "props": {
      "images": [
        { // Facebook
          "image": "assets/images/footer/facebook-f-icon.png",
          "loading": "lazy",
          "fetchpriority": "low",
          "description": "Facebook",
          "title": "Facebook",
          "width": "50px",
          "link": {
            "title": "Facebook",
            "url": "https://www.facebook.com/Sunhousemoveis/",
            "openNewTab": true
          }
        },
        { // Instagram
          "image": "assets/images/footer/instagram-f-icon.png",
          "loading": "lazy",
          "fetchpriority": "low",
          "description": "Instagram",
          "title": "Instagram",
          "width": "50px",
          "link": {
            "title": "Instagram",
            "url": "https://www.instagram.com/sunhousemoveis/",
            "openNewTab": true
          }
        },
        { // Pinterest - Na versao do Edson, é X (formerly Twitter)
          "image": "assets/images/footer/pinterest-f-icon_2.png",
          "loading": "lazy",
          "fetchpriority": "low",
          "description": "Pinterest",
          "title": "Pinterest",
          "width": "50px",
          "link": {
            "title": "Pinterest",
            "url": "https://br.pinterest.com/sunhousemoveis/",
            "openNewTab": true
          }
        },
        { // WhatsApp
          "image": "assets/images/footer/whatsapp-f-icon.png",
          "loading": "lazy",
          "fetchpriority": "low",
          "description": "WhatsApp",
          "title": "WhatsApp",
          "width": "50px",
          "link": {
            "title": "WhatsApp",
            "url": "https://wa.me/5511994877664",
            "openNewTab": true
          }
        },
        { // Blog
          "image": "assets/images/footer/blog-f-icon.png",
          "loading": "lazy",
          "fetchpriority": "low",
          "description": "Blog",
          "title": "Blog",
          "width": "50px",
          "link": {
            "title": "Blog",
            "url": "https://blog.sunhouse.com.br/",
            "openNewTab": true
          }
        }
      ],
      "height": "50px"
    },
    "children": ["container.list-render#social"]
  },
  "container.list-render#social": {
    "props": {
      "blockClass": "footer-social-content"
    }
  },

  "flex-layout.row#footer-social-content": {
    "title": "Redes Social",
    "children": [
      "list-context.image-list#social"
    ],
    "props": {
      // "preventHorizontalStretch": true,
      // "preventVerticalStretch": true,
      // "preserveLayoutOnMobile": true,
      // "colJustify": "between",
      "blockClass": "footer-social-content"
    }
  },
  "rich-text#footer-schedules": {
    "title": "Titulo Horario de Atendimento",
    "props": {
      "text": "#### Horário de Atendimento",
      "blockClass": ["footer", "footer-schedules", "footer-title"]
    }
  },
  "rich-text#footer-schedules-content": {
    "title": "Texto Horario de Atendimento",
    "props": {
      // "text": "\nLoja Online\nDas 08h30 às 17h30 \n\nLojas Físicas\nSegunda a Sábado das 09h às 20h\nDomingos e Feriados* das 10h30 às 19h\n\n*Exceto dia 01/01 e 25/12\n\nDúvidas? Entre em contato:\n(11) 2641-0594 ou (11) 9 9487-7664\natendimento@sunhouse.com.br",
      "text": "Loja Online\nDas 08h30 às 17h30\n\nLojas Físicas\nSegunda a Sábado\nDas 09h às 20h\nDomingos e Feriados*\nDas 10h30 às 19h\n\n*Exceto dias 01/01 e 25/12",
      // "textAlignment": "CENTER",
      "textAlignment": "LEFT",
      "blockClass": ["footer", "footer-schedules-content"]
    }
  },

  //
  "rich-text#footer-phone": {
    "title": "Numero de Telefone",
    "props": {
      "text": "(11) 2641-0594",
      "textAlignment": "LEFT",
      "blockClass": ["footer", "footer-phone"]
    }
  },
  "rich-text#footer-email": {
    "title": "Email",
    "props": {
      "text": "[atendimento@sunhouse.com.br](mailto:atendimento@sunhouse.com.br)",
      "textAlignment": "LEFT",
      "blockClass": ["footer", "footer-email"]
    }
  },
  "rich-text#footer-address": {
    "title": "Endereço",
    "props": {
      "text": "Rua Teodoro Sampaio, 1.749\nPinheiros - SP, CEP 05405-150",
      "textAlignment": "LEFT",
      "blockClass": ["footer", "footer-address"]
    }
  },
  //

  "flex-layout.row#footer-security-content": {
    "children": [
      // "link#letsencrypt",
      "image#pci-vtex",
      "container#spacing-default",
      "link#vtex"
    ],
    "props": {
      "blockClass": [
        "footer-security-content",
        "footer-list",
        "footer-security-list"
      ],
      "colSizing": "auto",
      "preserveLayoutOnMobile": true,
      "colGap": 4
    }
  },
  "flex-layout.row#footer-images-bottom": {
    "children": [
      // "link#vtex",
      // "link#eplus",
      "certificate-ratrustvox"
    ],
    "props": {
      "blockClass": "footer-images-bottom",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true,
      "preserveLayoutOnMobile": true
    }
  }
}
